    circulation adds to the baryonic gravity, keeping rotation
    curves flat without any dark matter.
    
    Like a stirring rod creating a vortex in a prism of water —
    the vortex IS the extra force, not invisible mass.
    """
    P = CrystalPrism()
    
    # NGC 6503 data — a typical spiral galaxy
    R = np.array([0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 5.0, 7.0, 10.0])  # kpc
    Vg = np.array([5, 8, 10, 11, 12, 12, 11, 9, 6])               # gas
    Vd = np.array([45, 65, 78, 85, 90, 88, 82, 70, 52])           # disk
    Vb = np.array([15, 22, 25, 24, 18, 10, 5, 1, 0])              # bulge
    
    # Mass-to-light ratios (standard stellar population values)
    ud, ub = 0.48, 0.70
    
    # Step 1: Baryonic velocity from standard gravity
    Vbary = np.sqrt(Vg**2 + (Vd*np.sqrt(ud))**2 + (Vb*np.sqrt(ub))**2)
    
    # Step 2: Baryonic mass from 90th percentile estimator
    Mb = np.percentile(Vbary**2 * R*1000, 90) / P.G_PC
    
    # Step 3: BTFR prediction — V_flat from prism quantum of circulation
    Vf = (P.a0 * P.G * Mb * P.M_sun)**0.25 / 1000
    
    # Step 4: Surface density profile
    Sig = Vbary**2 / (2*np.pi*P.G_PC*R*1000)
    
    # Step 5: Self-consistent prism acceleration at transition radius
    ae = P.a_base
    for _ in range(20):
        rt = np.clip(Vf**2/ae, R[0]*1.01, R[-1]*0.99)
        an = P.a_base * np.sqrt(np.clip(np.interp(rt,R,Sig)/P.S_char, 0.01, 100))
