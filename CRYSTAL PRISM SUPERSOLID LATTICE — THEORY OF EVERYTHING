        ae = 0.7*ae + 0.3*an
    
    # Step 6: Vortex velocity from prism superfluid circulation
    rt = Vf**2/ae
    Vv = Vf * (1 - np.exp(-(R/rt)**P.beta))
    
    # Step 7: Total predicted velocity
    Vp = np.sqrt(Vbary**2 + Vv**2)
    
    print("\n" + "="*60)
    print("PRISM SPECTRUM: GALAXIES (~10^20 m)")
    print("="*60)
    print(f"  NGC 6503 through the crystal prism:")
    print(f"    Baryonic mass:      {Mb:.2e} M_sun")
    print(f"    BTFR prediction:    {Vf:.0f} km/s")
    print(f"    Transition radius:  {rt:.1f} kpc")
    print(f"    Prism acceleration: {ae:.0f} km^2/s^2/kpc")
    print(f"")
    print(f"  Prism parameters (fixed, not fitted per galaxy):")
    print(f"    a_base = {P.a_base}  S_char = {P.S_char}  beta = {P.beta}")
    print(f"")
    print(f"  Rotation curve decomposition:")
    print(f"  {'R':<8} {'Baryons':<10} {'Prism vortex':<14} {'Total':<8}")
    print(f"  {'-'*8} {'-'*10} {'-'*14} {'-'*8}")
