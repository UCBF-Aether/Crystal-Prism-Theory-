class UCBFConstantsV13:
    """Derived from FCC lattice (Chapters 5-6, Appendices I-J)"""
    
    # Fundamental constants from lattice
    G_SI = 6.6720e-11          # m³/kg/s² — from c³/(ΩP)
    a0_SI = 1.0422e-10         # m/s² — from c × H₀ / (2π)
    c = 2.99792458e8           # m/s — transverse sound speed
    
    # Lattice-derived galactic constants (Appendix J)
    a0_base = 3700.0           # km²/s²/kpc — C₄₄/(ρ ξ_coh)
    Sigma_char = 50.0          # M☉/pc² — m₀ N_T/(π ξ_coh²)
    
    # Vortex core physics (Chapter 27)
    vortex_alpha = 1.0         # From lattice geometry (not fitted)
    vortex_beta = 0.5          # Core profile exponent
    
    # Astronomical conversions
    M_sun_kg = 1.989e30        # kg
    G_PC = 4.3009e-3           # (km/s)² * kpc / M☉
    kpc_to_pc = 1000.0
    keV_to_J = 1.60218e-16
    mu = 0.588                 # mean molecular weight for ionized plasma
    mp = 1.6726e-27            # kg, proton mass
    
    # Priors for M/L ratios (from stellar population synthesis)
    prior_disk_mean = 0.5
    prior_disk_sigma = 0.2
    prior_bulge_mean = 0.7
    prior_bulge_sigma = 0.3

C = UCBFConstantsV13()

