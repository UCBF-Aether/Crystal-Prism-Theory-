def load_clusters_v13():
    """Load and compute cluster predictions."""
    clusters = []
    
    for name, T_keV, M500, Mgas, fstar in VIKHILININ_CLUSTERS:
        M_bar = (Mgas + fstar * M500) * 1e14
        T_J = T_keV * C.keV_to_J
        sigma_obs = np.sqrt(T_J / (C.mu * C.mp)) / 1000.0
        M_bar_kg = M_bar * C.M_sun_kg
        sigma_pred = (C.a0_SI * C.G_SI * M_bar_kg) ** 0.25 / 1000.0
        clusters.append({
            'name': name,
            'source': 'Vikhlinin+2006',
            'T_keV': T_keV,
            'M_bar': M_bar,
            'sigma_obs': sigma_obs,
            'sigma_pred': sigma_pred,
            'resid_pct': abs(sigma_pred - sigma_obs) / sigma_obs * 100,
        })
    
    for name, T_keV, M500, Mgas, fstar in CLASH_CLUSTERS:
        M_bar = (Mgas + fstar * M500) * 1e14
        T_J = T_keV * C.keV_to_J
        sigma_obs = np.sqrt(T_J / (C.mu * C.mp)) / 1000.0
        M_bar_kg = M_bar * C.M_sun_kg
        sigma_pred = (C.a0_SI * C.G_SI * M_bar_kg) ** 0.25 / 1000.0
        clusters.append({
            'name': name,
            'source': 'CLASH',
            'T_keV': T_keV,
            'M_bar': M_bar,
            'sigma_obs': sigma_obs,
            'sigma_pred': sigma_pred,
            'resid_pct': abs(sigma_pred - sigma_obs) / sigma_obs * 100,
        })
    
    return clusters

