            'M31': 4.5,  # M31 scale length
        }
        return r_scales.get(gal_name, 2.0)
    
    @staticmethod
    def apply_cuts(gal):
        """
        Apply all Lelli & McGaugh quality cuts to a galaxy.
        Returns: (passed, reason, quality_metrics)
        """
        name = gal['name']
        R_kpc = gal['R_kpc']
        V_obs = gal['V_obs']
        V_err = gal['V_err']
        
        # Get galaxy properties
        inclination = LelliMcGaughQualityCuts.get_inclination(name)
        r_scale = LelliMcGaughQualityCuts.get_r_scale(name)
        
        # Cut 1: Number of data points
        n_pts = len(R_kpc)
        if n_pts < LelliMcGaughQualityCuts.MIN_POINTS:
            return False, f"Only {n_pts} points (< {LelliMcGaughQualityCuts.MIN_POINTS})", {
                'inclination': inclination,
                'r_scale': r_scale,
                'n_pts': n_pts,
                'r_max': R_kpc.max(),
                'max_err_ratio': np.max(V_err / V_obs)
            }
        
        # Cut 2: Inclination
        if inclination < LelliMcGaughQualityCuts.MIN_INCLINATION:
            return False, f"Inclination {inclination:.1f}° < {LelliMcGaughQualityCuts.MIN_INCLINATION}°", {
                'inclination': inclination,
                'r_scale': r_scale,
                'n_pts': n_pts,
                'r_max': R_kpc.max(),
                'max_err_ratio': np.max(V_err / V_obs)
            }
        if inclination > LelliMcGaughQualityCuts.MAX_INCLINATION:
            return False, f"Inclination {inclination:.1f}° > {LelliMcGaughQualityCuts.MAX_INCLINATION}°", {
                'inclination': inclination,
                'r_scale': r_scale,
                'n_pts': n_pts,
                'r_max': R_kpc.max(),
                'max_err_ratio': np.max(V_err / V_obs)
            }
        
        # Cut 3: Outer disk resolved (R_max > 2 × R_scale)
        r_max = R_kpc.max()
        if r_max / r_scale < LelliMcGaughQualityCuts.MIN_RMAX_RSCALE:
            return False, f"R_max/R_scale={r_max/r_scale:.1f} < {LelliMcGaughQualityCuts.MIN_RMAX_RSCALE}", {
                'inclination': inclination,
                'r_scale': r_scale,
                'n_pts': n_pts,
                'r_max': r_max,
                'max_err_ratio': np.max(V_err / V_obs)
            }
        
        # Cut 4: Error quality
        max_err_ratio = np.max(V_err / V_obs)
        if max_err_ratio > LelliMcGaughQualityCuts.MAX_ERR_RATIO:
            return False, f"Max V_err/V={max_err_ratio:.2f} > {LelliMcGaughQualityCuts.MAX_ERR_RATIO}", {
                'inclination': inclination,
                'r_scale': r_scale,
                'n_pts': n_pts,
                'r_max': r_max,
                'max_err_ratio': max_err_ratio
            }
        
        # Passed all cuts
        return True, "Passed all Lelli & McGaugh quality cuts", {
            'inclination': inclination,
            'r_scale': r_scale,
            'n_pts': n_pts,
            'r_max': r_max,
            'max_err_ratio': max_err_ratio
        }

