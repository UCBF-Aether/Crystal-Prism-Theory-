def plot_quality_comparison(results, save=True):
    """Plot comparison of high-quality vs standard galaxies."""
    fig, axes = plt.subplots(1, 3, figsize=(15, 5))
    
    # Plot 1: Residual distribution by quality
    ax1 = axes[0]
    high_res = [r['mean_abs_pct'] for r in results.values() 
                if r['success'] and r['quality'] == 'high']
    std_res = [r['mean_abs_pct'] for r in results.values() 
               if r['success'] and r['quality'] == 'standard']
    
    ax1.hist(high_res, bins=20, alpha=0.7, label=f'High Quality (N={len(high_res)})', 
            color='green', edgecolor='black')
    ax1.hist(std_res, bins=20, alpha=0.5, label=f'Standard (N={len(std_res)})', 
            color='red', edgecolor='black')
    ax1.axvline(np.mean(high_res) if high_res else 0, color='darkgreen', 
               linestyle='--', linewidth=2, label=f'Mean: {np.mean(high_res):.1f}%')
    ax1.axvline(np.mean(std_res) if std_res else 0, color='darkred', 
               linestyle='--', linewidth=2, label=f'Mean: {np.mean(std_res):.1f}%')
    ax1.set_xlabel('Mean Absolute Residual (%)')
    ax1.set_ylabel('Number of Galaxies')
    ax1.set_title('Residuals: High Quality vs Standard')
    ax1.legend()
    ax1.grid(True, alpha=0.3)
    
    # Plot 2: Box plot comparison
    ax2 = axes[1]
    data_to_plot = []
    labels = []
    if high_res:
        data_to_plot.append(high_res)
        labels.append(f'High Quality\n(N={len(high_res)})')
    if std_res:
        data_to_plot.append(std_res)
        labels.append(f'Standard\n(N={len(std_res)})')
    
    if data_to_plot:
        bp = ax2.boxplot(data_to_plot, labels=labels)
        ax2.set_ylabel('Residual (%)')
        ax2.set_title('Residual Distribution Comparison')
        ax2.grid(True, alpha=0.3)
        # Color the boxes
        colors = ['green', 'red']
        for i, box in enumerate(bp['boxes']):
            box.set(color=colors[i], linewidth=2)
    
    # Plot 3: Residual vs Inclination
    ax3 = axes[2]
    inclinations = [r['inclination'] for r in results.values() if r['success']]
    res_all = [r['mean_abs_pct'] for r in results.values() if r['success']]
    qualities = [r['quality'] for r in results.values() if r['success']]
    
    for i, (inc, res, qual) in enumerate(zip(inclinations, res_all, qualities)):
        color = 'green' if qual == 'high' else 'red'
        marker = 'o' if qual == 'high' else 's'
        ax3.scatter(inc, res, c=color, marker=marker, alpha=0.6, s=50)
    
    ax3.axvline(30, color='gray', linestyle=':', alpha=0.5, label='Inclination limits')
    ax3.axvline(80, color='gray', linestyle=':', alpha=0.5)
    ax3.set_xlabel('Inclination (degrees)')
    ax3.set_ylabel('Residual (%)')
    ax3.set_title('Residual vs Inclination')
    ax3.grid(True, alpha=0.3)
    ax3.legend(['Inclination limits', 'High Quality', 'Standard'])
    
    plt.suptitle('UCBF V13 — Lelli & McGaugh Quality Cut Analysis', 
                fontsize=14, fontweight='bold')
    plt.tight_layout()
    
    if save:
        plt.savefig('UCBF_V13_Quality_Analysis.png', dpi=200, bbox_inches='tight')
        print("✓ Saved: UCBF_V13_Quality_Analysis.png")
    
    plt.show()

def plot_top10_v13(results, save=True):
    """Plot top 10 best-fitting galaxies (high quality only)."""
    high_quality_results = [r for r in results.values() 
                           if r['success'] and r['quality'] == 'high']
    sorted_results = sorted(high_quality_results, key=lambda x: x['mean_abs_pct'])
    top10 = sorted_results[:10]
    
    fig, axes = plt.subplots(2, 5, figsize=(18, 7))
    axes = axes.flatten()
    
    for idx, result in enumerate(top10):
        ax = axes[idx]
        gal = result['gal']
        ps = result['ps']
        
        ax.errorbar(gal['R_kpc'], gal['V_obs'], yerr=gal['V_err'],
                   fmt='o', color='#1f77b4', markersize=4, capsize=2,
                   elinewidth=0.8, alpha=0.8)
        
        R_smooth = np.linspace(0.01, max(gal['R_kpc']) * 1.05, 100)
        V_disk_int = np.interp(R_smooth, gal['R_kpc'], gal['V_disk'])
        V_bul_int = np.interp(R_smooth, gal['R_kpc'], gal['V_bul'])
        V_gas_int = np.interp(R_smooth, gal['R_kpc'], gal['V_gas_raw'])
        
        ps_smooth = vortex_predict_v13(R_smooth, V_disk_int, V_bul_int, V_gas_int,
                                      result['ups_disk'], result['ups_bul'])
        
        ax.plot(R_smooth, ps_smooth['V_pred'], 'r-', linewidth=2)
        ax.plot(R_smooth, ps_smooth['V_bar'], 'g--', linewidth=1.5, alpha=0.7)
        
        ax.set_title(f'{gal["name"]}\nRes: {result["mean_abs_pct"]:.1f}% | '
                    f'V$_f$={ps["V_flat"]:.0f}', fontsize=9)
        ax.set_xlim(0, max(gal['R_kpc']) * 1.05)
        ax.set_ylim(0, max(max(gal['V_obs']), ps_smooth['V_pred'].max()) * 1.1)
        ax.grid(True, alpha=0.25)
        ax.tick_params(labelsize=7)
        
        if idx >= 5:
            ax.set_xlabel('R (kpc)', fontsize=8)
        if idx % 5 == 0:
            ax.set_ylabel('V (km/s)', fontsize=8)
    
    for idx in range(len(top10), len(axes)):
        axes[idx].set_visible(False)
    
    plt.suptitle('UCBF V13 — Top 10 High-Quality Galaxy Rotation Curve Fits\n'
                '(Lelli & McGaugh quality cuts applied)', 
                fontsize=14, fontweight='bold')
    plt.tight_layout()
    
    if save:
        plt.savefig('UCBF_V13_Top10_HighQuality.png', dpi=200, bbox_inches='tight')
        print("✓ Saved: UCBF_V13_Top10_HighQuality.png")
    
    plt.show()

def plot_cluster_btfr(clusters, save=True):
    """Plot cluster BTFR with UCBF prediction."""
    vikh = [c for c in clusters if c['source'] == 'Vikhlinin+2006']
    clash = [c for c in clusters if c['source'] == 'CLASH']
    
    fig, ax = plt.subplots(figsize=(8, 6))
    
    ax.scatter([c['M_bar'] for c in vikh], [c['sigma_obs'] for c in vikh],
               c='red', marker='o', s=80, label='Vikhlinin+2006', alpha=0.8, edgecolors='black')
    ax.scatter([c['M_bar'] for c in clash], [c['sigma_obs'] for c in clash],
               c='blue', marker='s', s=80, label='CLASH', alpha=0.7, edgecolors='black')
    
    M_grid = np.logspace(13, 15.5, 100)
    sigma_grid = (C.a0_SI * C.G_SI * M_grid * C.M_sun_kg) ** 0.25 / 1000.0
    ax.loglog(M_grid, sigma_grid, 'k--', linewidth=2.5, label=r'UCBF: $\sigma^4 = a_0 G M_{\mathrm{bar}}$')
    
    all_M = np.array([c['M_bar'] for c in clusters])
    all_sigma = np.array([c['sigma_obs'] for c in clusters])
    logM = np.log10(all_M)
    logSigma = np.log10(all_sigma)
    slope, intercept, r_value, p_value, std_err = stats.linregress(logM, logSigma)
    
    M_fit = np.logspace(np.min(logM), np.max(logM), 100)
    sigma_fit = 10**intercept * M_fit ** slope
    ax.loglog(M_fit, sigma_fit, 'g-', linewidth=2, label=f'Best fit: β={slope:.3f}')
    
    ax.set_xlabel(r'Baryonic Mass $M_{\mathrm{bar}}$ ($M_\odot$)', fontsize=12)
    ax.set_ylabel(r'Velocity Dispersion $\sigma$ (km/s)', fontsize=12)
    ax.set_title(f'UCBF V13 Cluster BTFR: {len(clusters)} Clusters\n'
                f'β = {slope:.3f} ± {std_err:.3f} (predicted 0.250, {abs(slope-0.25)/std_err:.1f}σ)', 
                fontsize=11)
    ax.legend(loc='upper left', fontsize=9)
    ax.grid(True, alpha=0.3)
    
    plt.tight_layout()
    
    if save:
        plt.savefig('UCBF_V13_Cluster_BTFR.png', dpi=200, bbox_inches='tight')
        print("✓ Saved: UCBF_V13_Cluster_BTFR.png")
    
    plt.show()

