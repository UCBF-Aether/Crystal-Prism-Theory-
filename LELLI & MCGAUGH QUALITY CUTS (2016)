def analyze_residuals_by_quality(results):
    """Analyze residuals separately for high-quality and standard galaxies."""
    high_res = []
    std_res = []
    
    for name, r in results.items():
        if r['success']:
            if r['quality'] == 'high':
                high_res.append(r['mean_abs_pct'])
            else:
                std_res.append(r['mean_abs_pct'])
    
    return {
        'high_mean': np.mean(high_res) if high_res else 0,
        'high_median': np.median(high_res) if high_res else 0,
        'high_std': np.std(high_res) if high_res else 0,
        'high_n': len(high_res),
        'std_mean': np.mean(std_res) if std_res else 0,
        'std_median': np.median(std_res) if std_res else 0,
        'std_std': np.std(std_res) if std_res else 0,
        'std_n': len(std_res),
    }

def analyze_residuals_all(results):
    """Analyze all residuals."""
    res_pct = [r['mean_abs_pct'] for r in results.values() if r['success']]
    
    return {
        'mean_res': np.mean(res_pct),
        'median_res': np.median(res_pct),
        'std_res': np.std(res_pct),
        'n_galaxies': len(res_pct),
    }

