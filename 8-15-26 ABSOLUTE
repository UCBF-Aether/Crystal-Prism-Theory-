def fcc_neighbor_sums(max_range=10, n_neighbors=286):
    distances = []
    for x in range(-max_range, max_range+1):
        for y in range(-max_range, max_range+1):
            for z in range(-max_range, max_range+1):
                if (x + y + z) % 2 == 0 and not (x == 0 and y == 0 and z == 0):
                    distances.append(np.sqrt(x*x + y*y + z*z))
    distances.sort()
    r_n = distances[:n_neighbors]
    return sum(1.0/(r*r) for r in r_n), sum(1.0/(r**4) for r in r_n)

