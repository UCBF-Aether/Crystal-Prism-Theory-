def arctan_series(x, terms=50):
    result = 0.0
    for n in range(terms):
        result += ((-1)**n) * (x**(2*n+1)) / (2*n + 1)
    return result

def sqrt_newton(x, iterations=100):
    if x < 0:
        raise ValueError("negative square root")
    if x == 0:
        return 0.0
    guess = x / 2.0
    if guess == 0:
        guess = 1.0
    for _ in range(iterations):
        guess = 0.5 * (guess + x / guess)
    return guess

def generate_e8_roots():
    roots = []
    for i in range(8):
        for j in range(i+1, 8):
            for s1 in [-1, 1]:
                for s2 in [-1, 1]:
                    v = [0] * 8
                    v[i] = s1
                    v[j] = s2
                    roots.append(tuple(v))
    for signs in itertools.product([-1, 1], repeat=8):
        if sum(1 for x in signs if x == -1) % 2 == 0:
            roots.append(tuple(x/2.0 for x in signs))
    return list(set(roots))

def project_h4(v, phi):
    return np.array([
        v[0] + phi * v[4],
        v[1] + phi * v[5],
        v[2] + phi * v[6]
    ])

def build_P24():
    vertices = [[(i>>2)&1, (i>>1)&1, i&1] for i in range(8)]
    C8 = np.zeros((8, 8), dtype=np.float64)
    for i in range(8):
        for j in range(8):
            if i != j:
                diff = sum(abs(vertices[i][k] - vertices[j][k]) for k in range(3))
                if diff == 1:
                    C8[i, j] = 1
    
    J8 = np.ones((8, 8), dtype=np.float64)
    Z8 = np.zeros((8, 8), dtype=np.float64)
    
    G = np.block([[Z8, J8, Z8],
                  [J8, C8, J8],
                  [Z8, J8, Z8]])
    return G, C8

def comm_eq_num(A):
    n = A.shape[0]
    rows = []
    for i in range(n):
        for j in range(n):
            row = np.zeros(n*n, dtype=np.float64)
            for k in range(n):
                row[i*n + k] += A[k, j]
                row[k*n + j] -= A[i, k]
            rows.append(row)
    return np.array(rows, dtype=np.float64)

def lie_closure(traceless, tol=1e-8):
    n = len(traceless)
    lie_basis = [X.flatten() for X in traceless]
    basis_np = np.array(lie_basis, dtype=np.float64)
    
    Q_full, R = qr(basis_np.T, mode='economic')
    Q = Q_full.T
    
    escapes = 0
    checked = 0
    
    for i in range(n):
        for j in range(i+1, n):
            checked += 1
            C = traceless[i] @ traceless[j] - traceless[j] @ traceless[i]
            if np.linalg.norm(C) > 1e-12:
                v = C.flatten()
                proj = Q.T @ (Q @ v)
                residual = v - proj
                if np.linalg.norm(residual) > tol:
                    escapes += 1
    
    return escapes, checked, len(lie_basis)

def derived_algebra_dimension(traceless, tol=1e-6):
    n = len(traceless)
    commutators = []
    for i in range(n):
        for j in range(i+1, n):
            Cij = traceless[i] @ traceless[j] - traceless[j] @ traceless[i]
            if np.linalg.norm(Cij) > 1e-12:
                commutators.append(Cij.flatten())
    
    if not commutators:
        return 0, np.array([])
    
    comm_mat = np.array(commutators)
    U, S, Vt = svd(comm_mat, full_matrices=False)
    derived_dim = np.sum(S > tol)
    return derived_dim, Vt[:derived_dim].T

