def chsh_correlation_singlet(a, b):
    """Quantum correlation for singlet: E(a,b) = -cos(a-b)"""
    return -np.cos(a - b)

def chsh_value():
    """
    CHSH with optimal angles for singlet state.
    S = |E(a,b) - E(a,b') + E(a',b) + E(a',b')|
    Optimal: a=0, a'=π/2, b=π/4, b'=3π/4
    Gives S = 2√2 ≈ 2.828
    """
    a, a_prime = 0.0, np.pi/2
    b, b_prime = np.pi/4, 3*np.pi/4
    
    E_ab = chsh_correlation_singlet(a, b)
    E_abp = chsh_correlation_singlet(a, b_prime)
    E_apb = chsh_correlation_singlet(a_prime, b)
    E_apbp = chsh_correlation_singlet(a_prime, b_prime)
    
    # CHSH for singlet: S = |E(a,b) - E(a,b') + E(a',b) + E(a',b')|
    S = abs(E_ab - E_abp + E_apb + E_apbp)
    return S, [E_ab, E_abp, E_apb, E_apbp]

