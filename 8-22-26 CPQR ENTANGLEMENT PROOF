def oscillator_entropy(omega, T):
    """
    von Neumann entropy of a quantum harmonic oscillator at temperature T.
    S = x/(e^x - 1) - ln(1 - e^(-x)) where x = ħω/k_BT
    """
    hbar = 1.054e-34
    k_B = 1.381e-23
    x = hbar * omega / (k_B * T)
    if x < 1e-12:
        return 0.0
    S = x / (np.exp(x) - 1) - np.log(1 - np.exp(-x))
    return max(S, 0.0)

