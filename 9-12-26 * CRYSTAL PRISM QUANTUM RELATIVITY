def anisotropy(ion_pts, r_test=1.5, n_angles=50):
    ions = list(set(ion_pts))
    ions = [p for p in ions if np.sqrt(p[0]**2+p[1]**2+p[2]**2) < 4.0]
    V_values = []
    for t in np.linspace(0.01, pi-0.01, n_angles):
        for p in np.linspace(0, 2*pi, n_angles):
            x = r_test * np.sin(t) * np.cos(p)
            y = r_test * np.sin(t) * np.sin(p)
            z = r_test * np.cos(t)
            V = sum(1.0/np.sqrt((x-i[0])**2+(y-i[1])**2+(z-i[2])**2) 
                    for i in ions 
                    if np.sqrt((x-i[0])**2+(y-i[1])**2+(z-i[2])**2) > 0.1)
            V_values.append(V)
    V_values = np.array(V_values)
    return np.std(V_values) / np.mean(V_values)

