def compute_photometric_mass(R_kpc, V_disk_ml, V_bul_ml, V_gas):
    """
    Compute baryonic mass from rotation curve using 90th percentile.
    
    Uses the 90th percentile of V_bar² × R / G_PC.
    This is robust to outliers and follows standard methods.
    
    Parameters
    ----------
    R_kpc : array
        Radii in kpc
    V_disk_ml : array
        Disk velocities with M/L applied
    V_bul_ml : array
        Bulge velocities with M/L applied
    V_gas : array
        Gas velocities
        
    Returns
    -------
    float
        Baryonic mass in solar masses
    """
    V_bar = np.sqrt(V_disk_ml**2 + V_bul_ml**2 + V_gas**2)
    R_pc = R_kpc * C.kpc_to_pc
    integrand = V_bar**2 * R_pc
    M_bar = np.percentile(integrand, 90) / C.G_PC
    return max(M_bar, 1e-5)

def compute_a0_eff_z(R_kpc, S_bar, V_flat, z=0, max_iter=20, tol=1e-4):
    """
    Self-consistent effective acceleration scale with redshift evolution.
    
    a_eff = a_base × sqrt(Σ_transition / Σ_char)
    
    The transition radius r_t = V_flat² / a_eff depends on a_eff,
    which depends on Σ at r_t. This is solved self-consistently.
    
    Parameters
    ----------
    R_kpc : array
        Radii in kpc
    S_bar : array
        Baryonic surface density
    V_flat : float
        Asymptotic rotation velocity in km/s
    z : float
        Redshift
    max_iter : int
        Maximum iterations
    tol : float
        Convergence tolerance
        
    Returns
    -------
    tuple
        (a0_eff, n_iter) where a0_eff is in km²/s²/kpc
    """
    R_kpc = np.asarray(R_kpc, dtype=float)
    S_bar = np.asarray(S_bar, dtype=float)
    
    a0_base_z = C.a_base * (C.H_z(z) / C.H0)
    a0_eff = a0_base_z
    
    for iteration in range(max_iter):
        r_transition = V_flat**2 / a0_eff
        r_transition = np.clip(r_transition, R_kpc.min()*1.01, R_kpc.max()*0.99)
        Sigma_transition = np.interp(r_transition, R_kpc, S_bar)
        Sigma_ratio = np.clip(Sigma_transition / C.Sigma_char, 0.01, 100.0)
        a0_new = a0_base_z * np.sqrt(Sigma_ratio)
        a0_new = np.clip(a0_new, 400 * (C.H_z(z)/C.H0), 12000 * (C.H_z(z)/C.H0))
        
        if abs(a0_new - a0_eff) / a0_eff < tol:
            return a0_new, iteration
        
        a0_eff = 0.7 * a0_eff + 0.3 * a0_new
    
    return a0_eff, max_iter

def vortex_predict(R_kpc, V_disk_raw, V_bul_raw, V_gas_raw,
                   ups_disk, ups_bul, z=0, V_flat=None):
    """
    Superfluid vortex model prediction.
    
    The total velocity is:
    V_pred² = V_bar² + V_vortex²
    
    where:
    - V_bar is from baryonic matter (stars + gas)
    - V_vortex = V_flat × (1 - exp(-r/r_t))
    - r_t = V_flat² / a0_eff
    
    Parameters
    ----------
    R_kpc : array
        Radii in kpc
    V_disk_raw : array
        Raw disk velocities
    V_bul_raw : array
        Raw bulge velocities
    V_gas_raw : array
        Raw gas velocities
    ups_disk : float
        Disk mass-to-light ratio
    ups_bul : float
        Bulge mass-to-light ratio
    z : float
        Redshift
    V_flat : float, optional
        Asymptotic rotation velocity (computed if None)
        
    Returns
    -------
    dict
        Model prediction results
    """
    R_kpc = np.asarray(R_kpc, dtype=float)
    
    if len(V_disk_raw) != len(R_kpc):
        R_orig = np.linspace(R_kpc.min(), R_kpc.max(), len(V_disk_raw))
        V_disk_int = np.interp(R_kpc, R_orig, V_disk_raw)
        V_bul_int = np.interp(R_kpc, R_orig, V_bul_raw)
        V_gas_int = np.interp(R_kpc, R_orig, V_gas_raw)
    else:
        V_disk_int = V_disk_raw
        V_bul_int = V_bul_raw
        V_gas_int = V_gas_raw
    
    # Apply mass-to-light ratios (standard stellar population parameters)
    V_disk_ml = V_disk_int * np.sqrt(max(ups_disk, 0.01))
    V_bul_ml = V_bul_int * np.sqrt(max(ups_bul, 0.01))
    
    # Baryonic velocity (standard Newtonian)
    V_bar = np.sqrt(V_gas_int**2 + V_disk_ml**2 + V_bul_ml**2)
    M_bar = compute_photometric_mass(R_kpc, V_disk_ml, V_bul_ml, V_gas_int)
    
    # Flat rotation velocity from BTFR
    if V_flat is None:
        M_bar_kg = M_bar * C.M_sun_kg
        a0_z = C.a0_z(z)
        V_flat = (a0_z * C.G * M_bar_kg) ** 0.25 / 1000.0
    
    # Surface densities
    R_pc = R_kpc * C.kpc_to_pc
    eps = 1e-10
    Sigma_gas = np.where(R_pc > eps, V_gas_int**2 / (2*np.pi*C.G_PC*R_pc), 0)
    Sigma_disk = np.where(R_pc > eps, V_disk_ml**2 / (2*np.pi*C.G_PC*R_pc), 0)
    Sigma_bul = np.where(R_pc > eps, V_bul_ml**2 / (2*np.pi*C.G_PC*R_pc), 0)
    Sigma_bar = Sigma_gas + Sigma_disk + Sigma_bul
    
    # Self-consistent acceleration scale
    a0_eff, n_iter = compute_a0_eff_z(R_kpc, Sigma_bar, V_flat, z=z)
    
    # Vortex velocity profile (from Gross-Pitaevskii)
    r_transition = V_flat**2 / a0_eff
    x = R_kpc / r_transition
    vortex_profile = C.alpha_vortex * (1.0 - np.exp(-x**C.beta_vortex))
    V_vortex = V_flat * vortex_profile
    
    # Total velocity (standard gravity + vortex)
    V_pred = np.sqrt(V_bar**2 + V_vortex**2)
    
    return {
        'V_pred': V_pred,
        'V_bar': V_bar,
        'V_vortex': V_vortex,
        'V_flat': V_flat,
        'M_bar': M_bar,
        'a0_eff': a0_eff,
        'r_transition': r_transition,
        'ups_disk': ups_disk,
        'ups_bul': ups_bul,
        'z': z,
        'Hz_H0': C.H_z(z) / C.H0,
    }

