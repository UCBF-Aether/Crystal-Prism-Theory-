def fit_vortex_profile(v_flat, r_max):
    """
    Fit the vortex profile shape to MaNGA data.
    
    The model is: V_pred = V_flat × (1 - exp(-r_max / r_t))
    
    Only r_t is fitted per galaxy. All other parameters are fixed.
    
    Parameters
    ----------
    v_flat : float
        Maximum rotation velocity in km/s
    r_max : float
        Radius at V_flat in kpc
        
    Returns
    -------
    dict
        Fit results with residual
    """
    if v_flat <= 0 or r_max <= 0:
        return None
    
    def objective(r_t):
        if r_t <= 0:
            return 1e10
        v_pred = v_flat * (1.0 - np.exp(-r_max / r_t))
        return abs(v_pred - v_flat) / v_flat
    
    result = minimize(objective, x0=5.0, bounds=[(0.5, 20.0)], method='L-BFGS-B')
    
    if not result.success:
        return None
    
    r_t = result.x[0]
    v_pred = v_flat * (1.0 - np.exp(-r_max / r_t))
    residual_pct = 100 * abs(v_pred - v_flat) / v_flat
    
    return {
        'r_t': r_t,
        'v_pred': v_pred,
        'residual_pct': residual_pct,
    }

