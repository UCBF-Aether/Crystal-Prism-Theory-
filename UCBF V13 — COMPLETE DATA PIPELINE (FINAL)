    mean_all = np.mean(all_res) if all_res else 0
    median_all = np.median(all_med_res) if all_med_res else 0
    rms_all = np.mean(all_rms) if all_rms else 0
    redchi2_all = np.mean(all_redchi2) if all_redchi2 else 0
    
    mean_high = np.mean(high_res) if high_res else 0
    median_high = np.median(high_med_res) if high_med_res else 0
    rms_high = np.mean(high_rms) if high_rms else 0
    redchi2_high = np.mean(high_redchi2) if high_redchi2 else 0
    
    if verbose:
        print(f"\n  ✅ SPARC validation complete")
        print(f"    Total galaxies: {len(results)}")
        print(f"    High-quality: {len(high_res)}")
        print(f"    Mean residual (high-quality): {mean_high:.2f}%")
        print(f"    Median residual (high-quality): {median_high:.2f}%")
        print(f"    RMS velocity (high-quality): {rms_high:.2f} km/s")
        print(f"    Reduced χ² (high-quality): {redchi2_high:.2f}")
        print(f"    Mean residual (all): {mean_all:.2f}%")
        print(f"    Median residual (all): {median_all:.2f}%")
        print(f"    RMS velocity (all): {rms_all:.2f} km/s")
        print(f"    Reduced χ² (all): {redchi2_all:.2f}")
