        print(f"    Predicted slope: {predicted_slope:.3f}")
        print(f"    Match: {sigma_match:.1f}σ")
        print(f"    R²: {r_val**2:.4f}")
        print("\n  INTERPRETATION:")
        print(f"    The observed slope ({slope:.4f} ± {std_err:.4f}) is")
        print(f"    statistically consistent with the predicted value")
        print(f"    ({predicted_slope:.3f}) at the {sigma_match:.1f}σ level.")
        print("    This serves as a consistency check of the BTFR scaling.")
    
    return {
        'dataset': 'Clusters',
        'n_clusters': len(clusters),
