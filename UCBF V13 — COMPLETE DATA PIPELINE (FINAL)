def fetch_manga_vizier(limit=None, verbose=True):
    """
    Fetch MaNGA data from Vizier catalog via HTTP.
    
    Data source: Arora+2026 (J/MNRAS/522/1208)
    
    The catalog has 27 columns. Key columns for UCBF V13:
    - MaNGA (col 1): galaxy_id
    - RAJ2000 (col 2): ra
    - DEJ2000 (col 3): dec
    - z (col 4): redshift
    - i (col 14): inclination
    - PA (col 11): position angle
    - Vmax (col 16): v_flat_kms
    - e_Vmax (col 17): v_err_kms
    - Rt (col 18): r_max_kpc
    
    Quality filters:
    - V_flat > 30 km/s (reliable rotation)
    - r_max > 0.5 kpc (resolved)
    - V_flat < 500 km/s (remove outliers)
    
    Returns
    -------
    pandas.DataFrame
        Clean MaNGA galaxy data
    """
    if verbose:
        print("\n[MaNGA] Fetching data from Vizier...")
    
    url = "https://vizier.cds.unistra.fr/viz-bin/asu-tsv"
    catalog = "J/MNRAS/522/1208/table"
    
    params = {
        "-source": catalog,
        "-out.all": "",
        "-out.form": "minimal",
    }
    
    if limit:
        params["-to"] = str(limit)
    
    try:
        if verbose:
            print("  Querying Vizier...")
        
        response = requests.get(url, params=params, timeout=60)
        
        if response.status_code != 200:
            print(f"  ❌ HTTP {response.status_code}")
            return None
        
        lines = response.text.split('\n')
        
        # Find data rows
        data_rows = []
        for line in lines:
            line = line.strip()
            if not line:
                continue
            if line.startswith('#'):
                continue
            if '---' in line:
                continue
            if 'Title' in line:
                continue
            if 'MaNGA' in line and 'RAJ2000' in line:
                continue
            if re.match(r'^\d+-\d+', line):
                data_rows.append(line)
        
        if not data_rows:
            print("  ❌ No data rows found")
            return None
        
        if verbose:
            print(f"  Found {len(data_rows)} data rows")
        
        # Parse data rows - split by whitespace
        parsed_data = []
        for row in data_rows:
            parts = row.split()
            if len(parts) >= 27:
                parsed_data.append(parts[:27])
        
        if not parsed_data:
            print("  ❌ No parsed data (need at least 27 columns)")
            return None
        
        if verbose:
            print(f"  Parsed {len(parsed_data)} rows with 27 columns each")
        
        # ---- 27 COLUMN NAMES (Based on Vizier TSV structure) ----
        col_names = [
            'MaNGA', 'RAJ2000', 'DEJ2000', 'z', 'TType', 'Xc', 'e_Xc',
            'Yc', 'e_Yc', 'Vsys', 'e_Vsys', 'PA', 'e_PA', 'i', 'e_i',
            'Vmax', 'e_Vmax', 'Rt', 'e_Rt', 'Opt/IRphot', 'Ahumada20',
            'Dominguez-Sanchez18', 'Fischer19', 'MaNGAdr15', 'Sloandr17',
            'VisualTools', 'Marvin'
        ]
        
        df = pd.DataFrame(parsed_data, columns=col_names)
        
        # ---- CONVERT KEY COLUMNS TO NUMERIC ----
        numeric_cols = ['RAJ2000', 'DEJ2000', 'z', 'i', 'PA', 'Vmax', 'e_Vmax', 'Rt']
        for col in numeric_cols:
            if col in df.columns:
                df[col] = pd.to_numeric(df[col], errors='coerce')
        
        # ---- MAP TO UCBF V13 COLUMN NAMES ----
        ucbf_df = pd.DataFrame()
        ucbf_df['galaxy_id'] = df['MaNGA'].astype(str).str.strip()
        ucbf_df['ra'] = df['RAJ2000']
        ucbf_df['dec'] = df['DEJ2000']
        ucbf_df['redshift'] = df['z']
        ucbf_df['inclination_deg'] = df['i']
        ucbf_df['position_angle_deg'] = df['PA']
        ucbf_df['v_flat_kms'] = df['Vmax']
        ucbf_df['v_err_kms'] = df['e_Vmax']
        ucbf_df['r_max_kpc'] = df['Rt']
        
        # ---- CLEAN DATA ----
        # Remove rows with invalid V_flat
        ucbf_df = ucbf_df[ucbf_df['v_flat_kms'].notna() & (ucbf_df['v_flat_kms'] > 0)]
        ucbf_df = ucbf_df[ucbf_df['r_max_kpc'].notna() & (ucbf_df['r_max_kpc'] > 0)]
        ucbf_df = ucbf_df.reset_index(drop=True)
        
        # Apply quality filters
        ucbf_df = ucbf_df[ucbf_df['v_flat_kms'] > 30]   # Reliable rotation
        ucbf_df = ucbf_df[ucbf_df['r_max_kpc'] > 0.5]    # Resolved
        ucbf_df = ucbf_df[ucbf_df['v_flat_kms'] < 500]   # Remove outliers
        
        ucbf_df = ucbf_df.reset_index(drop=True)
        
        if verbose:
            print(f"  ✅ Loaded {len(ucbf_df)} MaNGA galaxies (after quality cuts)")
            if len(ucbf_df) > 0:
                print(f"    V_flat: {ucbf_df['v_flat_kms'].min():.1f} - {ucbf_df['v_flat_kms'].max():.1f} km/s")
                print(f"    r_max: {ucbf_df['r_max_kpc'].min():.2f} - {ucbf_df['r_max_kpc'].max():.2f} kpc")
        
        return ucbf_df
        
    except Exception as e:
        print(f"  ❌ Error: {e}")
        return None

