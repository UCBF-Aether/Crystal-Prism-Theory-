def fit_galaxy_sparc(R, V_obs, V_err, V_disk, V_bul, V_gas, z=0):
    """
    Fit SPARC galaxy with UCBF V13.
    
    Only fits standard stellar population parameters:
    - Υ_disk: Disk mass-to-light ratio (0.01 - 2.5)
    - Υ_bulge: Bulge mass-to-light ratio (0.01 - 2.5)
    
    All vortex parameters are fixed by the superfluid framework.
    
    Returns
    -------
    dict
        Fit results with mean and median absolute residual
    """
    def objective(x):
        ups_disk, ups_bul = x
        try:
            result = vortex_predict(R, V_disk, V_bul, V_gas, ups_disk, ups_bul, z=z)
            V_pred = result['V_pred']
        except:
            return 1e10
        
        mask = (V_obs > 1.0) & (V_err > 0)
        if np.sum(mask) < 3:
            return 1e10
        
        errs = np.sqrt(V_err[mask]**2 + (0.05 * V_obs[mask])**2)
        chi2 = np.sum(((V_pred[mask] - V_obs[mask])**2) / (errs**2))
        ndof = max(np.sum(mask) - 2, 1)
        return chi2 / ndof
    
    bounds = [(0.01, 2.5), (0.01, 2.5)]
    best_x = [0.5, 0.7]
    best_f = 1e10
    
    for start in [[0.5, 0.7], [0.3, 0.5], [1.0, 1.0], [0.8, 0.3]]:
        try:
            res = minimize(objective, start, method='L-BFGS-B', 
                          bounds=bounds, options={'maxiter': 100})
            if res.fun < best_f:
                best_f = res.fun
                best_x = res.x
        except:
            continue
    
    ups_disk, ups_bul = best_x
    ps = vortex_predict(R, V_disk, V_bul, V_gas, ups_disk, ups_bul, z=z)
    
    mask = V_obs > 1.0
    residuals = ps['V_pred'][mask] - V_obs[mask]
    pct_residuals = 100 * residuals / V_obs[mask]
    
    errs = np.sqrt(V_err[mask]**2 + (0.05 * V_obs[mask])**2)
    chi2 = np.sum((residuals / errs)**2)
    ndof = max(np.sum(mask) - 2, 1)
    
    return {
        'ups_disk': ups_disk,
        'ups_bul': ups_bul,
        'ps': ps,
        'mean_abs_pct': np.mean(np.abs(pct_residuals)),
        'median_abs_pct': np.median(np.abs(pct_residuals)),
        'rms': np.sqrt(np.mean(residuals**2)),
        'redchi2': chi2 / ndof,
        'n_pts': np.sum(mask),
        'ndof': ndof,
    }

