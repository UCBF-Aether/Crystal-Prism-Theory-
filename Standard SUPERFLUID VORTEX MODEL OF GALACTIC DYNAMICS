def plot_cluster_btfr(clusters, save=True):
    """Plot cluster BTFR with superfluid vortex prediction."""
    vikh = [c for c in clusters if c['source'] == 'Vikhlinin+2006']
    clash = [c for c in clusters if c['source'] == 'CLASH']
    
    fig, ax = plt.subplots(figsize=(8, 6))
    
    ax.scatter([c['M_bar'] for c in vikh], [c['sigma_obs'] for c in vikh],
               c='red', marker='o', s=80, label='Vikhlinin+2006', alpha=0.8, edgecolors='black')
    ax.scatter([c['M_bar'] for c in clash], [c['sigma_obs'] for c in clash],
               c='blue', marker='s', s=80, label='CLASH', alpha=0.7, edgecolors='black')
    
    M_grid = np.logspace(13, 15.5, 100)
    sigma_grid = (C.a0_0 * C.G * M_grid * C.M_sun_kg) ** 0.25 / 1000.0
    ax.loglog(M_grid, sigma_grid, 'k--', linewidth=2.5, 
             label=r'Predicted: $\sigma^4 = a_0 G M_{\mathrm{bar}}$')
    
    all_M = np.array([c['M_bar'] for c in clusters])
    all_sigma = np.array([c['sigma_obs'] for c in clusters])
    logM = np.log10(all_M)
    logSigma = np.log10(all_sigma)
    slope, intercept, r_value, p_value, std_err = stats.linregress(logM, logSigma)
    
    M_fit = np.logspace(np.min(logM), np.max(logM), 100)
    sigma_fit = 10**intercept * M_fit ** slope
    ax.loglog(M_fit, sigma_fit, 'g-', linewidth=2, label=f'Best fit: β={slope:.3f}')
    
    ax.set_xlabel(r'Baryonic Mass $M_{\mathrm{bar}}$ ($M_\odot$)', fontsize=12)
    ax.set_ylabel(r'Velocity Dispersion $\sigma$ (km/s)', fontsize=12)
    ax.set_title(f'Cluster BTFR: {len(clusters)} Clusters\n'
                f'β = {slope:.3f} ± {std_err:.3f} (predicted 0.250, {abs(slope-0.25)/std_err:.1f}σ)', 
                fontsize=11)
    ax.legend(loc='upper left', fontsize=9)
    ax.grid(True, alpha=0.3)
    
    plt.tight_layout()
    
    if save:
        plt.savefig('UCBF_V13_Cluster_BTFR.png', dpi=200, bbox_inches='tight')
