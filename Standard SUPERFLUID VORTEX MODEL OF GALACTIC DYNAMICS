class PhysicalConstants:
    """
    Physical constants used in the superfluid vortex model.
    
    All constants are either:
    1. Known physical constants (G, c, H0)
    2. Derived from superfluid physics (a0, a_base, Sigma_char)
    3. Standard cosmological parameters (Omega_m, Omega_Lambda)
    
    The vortex parameters are fixed by the superfluid framework,
    not fitted to individual galaxies.
    """
    
    # Known physical constants
    G = 6.6720e-11          # m³/kg/s² (Newton's constant)
    c = 2.99792458e8        # m/s (speed of light)
    H0 = 67.4               # km/s/Mpc (Hubble constant)
    M_sun_kg = 1.989e30     # kg (solar mass)
    
    # Superfluid vortex parameters (fixed by framework)
    a0_0 = 1.0422e-10       # m/s² (acceleration scale)
    a_base = 3700.0         # km²/s²/kpc (base acceleration)
    Sigma_char = 50.0       # M☉/pc² (characteristic density)
    
    # Vortex profile parameters (from Gross-Pitaevskii)
    alpha_vortex = 1.0      # From vortex solution
    beta_vortex = 0.5       # From vortex core profile
    
    # Astronomical conversions
    G_PC = 4.3009e-3        # (km/s)² kpc/M☉
    kpc_to_pc = 1000.0      # pc per kpc
    keV_to_J = 1.60218e-16  # J per keV
    
    # Gas physics
    mu = 0.588              # Mean molecular weight
    mp = 1.6726e-27         # kg (proton mass)
    
    # Cosmological parameters
    Omega_m = 0.315
    Omega_Lambda = 0.685
    Omega_k = 0.0
    
    @staticmethod
    def H_z(z):
        """Hubble parameter at redshift z (km/s/Mpc)."""
        H0 = PhysicalConstants.H0
        Om_m = PhysicalConstants.Omega_m
        Om_L = PhysicalConstants.Omega_Lambda
        Om_k = PhysicalConstants.Omega_k
        return H0 * np.sqrt(Om_m * (1+z)**3 + Om_L + Om_k * (1+z)**2)
    
    @staticmethod
    def a0_z(z):
        """
        Redshift-dependent acceleration scale.
        
        This follows from the superfluid coherence length scaling
        with the Hubble radius: a0(z) = a0(0) × H(z)/H0.
        """
        return PhysicalConstants.a0_0 * (PhysicalConstants.H_z(z) / PhysicalConstants.H0)

C = PhysicalConstants()

