def density_profile(r, beta_val, xi=1.0):
    return 1.0 - np.exp(-(r/xi)**beta_val)

def energy_2D(beta_val, V0, xi=1.0, r_max=30.0):
    def f_int(r):
        n = density_profile(r, beta_val, xi)
        return (1-n)**2 * r
    def g_int(r):
        dn = (beta_val/xi) * (r/xi)**(beta_val-1) * np.exp(-(r/xi)**beta_val)
        return dn**2 * r
    Ef = quad(f_int, 0, r_max, epsabs=1e-14, epsrel=1e-14)[0]
    El = quad(g_int, 0, r_max, epsabs=1e-14, epsrel=1e-14)[0]
    return Ef + V0 * El

def optimal_beta_2D(V0):
    res = minimize_scalar(lambda b: energy_2D(b, V0),
                         bounds=(0.01, 2.0), method='bounded',
                         options={'xatol': 1e-14})
    return res.x

