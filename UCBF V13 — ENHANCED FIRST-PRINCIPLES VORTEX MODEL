    ax.axhspan(-ps['V_flat']*0.05, ps['V_flat']*0.05, alpha=0.1, color='green')
    
    ax.set_xlabel('R (kpc)', fontsize=11)
    ax.set_ylabel('Residual (km/s)', fontsize=11)
    ax.set_title(f'Residuals | RMS = {result["rms"]:.1f} km/s')
    ax.legend(loc='lower right', fontsize=9)
    ax.grid(True, alpha=0.25)
    
    plt.tight_layout()
    
    if save:
        plt.savefig(f'UCBF_V13_{gal["name"]}_RotationCurve.png', dpi=150, bbox_inches='tight')
    
