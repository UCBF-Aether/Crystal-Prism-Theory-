ZENODO_URL = "https://zenodo.org/records/16284118/files/Rotmod_LTG.zip"

def load_sparc_v13(sparc_dir="sparc_data", verbose=True, include_m31=True):
    """Load SPARC data with better error handling and quality flags"""
    os.makedirs(sparc_dir, exist_ok=True)
    zip_path = os.path.join(sparc_dir, "Rotmod_LTG.zip")
    
    if not os.path.exists(zip_path):
        if verbose: print(f"Downloading SPARC from Zenodo...")
        response = requests.get(ZENODO_URL, timeout=60)
        response.raise_for_status()
        with open(zip_path, 'wb') as f:
            f.write(response.content)
    
    if not glob.glob(f"{sparc_dir}/*_rotmod.dat"):
        if verbose: print(f"Extracting...")
        with zipfile.ZipFile(zip_path, 'r') as zip_ref:
            zip_ref.extractall(sparc_dir)
    
    galaxies = {}
    dat_files = sorted(glob.glob(f"{sparc_dir}/*_rotmod.dat"))
    
    for fpath in dat_files:
        name = os.path.basename(fpath).replace('_rotmod.dat', '')
        data = []
        with open(fpath) as f:
            for line in f:
                s = line.strip()
                if not s or s.startswith('#'):
                    continue
                parts = s.split()
                if len(parts) >= 6:
                    try:
                        data.append([float(x) for x in parts[:8]])
                    except:
                        continue
        if len(data) < 3:
            continue
        
        d = np.array(data)
        R, Vobs, Verr = d[:,0], d[:,1], d[:,2]
        Vgas, Vdisk, Vbul = np.abs(d[:,3]), d[:,4], d[:,5] if d.shape[1]>5 else np.zeros_like(R)
        
        # Quality cuts
        mask = (Vobs > 0) & (Verr > 0) & (R > 0) & (Vobs < 500)  # Remove outliers
        if mask.sum() < 3:
            continue
        
        # Flag for quality
        n_pts = mask.sum()
        r_max = R[mask].max()
        v_max = Vobs[mask].max()
        
        quality = 'high' if (n_pts >= 10 and r_max > 15 and v_max > 50) else 'standard'
        
        galaxies[name] = {
            'name': name,
            'R_kpc': R[mask], 'V_obs': Vobs[mask], 'V_err': Verr[mask],
            'V_gas_raw': Vgas[mask], 'V_disk': Vdisk[mask], 'V_bul': Vbul[mask],
            'n_pts': n_pts, 'r_max': r_max, 'v_max': v_max,
            'quality': quality
        }
    
    # Add M31 if requested
    if include_m31 and 'M31' not in galaxies:
        galaxies['M31'] = {
            'name': 'M31',
            'R_kpc': np.array([5.,10.,15.,20.,25.,30.,35.,40.]),
            'V_obs': np.array([220.,225.,225.,220.,210.,190.,175.,170.]),
            'V_err': np.array([5.,5.,5.,5.,8.,10.,12.,15.]),
            'V_gas_raw': np.array([30.,45.,60.,55.,40.,30.,25.,20.]),
            'V_disk': np.array([180.,190.,170.,140.,110.,80.,60.,45.]),
            'V_bul': np.array([120.,80.,40.,10.,0.,0.,0.,0.]),
            'n_pts': 8, 'r_max': 40., 'v_max': 225.,
            'quality': 'high'
        }
    
    if verbose:
        n_high = sum(1 for g in galaxies.values() if g['quality'] == 'high')
        print(f"Loaded {len(galaxies)} galaxies ({n_high} high-quality)")
    
    return galaxies

