def plot_rotation_curve_v13(result, save=True):
    """Plot a single galaxy rotation curve with uncertainty"""
    gal = result['gal']
    ps = result['ps']
    
    fig, axes = plt.subplots(1, 2, figsize=(12, 5))
    
    # Main rotation curve
    ax = axes[0]
    ax.errorbar(gal['R_kpc'], gal['V_obs'], yerr=gal['V_err'],
               fmt='o', color='#1f77b4', markersize=5, capsize=2,
               elinewidth=0.8, alpha=0.8, label='Observed')
    
    R_smooth = np.linspace(0.01, max(gal['R_kpc']) * 1.05, 100)
    V_disk_int = np.interp(R_smooth, gal['R_kpc'], gal['V_disk'])
    V_bul_int = np.interp(R_smooth, gal['R_kpc'], gal['V_bul'])
    V_gas_int = np.interp(R_smooth, gal['R_kpc'], gal['V_gas_raw'])
    
    ps_smooth = vortex_predict_v13(R_smooth, V_disk_int, V_bul_int, V_gas_int,
                                  result['ups_disk'], result['ups_bul'])
    
    ax.plot(R_smooth, ps_smooth['V_pred'], 'r-', linewidth=2.5, label='UCBF V13')
    ax.plot(R_smooth, ps_smooth['V_bar'], 'g--', linewidth=1.5, alpha=0.7, label='Baryonic')
    ax.plot(R_smooth, ps_smooth['V_vortex'], 'm-.', linewidth=1.5, alpha=0.7, label='Vortex')
    
    # Mark transition radius
    ax.axvline(ps['r_transition'], color='gray', linestyle=':', alpha=0.5,
              label=f'r_t = {ps["r_transition"]:.1f} kpc')
    
    ax.set_xlabel('R (kpc)', fontsize=11)
    ax.set_ylabel('V (km/s)', fontsize=11)
    ax.set_title(f'{gal["name"]}\n'
                f'Residual: {result["mean_abs_pct"]:.1f}% | '
                f'V_flat = {ps["V_flat"]:.0f} km/s | '
                f'ϒ_disk = {result["ups_disk"]:.2f}, ϒ_bulge = {result["ups_bul"]:.2f}')
    ax.set_xlim(0, max(gal['R_kpc']) * 1.05)
    ax.set_ylim(0, max(max(gal['V_obs']), ps['V_pred'].max()) * 1.1)
    ax.legend(loc='lower right', fontsize=9)
    ax.grid(True, alpha=0.25)
    
    # Residual plot
    ax = axes[1]
    mask = gal['V_obs'] > 1.0
    residuals = ps['V_pred'][mask] - gal['V_obs'][mask]
    pct_res = 100 * residuals / gal['V_obs'][mask]
    
    ax.errorbar(gal['R_kpc'][mask], residuals, yerr=gal['V_err'][mask],
               fmt='o', color='#1f77b4', markersize=5, capsize=2,
               elinewidth=0.8, alpha=0.8)
    ax.axhline(0, color='black', linestyle='-', linewidth=1)
    ax.axhline(np.mean(residuals), color='red', linestyle='--', 
