def analyze_residuals(results):
    """Analyze residuals for systematics"""
    res_pct = []
    rms_values = []
    v_flat_values = []
    m_bar_values = []
    redchi2_values = []
    n_pts_values = []
    ups_disk_values = []
    ups_bul_values = []
    
    for name, r in results.items():
        if r['success']:
            res_pct.append(r['mean_abs_pct'])
            rms_values.append(r['rms'])
            v_flat_values.append(r['ps']['V_flat'])
            m_bar_values.append(np.log10(r['ps']['M_bar']))
            redchi2_values.append(r['redchi2'])
            n_pts_values.append(r['n_pts'])
            ups_disk_values.append(r['ups_disk'])
            ups_bul_values.append(r['ups_bul'])
    
    res_pct = np.array(res_pct)
    rms_values = np.array(rms_values)
    v_flat_values = np.array(v_flat_values)
    m_bar_values = np.array(m_bar_values)
    redchi2_values = np.array(redchi2_values)
    n_pts_values = np.array(n_pts_values)
    
    # Check for correlations with galaxy properties
    corr_vflat = stats.pearsonr(res_pct, v_flat_values)[0]
    corr_mbar = stats.pearsonr(res_pct, m_bar_values)[0]
    corr_npts = stats.pearsonr(res_pct, n_pts_values)[0]
    corr_upsd = stats.pearsonr(res_pct, ups_disk_values)[0]
    corr_upsb = stats.pearsonr(res_pct, ups_bul_values)[0]
    
    return {
        'mean_res': np.mean(res_pct),
        'median_res': np.median(res_pct),
        'std_res': np.std(res_pct),
        'mean_rms': np.mean(rms_values),
        'median_rms': np.median(rms_values),
        'mean_redchi2': np.mean(redchi2_values),
        'median_redchi2': np.median(redchi2_values),
        'corr_vflat': corr_vflat,
        'corr_mbar': corr_mbar,
        'corr_npts': corr_npts,
        'corr_upsd': corr_upsd,
        'corr_upsb': corr_upsb,
        'n_galaxies': len(res_pct),
    }

