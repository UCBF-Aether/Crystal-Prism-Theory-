def compute_photometric_mass_robust(R_kpc, V_disk_ml, V_bul_ml, V_gas_raw, method='percentile'):
    """
    Compute baryonic mass using robust statistics.
    Methods: 'percentile' (90th), 'peak' (max), 'integral' (trapezoidal)
    """
    V_bar = np.sqrt(V_disk_ml**2 + V_bul_ml**2 + V_gas_raw**2)
    R_pc = R_kpc * C.kpc_to_pc
    integrand = V_bar**2 * R_pc
    
    if method == 'percentile':
        # Use 90th percentile to avoid outliers
        M_bar = np.percentile(integrand, 90) / C.G_PC
    elif method == 'integral':
        # Integrate the rotation curve
        integral = np.trapz(integrand, R_pc)
        M_bar = integral / C.G_PC / R_pc[-1]  # Approximate
    else:  # 'peak'
        M_bar = np.max(integrand) / C.G_PC
    
    return max(M_bar, 1e-5)  # Floor value

def compute_a0_eff(R_kpc, S_bar, V_flat, max_iter=20, tol=1e-4):
    """
    Self-consistent computation of a0_eff.
    Now with convergence checking and damping.
    """
    R_kpc = np.asarray(R_kpc, dtype=float)
    S_bar = np.asarray(S_bar, dtype=float)
    
    # Initial guess
    a0_eff = C.a0_base
    
    for iteration in range(max_iter):
        r_transition = V_flat**2 / a0_eff
        # Clamp to valid range
        r_transition = np.clip(r_transition, R_kpc.min()*1.01, R_kpc.max()*0.99)
        Sigma_transition = np.interp(r_transition, R_kpc, S_bar)
        Sigma_ratio = np.clip(Sigma_transition / C.Sigma_char, 0.01, 100.0)
        a0_new = C.a0_base * np.sqrt(Sigma_ratio)
        a0_new = np.clip(a0_new, 400, 12000)  # Physical limits
        
        # Convergence check
        if abs(a0_new - a0_eff) / a0_eff < tol:
            return a0_new, iteration
        
        # Damped update for stability
        a0_eff = 0.7 * a0_eff + 0.3 * a0_new
    
    return a0_eff, max_iter

def vortex_predict_v13(R_kpc, V_disk_raw, V_bul_raw, V_gas_raw,
                       ups_disk, ups_bul, V_flat=None, method='percentile'):
    """
    UCBF V13 Vortex Equation with improvements.
    
    Parameters:
    -----------
    R_kpc : array
        Radii in kpc
    V_disk_raw, V_bul_raw, V_gas_raw : arrays
        Raw velocities from SPARC
    ups_disk, ups_bul : floats
        Mass-to-light ratios
    V_flat : float or None
        If None, compute self-consistently
    method : str
        Mass estimation method: 'percentile', 'peak', 'integral'
    
    Returns:
    --------
    dict with all derived quantities
    """
    R_kpc = np.asarray(R_kpc, dtype=float)
    
    # Ensure consistent length
    n_R = len(R_kpc)
    if len(V_disk_raw) != n_R:
        R_orig = np.linspace(R_kpc.min(), R_kpc.max(), len(V_disk_raw))
        V_disk_int = interp1d(R_orig, V_disk_raw, kind='linear', 
                            fill_value='extrapolate')(R_kpc)
        V_bul_int = interp1d(R_orig, V_bul_raw, kind='linear', 
                           fill_value='extrapolate')(R_kpc)
        V_gas_int = interp1d(R_orig, V_gas_raw, kind='linear', 
                           fill_value='extrapolate')(R_kpc)
    else:
        V_disk_int = V_disk_raw
        V_bul_int = V_bul_raw
        V_gas_int = V_gas_raw
    
    # Apply M/L ratios
    V_disk_ml = V_disk_int * np.sqrt(max(ups_disk, 0.01))
    V_bul_ml = V_bul_int * np.sqrt(max(ups_bul, 0.01))
    
    # Baryonic velocity
    V_bar = np.sqrt(V_gas_int**2 + V_disk_ml**2 + V_bul_ml**2)
    
    # Baryonic mass (robust)
    M_bar = compute_photometric_mass_robust(R_kpc, V_disk_ml, V_bul_ml, 
                                            V_gas_int, method=method)
    
    # Flat rotation velocity (BTFR from lattice)
    if V_flat is None:
        M_bar_kg = M_bar * C.M_sun_kg
        V_flat = (C.a0_SI * C.G_SI * M_bar_kg) ** 0.25 / 1000.0
    
    # Surface densities
    R_pc = R_kpc * C.kpc_to_pc
    eps = 1e-10
    Sigma_gas = np.where(R_pc > eps, V_gas_int**2 / (2*np.pi*C.G_PC*R_pc), 0)
    Sigma_disk = np.where(R_pc > eps, V_disk_ml**2 / (2*np.pi*C.G_PC*R_pc), 0)
    Sigma_bul = np.where(R_pc > eps, V_bul_ml**2 / (2*np.pi*C.G_PC*R_pc), 0)
    Sigma_bar = Sigma_gas + Sigma_disk + Sigma_bul
    
    # Self-consistent a0_eff
    a0_eff, n_iter = compute_a0_eff(R_kpc, Sigma_bar, V_flat)
    
    # Vortex profile (improved with error function for smoother transition)
    r_transition = V_flat**2 / a0_eff
    # Use erf for smoother transition, with vortex_alpha from lattice
    x = R_kpc / r_transition
    vortex_profile = C.vortex_alpha * (1.0 - np.exp(-x**C.vortex_beta))
    
    # Vortex velocity with smooth turnover at small R
    V_vortex = V_flat * vortex_profile
    
    # Combine baryonic + vortex
    V_pred = np.sqrt(V_bar**2 + V_vortex**2)
    
    return {
        'V_pred': V_pred,
        'V_bar': V_bar,
        'V_vortex': V_vortex,
        'V_flat': V_flat,
        'M_bar': M_bar,
        'a0_eff': a0_eff,
        'r_transition': r_transition,
        'Sigma_bar': Sigma_bar,
        'Sigma_transition': np.interp(r_transition, R_kpc, Sigma_bar),
        'n_iter': n_iter,
        'ups_disk': ups_disk,
        'ups_bul': ups_bul,
    }

