def log_prior(ups_disk, ups_bul):
    """Gaussian priors on M/L ratios from stellar population synthesis"""
    prior_disk = stats.norm.logpdf(ups_disk, C.prior_disk_mean, C.prior_disk_sigma)
    prior_bulge = stats.norm.logpdf(ups_bul, C.prior_bulge_mean, C.prior_bulge_sigma)
    return prior_disk + prior_bulge

def log_likelihood(params, gal):
    """Gaussian likelihood with systematic error floor"""
    ups_disk, ups_bul = params
    if ups_disk < 0.01 or ups_bul < 0.01:
        return -np.inf
    
    try:
        result = vortex_predict_v13(gal['R_kpc'], gal['V_disk'], gal['V_bul'],
                                   gal['V_gas_raw'], ups_disk, ups_bul)
        V_pred = result['V_pred']
    except:
        return -np.inf
    
    mask = (gal['V_obs'] > 1.0) & (gal['V_err'] > 0)
    if np.sum(mask) < 3:
        return -np.inf
    
    # Include systematic error floor (5% of velocity)
    errs = np.sqrt(gal['V_err'][mask]**2 + (0.05 * gal['V_obs'][mask])**2)
    chi2 = np.sum(((V_pred[mask] - gal['V_obs'][mask])**2) / (errs**2))
    
    log_lik = -0.5 * chi2
    log_prior_val = log_prior(ups_disk, ups_bul)
    
    return log_lik + log_prior_val

def log_posterior(params, gal):
    """Log posterior = log likelihood + log prior"""
    return log_likelihood(params, gal)

def mcmc_sampling(gal, n_walkers=32, n_steps=2000, burnin=500, verbose=True):
    """
    MCMC sampling using emcee if available, else use simple Metropolis.
    """
    try:
        import emcee
        return _mcmc_emcee(gal, n_walkers, n_steps, burnin, verbose)
    except ImportError:
        if verbose:
            print("  emcee not available, using simple Metropolis-Hastings")
        return _mcmc_metropolis(gal, n_steps, burnin, verbose)

def _mcmc_emcee(gal, n_walkers, n_steps, burnin, verbose):
    """MCMC with emcee"""
    import emcee
    
    # Initial guess
    ndim = 2
    p0 = np.random.randn(n_walkers, ndim) * 0.1 + np.array([0.5, 0.7])
    p0[:,0] = np.clip(p0[:,0], 0.1, 1.0)
    p0[:,1] = np.clip(p0[:,1], 0.1, 1.5)
    
    # Set up sampler
    sampler = emcee.EnsembleSampler(n_walkers, ndim, log_posterior, args=(gal,))
    
    # Run burn-in
    if verbose:
        print(f"  Running burn-in ({burnin} steps)...")
    p0, _, _ = sampler.run_mcmc(p0, burnin, progress=False)
    sampler.reset()
    
    # Run production
    if verbose:
        print(f"  Running production ({n_steps} steps)...")
    sampler.run_mcmc(p0, n_steps, progress=False)
    
    # Get samples (flatten chain)
    samples = sampler.get_chain(flat=True)
    
    # Compute statistics
    ups_disk_mean, ups_bul_mean = np.mean(samples, axis=0)
    ups_disk_std, ups_bul_std = np.std(samples, axis=0)
    ups_disk_16, ups_bul_16 = np.percentile(samples, 16, axis=0)
    ups_disk_84, ups_bul_84 = np.percentile(samples, 84, axis=0)
    
    return {
        'samples': samples,
        'ups_disk_mean': ups_disk_mean,
        'ups_bul_mean': ups_bul_mean,
        'ups_disk_std': ups_disk_std,
        'ups_bul_std': ups_bul_std,
        'ups_disk_16': ups_disk_16,
        'ups_bul_16': ups_bul_16,
        'ups_disk_84': ups_disk_84,
        'ups_bul_84': ups_bul_84,
        'acceptance_fraction': np.mean(sampler.acceptance_fraction),
    }

def _mcmc_metropolis(gal, n_steps, burnin, verbose):
    """Simple Metropolis-Hastings MCMC"""
    # Starting point
    x = np.array([0.5, 0.7])
    current_logp = log_posterior(x, gal)
    
    samples = []
    accepted = 0
    
    # Step sizes (adaptive)
    step_sizes = np.array([0.05, 0.05])
    
    for i in range(n_steps + burnin):
        # Proposal
        x_prop = x + np.random.randn(2) * step_sizes * 0.5
        x_prop = np.clip(x_prop, 0.01, 2.5)
        
        logp_prop = log_posterior(x_prop, gal)
        
        # Accept/reject
        if logp_prop - current_logp > np.log(np.random.rand()):
            x = x_prop
            current_logp = logp_prop
            accepted += 1
        
        if i >= burnin:
            samples.append(x.copy())
    
    samples = np.array(samples)
    acceptance = accepted / (n_steps + burnin)
    
    if acceptance < 0.1 or acceptance > 0.5:
        if verbose:
            print(f"  Warning: acceptance = {acceptance:.2f}")
    
    return {
        'samples': samples,
        'ups_disk_mean': np.mean(samples[:,0]),
        'ups_bul_mean': np.mean(samples[:,1]),
        'ups_disk_std': np.std(samples[:,0]),
        'ups_bul_std': np.std(samples[:,1]),
        'ups_disk_16': np.percentile(samples[:,0], 16),
        'ups_bul_16': np.percentile(samples[:,1], 16),
        'ups_disk_84': np.percentile(samples[:,0], 84),
        'ups_bul_84': np.percentile(samples[:,1], 84),
        'acceptance_fraction': acceptance,
    }

