def fit_single_galaxy(args):
    """Fit a single galaxy (for parallel processing)"""
    name, gal, use_mcmc = args
    
    try:
        # First, find best-fit with differential evolution
        bounds = [(0.01, 2.5), (0.01, 2.5)]
        
        def objective(x):
            try:
                result = vortex_predict_v13(gal['R_kpc'], gal['V_disk'], gal['V_bul'],
                                           gal['V_gas_raw'], x[0], x[1])
                V_pred = result['V_pred']
            except:
                return 1e10
            
            mask = (gal['V_obs'] > 1.0) & (gal['V_err'] > 0)
            if np.sum(mask) < 3:
                return 1e10
            
            errs = np.sqrt(gal['V_err'][mask]**2 + (0.05 * gal['V_obs'][mask])**2)
            chi2 = np.sum(((V_pred[mask] - gal['V_obs'][mask])**2) / (errs**2))
            return chi2 / len(mask)
        
        # Global optimization
        result = differential_evolution(objective, bounds, maxiter=50, popsize=15,
                                       seed=42, polish=True, disp=False)
        
        ups_disk, ups_bul = result.x
        
        # Run MCMC if requested
        mcmc_result = None
        if use_mcmc:
            mcmc_result = mcmc_sampling(gal, n_steps=1000, burnin=300, verbose=False)
            ups_disk = mcmc_result['ups_disk_mean']
            ups_bul = mcmc_result['ups_bul_mean']
        
        # Final prediction
        ps = vortex_predict_v13(gal['R_kpc'], gal['V_disk'], gal['V_bul'],
                               gal['V_gas_raw'], ups_disk, ups_bul)
        
        # Compute residuals
        mask = gal['V_obs'] > 1.0
        residuals = ps['V_pred'][mask] - gal['V_obs'][mask]
        pct_residuals = 100 * residuals / gal['V_obs'][mask]
        
        # Quality metrics
        rms = np.sqrt(np.mean(residuals**2))
        mean_abs_pct = np.mean(np.abs(pct_residuals))
        median_abs_pct = np.median(np.abs(pct_residuals))
        
        # χ² with error bars
        errs = np.sqrt(gal['V_err'][mask]**2 + (0.05 * gal['V_obs'][mask])**2)
        chi2 = np.sum((residuals / errs)**2)
        redchi2 = chi2 / max(len(mask) - 2, 1)
        
        return {
            'name': name,
            'gal': gal,
            'ups_disk': ups_disk,
            'ups_bul': ups_bul,
            'ps': ps,
            'residuals': residuals,
            'pct_residuals': pct_residuals,
            'mean_abs_pct': mean_abs_pct,
            'median_abs_pct': median_abs_pct,
            'rms': rms,
            'redchi2': redchi2,
            'chi2': chi2,
            'n_pts': len(mask),
            'mcmc': mcmc_result,
            'success': True
        }
    
    except Exception as e:
        return {
            'name': name,
            'success': False,
            'error': str(e)
        }

def fit_all_galaxies_v13(galaxies, use_mcmc=True, n_cores=None, verbose=True):
    """Fit all galaxies with optional parallel processing"""
    n_total = len(galaxies)
    if verbose:
        print(f"\nFitting {n_total} galaxies with UCBF V13...")
        if use_mcmc:
            print("  Using MCMC for parameter uncertainties")
    
    # Prepare arguments
    args_list = [(name, gal, use_mcmc) for name, gal in galaxies.items()]
    
    # Use parallel processing
    if n_cores is None:
        n_cores = min(cpu_count(), 4)  # Limit to 4 to avoid memory issues
    
    if n_cores > 1 and len(args_list) > 10:
        if verbose:
            print(f"  Using {n_cores} cores")
        with Pool(n_cores) as pool:
            results_list = pool.map(fit_single_galaxy, args_list)
    else:
        results_list = [fit_single_galaxy(args) for args in args_list]
    
    # Compile results
    results = {}
    for res in results_list:
        if res['success']:
            results[res['name']] = res
        elif verbose:
            print(f"  Failed: {res['name']} - {res.get('error', 'Unknown error')}")
    
    if verbose:
        print(f"✓ Complete: {len(results)} galaxies fitted successfully")
    
    return results

