def fetch_and_fit_sparc():
    print("  Fetching SPARC...")
    Vizier.ROW_LIMIT = -1
    cats = Vizier.get_catalogs('J/AJ/152/157')
    tables = list(cats)
    
    rc = None
    for table in tables:
        df = table.to_pandas()
        cols = [str(c).lower() for c in df.columns]
        if any('rad' in c for c in cols) and any('vobs' in c for c in cols):
            rc = df
            break
    
    if rc is None:
        return 0, 0
    
    results = []
    for name in rc['Name'].unique():
        g = rc[rc['Name'] == name]
        R = pd.to_numeric(g['Rad'], errors='coerce').values
        Vobs = pd.to_numeric(g['Vobs'], errors='coerce').values
        Vd = pd.to_numeric(g['Vdisk'], errors='coerce').values
        Vg = pd.to_numeric(g['Vgas'], errors='coerce').values
        
        mask = ~np.isnan(R) & ~np.isnan(Vobs) & ~np.isnan(Vd) & ~np.isnan(Vg)
        mask &= (Vobs > 0) & (R > 0)
        if mask.sum() < 5:
            continue
        
        R, Vobs, Vd, Vg = R[mask], Vobs[mask], Vd[mask], Vg[mask]
        
        def objective(x):
            V_bar = np.sqrt(Vg**2 + x[0]*Vd**2)
            M = max(np.percentile(V_bar**2 * R * 1000, 90) / G_PC, 1e-5)
            V_flat = (G * a0 * M * M_sun)**0.25 / 1000
            a_eff = a_base
            for _ in range(20):
                rt = np.clip(V_flat**2 / a_eff, R.min()*1.01, R.max()*0.99)
                Sig = np.interp(rt, R, V_bar**2/(2*np.pi*G_PC*R*1000))
                a_eff = a_base * np.sqrt(max(Sig/S_char, 0.01))
            V_vortex = V_flat * (1 - np.exp(-(R/(V_flat**2/a_eff))**beta))
            return np.mean((np.sqrt(V_bar**2 + V_vortex**2) - Vobs)**2)
        
        res = minimize(objective, x0=0.7, bounds=[(0.01, 2.5)], method='L-BFGS-B')
        
        V_bar = np.sqrt(Vg**2 + res.x[0]*Vd**2)
        M = max(np.percentile(V_bar**2 * R * 1000, 90) / G_PC, 1e-5)
        V_flat = (G * a0 * M * M_sun)**0.25 / 1000
        a_eff = a_base
        for _ in range(20):
            rt = np.clip(V_flat**2 / a_eff, R.min()*1.01, R.max()*0.99)
            Sig = np.interp(rt, R, V_bar**2/(2*np.pi*G_PC*R*1000))
            a_eff = a_base * np.sqrt(max(Sig/S_char, 0.01))
        V_vortex = V_flat * (1 - np.exp(-(R/(V_flat**2/a_eff))**beta))
        Vpred = np.sqrt(V_bar**2 + V_vortex**2)
        resid = 100 * np.median(np.abs(Vpred - Vobs) / Vobs)
        results.append(resid)
    
    return np.median(results), len(results)

