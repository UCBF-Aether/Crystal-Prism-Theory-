def potential_anisotropy(ion_pts, max_r=4.0, n_angles=100):
    """
    Compute the anisotropy of the potential at a fixed radius.
    Average V(r, θ, φ) over all angles, compute variance.
    Lower variance = smoother potential = better for electrons.
    """
    ions = list(set(ion_pts))
    ions = [p for p in ions if np.sqrt(p[0]**2 + p[1]**2 + p[2]**2) < max_r]
    
    r_test = 1.5  # test radius (between ions)
    
    # Sample angles
    theta = np.linspace(0, np.pi, n_angles)
    phi = np.linspace(0, 2*np.pi, n_angles)
    
    V_values = []
    for t in theta:
        for p in phi:
            x = r_test * np.sin(t) * np.cos(p)
            y = r_test * np.sin(t) * np.sin(p)
            z = r_test * np.cos(t)
            
            V = 0.0
            for ion in ions:
                d = np.sqrt((x-ion[0])**2 + (y-ion[1])**2 + (z-ion[2])**2)
                if d > 0.1:
                    V += 1.0 / d
            V_values.append(V)
    
    V_values = np.array(V_values)
    return np.std(V_values) / np.mean(V_values)

