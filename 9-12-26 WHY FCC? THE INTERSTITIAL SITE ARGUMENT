def sc_points(n):
    pts = []
    for i in range(-n, n+1):
        for j in range(-n, n+1):
            for k in range(-n, n+1):
                pts.append((i, j, k))
    return pts

def bcc_points(n):
    pts = []
    for i in range(-n, n+1):
        for j in range(-n, n+1):
            for k in range(-n, n+1):
                pts.append((i, j, k))
                pts.append((i+0.5, j+0.5, k+0.5))
    return pts

def fcc_points(n):
    pts = []
    for i in range(-n, n+1):
        for j in range(-n, n+1):
            for k in range(-n, n+1):
                pts.append((i, j, k))
                pts.append((i+0.5, j+0.5, k))
                pts.append((i+0.5, j, k+0.5))
                pts.append((i, j+0.5, k+0.5))
    return pts

def sc_octahedral_sites(n):
    """Octahedral interstitial sites in SC: at body centers."""
    pts = []
    for i in range(-n, n+1):
        for j in range(-n, n+1):
            for k in range(-n, n+1):
                pts.append((i+0.5, j+0.5, k+0.5))
    return pts

def bcc_octahedral_sites(n):
    """Octahedral sites in BCC: at face centers and edge midpoints."""
    pts = []
    for i in range(-n, n+1):
        for j in range(-n, n+1):
            for k in range(-n, n+1):
                pts.append((i+0.5, j+0.5, k))
                pts.append((i+0.5, j, k+0.5))
                pts.append((i, j+0.5, k+0.5))
    return pts

def fcc_octahedral_sites(n):
    """Octahedral sites in FCC: at edge midpoints and body center."""
    pts = []
    for i in range(-n, n+1):
        for j in range(-n, n+1):
            for k in range(-n, n+1):
                pts.append((i+0.5, j, k))
                pts.append((i, j+0.5, k))
                pts.append((i, j, k+0.5))
                pts.append((i+0.5, j+0.5, k+0.5))
    return pts

