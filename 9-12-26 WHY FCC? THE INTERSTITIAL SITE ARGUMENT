def yukawa_energy_per_ion(points, kappa, max_r=6.0):
    """Total Yukawa energy per ion for same-sign charges."""
    pts = list(set(points))
    pts = [p for p in pts if np.sqrt(p[0]**2 + p[1]**2 + p[2]**2) < max_r]
    
    if (0,0,0) not in pts:
        return None
    
    total = 0.0
    count = 0
    for i, pi in enumerate(pts):
        E_i = 0.0
        for j, pj in enumerate(pts):
            if i == j:
                continue
            d = np.sqrt((pi[0]-pj[0])**2 + (pi[1]-pj[1])**2 + (pi[2]-pj[2])**2)
            if d < 1e-10:
                continue
            E_i += np.exp(-kappa * d) / d
        total += E_i
        count += 1
    
    return total / (2 * count) if count > 0 else None

def ion_electron_energy(ion_pts, site_pts, max_r=6.0):
    """
    Ion-electron attraction energy per unit cell.
    Sum over all ion-site pairs of the Coulomb attraction.
    """
    ions = list(set(ion_pts))
    ions = [p for p in ions if np.sqrt(p[0]**2 + p[1]**2 + p[2]**2) < max_r]
    sites = list(set(site_pts))
    sites = [p for p in sites if np.sqrt(p[0]**2 + p[1]**2 + p[2]**2) < max_r]
    
    total = 0.0
    count = 0
    for site in sites:
        E_site = 0.0
        for ion in ions:
            d = np.sqrt((site[0]-ion[0])**2 + (site[1]-ion[1])**2 + (site[2]-ion[2])**2)
            if d < 1e-10:
                continue
            E_site += -1.0 / d  # Attractive (negative)
        total += E_site
        count += 1
    
    return total / count if count > 0 else None

def electron_kinetic_energy(n_e_density):
    """
    Thomas-Fermi kinetic energy per electron.
    E_kin = (3/5) × (ħ²/2m) × (3π²)^(2/3) × n_e^(2/3)
    
    In dimensionless units (energy in units of ħ²/(m a²)):
    E_kin = (3/5) × (3π²)^(2/3) × (n_e a³)^(2/3)
    """
    x = n_e_density  # n_e × a³, dimensionless
    C = 0.6 * (3 * np.pi**2)**(2/3)
    return C * x**(2/3)

