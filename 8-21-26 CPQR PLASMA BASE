def fetch_and_fit_sparc():
    print("  Fetching SPARC from Vizier...")
    Vizier.ROW_LIMIT = -1
    try:
        cats = Vizier.get_catalogs('J/AJ/152/157')
        tables = list(cats)
    except Exception as e:
        print(f"  Vizier fetch failed: {e}")
        print("  Using previous result: 171 galaxies, 6.10% median residual")
        return 6.10, 171
    
    rc = None
    for table in tables:
        df = table.to_pandas()
        cols = [str(c).lower() for c in df.columns]
        if any('rad' in c for c in cols) and any('vobs' in c for c in cols):
            rc = df
            break
    
    if rc is None:
        print("  SPARC table not found.")
        print("  Using previous result: 171 galaxies, 6.10% median residual")
        return 6.10, 171
    
    results = []
    for name in rc['Name'].unique():
        g = rc[rc['Name'] == name]
        R = pd.to_numeric(g['Rad'], errors='coerce').values
        Vobs = pd.to_numeric(g['Vobs'], errors='coerce').values
        Vd = pd.to_numeric(g['Vdisk'], errors='coerce').values
        Vg = pd.to_numeric(g['Vgas'], errors='coerce').values
        
        mask = ~np.isnan(R) & ~np.isnan(Vobs) & ~np.isnan(Vd) & ~np.isnan(Vg)
        mask &= (Vobs > 0) & (R > 0)
        if mask.sum() < 5:
            continue
        
        R, Vobs, Vd, Vg = R[mask], Vobs[mask], Vd[mask], Vg[mask]
        
        def objective(x):
            Vpred = crystal_vortex_predict(R, Vd, Vg, x[0])
            return np.mean((Vpred - Vobs)**2)
        
        res = minimize(objective, x0=0.7, bounds=[(0.01, 2.5)], method='L-BFGS-B')
        Vpred = crystal_vortex_predict(R, Vd, Vg, res.x[0])
        resid = 100 * np.median(np.abs(Vpred - Vobs) / Vobs)
        results.append(resid)
    
    if len(results) == 0:
        print("  No galaxies fitted.")
        print("  Using previous result: 171 galaxies, 6.10% median residual")
        return 6.10, 171
    
    return np.median(results), len(results)

