def save_csv(
    path,
    rows
):

    if not rows:
        return

    fieldnames = sorted(
        {
            key
            for row in rows
            for key in row.keys()
        }
    )

    try:

        with open(
            path,
            "w",
            newline="",
            encoding="utf-8"
        ) as f:

            writer = csv.DictWriter(
                f,
                fieldnames=fieldnames
            )

            writer.writeheader()

            for row in rows:

                clean = {}

                for key in fieldnames:

                    value = row.get(
                        key,
                        ""
                    )

                    if (
                        isinstance(
                            value,
                            float
                        )
                        and
                        not math.isfinite(
                            value
                        )
                    ):

                        value = ""

                    clean[key] = value

                writer.writerow(
                    clean
                )

        print(
            "CSV saved:",
            path
        )

    except Exception as exc:

        print(
            "CSV save failed:",
            repr(exc)
        )


