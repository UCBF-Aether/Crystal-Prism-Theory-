def project_e8(v):

    denominator = math.sqrt(
        2.0 + PHI
    )

    return (
        (v[0] + PHI*v[4]) / denominator,
        (v[1] + PHI*v[5]) / denominator,
        (v[2] + PHI*v[6]) / denominator,
    )


def rounded_unique(points, digits=8):

    return sorted(
        set(
            (
                round(p[0], digits),
                round(p[1], digits),
                round(p[2], digits),
            )
            for p in points
        )
    )


def radial_shells(points, tolerance=1e-6):

    radii = sorted(
        vector_norm(p)
        for p in points
    )

    shells = []

    for r in radii:

        if not shells:

            shells.append([r])
            continue

        mean_r = safe_mean(
            shells[-1]
        )

        if abs(r - mean_r) <= tolerance:

            shells[-1].append(r)

        else:

            shells.append([r])

    return [
        (
            safe_mean(shell),
            len(shell)
        )
        for shell in shells
    ]


def run_geometry():

    roots = generate_e8_roots()

    projected = [
        project_e8(v)
        for v in roots
    ]

    unique = rounded_unique(
        projected,
        digits=8
    )

    nonzero = [
        p
        for p in unique
        if vector_norm(p) > 1e-10
    ]

    shells = radial_shells(
        unique
    )

    fcc_shells = [
        (r, n)
        for r, n in shells
        if n == 12
    ]

    # Difference lattice.
    differences = []

    for i in range(len(unique)):

        p = unique[i]

        for j in range(i + 1, len(unique)):

            q = unique[j]

            d = (
                round(p[0] - q[0], 8),
                round(p[1] - q[1], 8),
                round(p[2] - q[2], 8),
            )

            if vector_norm(d) > 1e-10:
                differences.append(d)

    difference_unique = list(
        set(differences)
    )

    difference_shells = radial_shells(
        difference_unique
    )

    difference_fcc = [
        (r, n)
        for r, n in difference_shells
        if n == 12
    ]

    return {
        "roots": roots,
        "root_count": len(roots),
        "root_norm_min":
            min(vector_norm2(r) for r in roots),
        "root_norm_max":
            max(vector_norm2(r) for r in roots),
        "projected": unique,
        "unique_projected_count":
            len(unique),
        "nonzero_projected_count":
            len(nonzero),
        "radial_shells": shells,
        "radial_shell_count":
            len(shells),
        "fcc_signature_shells":
            fcc_shells,
        "difference_shell_count":
            len(difference_shells),
        "difference_fcc_shells":
            difference_fcc,
    }


