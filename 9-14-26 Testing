# 13 — CORRECTED PAIR-POTENTIAL BRANCH
# =============================================================================

def solve_pair_branch(
    kappa,
    K_bare,
    f_s0,
    g_fcc
):

    # Correct algebra:
    #
    # C44 = kappa*K_bare/a^3
    #
    # m0 = C44*a^3/(4*c^2)
    #
    # hbar = f_s0*g*m0*c*a
    #
    # Therefore:
    #
    # a = 4*hbar*c/
    #     (f_s0*g*kappa*K_bare)

    a = (
        4.0
        * HBAR
        * C
        /
        (
            f_s0
            * g_fcc
            * kappa
            * K_bare
        )
    )

    C44 = (
        kappa
        * K_bare
        /
        a**3
    )

    rho = (
        C44
        /
        C**2
    )

    m0 = (
        rho
        * a**3
        /
        4.0
    )

    hbar_check = (
        f_s0
        * g_fcc
        * m0
        * C
        * a
    )

    G = (
        C**3
        /
        (
            OMEGA_G
            * C44
            * g_fcc
            * (1.0 - ETA_LOOP)
        )
    )

    return {
        "kappa": kappa,
        "a": a,
        "C44": C44,
        "C44_error_percent":
            pct_error(
                C44,
                C44_HISTORICAL
            ),
        "rho": rho,
        "m0": m0,
        "hbar_closure":
            hbar_check,
        "hbar_error_percent":
            pct_error(
                hbar_check,
                HBAR
            ),
        "G": G,
        "G_error_percent":
            pct_error(
                G,
                G_CODATA
            ),
    }


