def entanglement_branch():

    # Standard singlet correlation:
    #
    # E(a,b) = -cos(a-b)
    #
    # CHSH at optimal settings:
    #
    #     S = 2*sqrt(2)

    a = 0.0
    ap = math.pi/2.0

    b = math.pi/4.0
    bp = 3.0*math.pi/4.0

    E = lambda x, y: (
        -math.cos(x-y)
    )

    S = abs(
        E(a,b)
        -
        E(a,bp)
        +
        E(ap,b)
        +
        E(ap,bp)
    )

    # GHZ QFI branch:
    # F_Q = N^2 for an ideal N-qubit GHZ state.

    N_GHZ = 9

    F_Q = N_GHZ**2

    return {
        "CHSH":
            S,
        "CHSH_quantum_limit":
            2.0*math.sqrt(2.0),
        "GHZ_N":
            N_GHZ,
        "GHZ_QFI":
            F_Q,
        "classification":
            "standard quantum-information calculation with CPQR interpretation",
    }


