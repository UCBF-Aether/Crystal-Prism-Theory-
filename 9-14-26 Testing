def relativity_tests(
    G
):

    gamma_06c = (
        1.0
        /
        math.sqrt(
            1.0 - 0.6**2
        )
    )

    # GPS gravitational + kinematic scale.
    # This is a consistency calculation using standard GR,
    # not an independent CPQR derivation.

    M_EARTH = 5.97219e24
    R_EARTH = 6.371e6
    R_GPS = (
        6.371e6
        +
        20200e3
    )

    mu = G*M_EARTH

    # Simplified gravitational potential difference.
    dt_grav = (
        mu/C**2
        *
        (
            1.0/R_EARTH
            -
            1.0/R_GPS
        )
    )

    # Simplified orbital kinematic term.
    v_gps = math.sqrt(
        mu/R_GPS
    )

    dt_kin = (
        -0.5
        *
        v_gps**2
        /
        C**2
    )

    gps_fractional = (
        dt_grav
        +
        dt_kin
    )

    gps_us_day = (
        gps_fractional
        *
        86400.0
        *
        1e6
    )

    return {
        "gamma_0.6c":
            gamma_06c,
        "GPS_gravitational_fraction":
            dt_grav,
        "GPS_kinematic_fraction":
            dt_kin,
        "GPS_net_us_day":
            gps_us_day,
    }


