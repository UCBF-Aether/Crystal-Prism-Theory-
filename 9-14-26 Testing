def run_alpha():

    # Recovered recurrence:
    #
    # alpha^-1 =
    #     pi/4*(128 + D) - 1/2
    #
    # D_new =
    #     phi^8 + alpha^-1/1000

    D = PHI**8

    history = []

    for _ in range(100):

        alpha_inv = (
            math.pi/4.0
            *
            (128.0 + D)
            -
            0.5
        )

        D_new = (
            PHI**8
            +
            alpha_inv/1000.0
        )

        history.append(alpha_inv)

        if (
            abs(D_new - D)
            <
            1e-15
            *
            max(1.0, abs(D))
        ):

            D = D_new
            break

        D = D_new

    alpha_inv_iter = (
        math.pi/4.0
        *
        (128.0 + D)
        -
        0.5
    )

    numerator = (
        math.pi/4.0
        *
        (128.0 + PHI**8)
        -
        0.5
    )

    denominator = (
        1.0
        -
        math.pi/4000.0
    )

    alpha_inv_closed = (
        numerator
        /
        denominator
    )

    alpha = (
        1.0
        /
        alpha_inv_closed
    )

    kappa = (
        1.0
        -
        2.0*alpha
    )

    return {
        "alpha_inv_iterative":
            alpha_inv_iter,
        "alpha_inv_closed":
            alpha_inv_closed,
        "alpha_inv_observed":
            ALPHA_INV_OBSERVED,
        "alpha_inv_error_percent":
            pct_error(
                alpha_inv_closed,
                ALPHA_INV_OBSERVED
            ),
        "alpha": alpha,
        "kappa_alpha": kappa,
        "iterations":
            len(history),
        "history":
            history,
    }


