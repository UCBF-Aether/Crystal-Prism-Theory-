        name = galaxy["name"]

        if index == 1 or index % 10 == 0:

            print(
                f"  fitting "
                f"{index}/{total}: "
                f"{name}"
            )

        fixed = fit_galaxy(
            name,
            galaxy["R"],
            galaxy["Vobs"],
            galaxy["Verr"],
            galaxy["Vdisk"],
            galaxy["Vbulge"],
            galaxy["Vgas"],
            G,
            a0,
            a_base,
            Sigma_char,
            beta=VORTEX_BETA_FIXED,
            amplitude=VORTEX_ALPHA_FIXED,
            free_beta=False
        )

        if fixed is not None:
            fixed_results.append(
                fixed
            )

        # Free-beta branch is expensive.
        # It is included because the archive contains this historical branch.
        if HAVE_SCIPY:

            free = fit_galaxy(
                name,
                galaxy["R"],
                galaxy["Vobs"],
                galaxy["Verr"],
                galaxy["Vdisk"],
                galaxy["Vbulge"],
                galaxy["Vgas"],
                G,
                a0,
                a_base,
                Sigma_char,
                beta=VORTEX_BETA_FIXED,
                amplitude=VORTEX_ALPHA_FIXED,
                free_beta=True
            )

            if free is not None:
                free_results.append(
                    free
                )

    def summarize(results):

        residuals = [
            x["residual_percent"]
            for x in results
            if math.isfinite(
                x["residual_percent"]
            )
        ]

        high_quality = [
            x
            for x in results
            if (
                x["N_points"] >= 10
                and
                x["Vflat_km_s"] >= 20.0
            )
        ]

        high_residuals = [
            x["residual_percent"]
            for x in high_quality
            if math.isfinite(
                x["residual_percent"]
            )
        ]

        sorted_results = sorted(
            results,
            key=lambda x:
                x["residual_percent"]
        )

        return {
            "N":
                len(results),
            "mean_residual_percent":
                safe_mean(
                    residuals
                ),
            "median_residual_percent":
                safe_median(
                    residuals
                ),
            "std_residual_percent":
                (
                    statistics.stdev(
                        residuals
                    )
                    if len(residuals) > 1
                    else float("nan")
                ),
            "below_18_percent":
                sum(
                    r < 18.0
                    for r in residuals
                ),
            "high_quality_N":
                len(high_quality),
            "high_quality_mean":
                safe_mean(
                    high_residuals
                ),
            "high_quality_median":
                safe_median(
                    high_residuals
                ),
            "best_10":
                sorted_results[:10],
            "worst_10":
                sorted_results[-10:],
        }

    fixed_summary = summarize(
        fixed_results
    )

    free_summary = summarize(
        free_results
    )

    return {
        "status":
            "SUCCESS",
        "reason":
            acquisition["reason"],
        "N_total":
            total,
        "N_fitted":
            len(fixed_results),
        "fixed_beta":
            fixed_summary,
        "free_beta":
            free_summary,
        "galaxies":
            fixed_results,
        "galaxies_free_beta":
            free_results,
    }


