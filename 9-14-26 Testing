    if HAVE_NUMPY:

        R_m = np.asarray(
            R_m,
            dtype=float
        )

        return (
            amplitude
            * V_flat_m_s
            *
            (
                1.0
                -
                np.exp(
                    -(
                        R_m/r_t_m
                    )**beta
                )
            )
        )

    return [
        vortex_velocity_scalar(
            r,
            V_flat_m_s,
            r_t_m,
            beta,
            amplitude
        )
        for r in R_m
    ]


# =============================================================================
# 18 — BTFR
# =============================================================================

def btfr_velocity(
    M_baryon_kg,
    a0,
    G
):

    return (
        G
        * a0
        * M_baryon_kg
    )**0.25


def btfr_velocity_Msun(
    M_baryon_Msun,
    a0,
    G
):

    return (
        btfr_velocity(
            M_baryon_Msun*M_SUN,
            a0,
            G
        )
        /
        1000.0
    )


# =============================================================================
# 19 — BARYONIC MASS FROM ROTATION-CURVE COMPONENTS
# =============================================================================

def baryonic_velocity(
    V_gas,
    V_disk,
    V_bulge,
    ups_disk,
    ups_bulge
):

    if HAVE_NUMPY:

        return np.sqrt(
            np.maximum(
                V_gas**2
                +
                ups_disk
                * V_disk**2
                +
                ups_bulge
                * V_bulge**2,
                0.0
            )
        )

    result = []

    for gas, disk, bulge in zip(
        V_gas,
        V_disk,
        V_bulge
    ):

        value = (
            gas**2
            +
            ups_disk*disk**2
            +
            ups_bulge*bulge**2
        )

        result.append(
            math.sqrt(
                max(value, 0.0)
            )
        )

    return result


# =============================================================================
# 20 — BARYONIC MASS ESTIMATOR
# =============================================================================

def estimate_baryonic_mass(
    R_kpc,
    V_bar_km_s,
    G
):

    """
    Recovered source branch:

        M_bar =
        percentile_90(
            V_bar^2 * R / G_PC
        )

    with radius in pc-compatible units.

    G_PC is:
        G [pc (km/s)^2 / Msun]
    """

    G_PC = (
        G
        * M_SUN
        /
        (
            (PC/1000.0)
            * 1000.0**2
        )
    )

    # Simpler exact conversion:
    #
    # G = 4.30091e-3
    # pc (km/s)^2 / Msun
    #
    # but we calculate it from SI.

    if HAVE_NUMPY:

        R = np.asarray(
            R_kpc,
            dtype=float
        )

        V = np.asarray(
            V_bar_km_s,
            dtype=float
        )

        values = (
            V**2
            *
            R*1000.0
            /
            G_PC
        )

        values = values[
            np.isfinite(values)
            &
            (values > 0)
        ]

        if len(values) == 0:
            return float("nan")

        return float(
            np.percentile(
                values,
                90
            )
        )

    values = []

    for R, V in zip(
        R_kpc,
        V_bar_km_s
    ):

        value = (
            V**2
            *
            R*1000.0
            /
            G_PC
        )

        if (
            math.isfinite(value)
            and value > 0
        ):

            values.append(value)

    if not values:
        return float("nan")

    values.sort()

    index = (
        0.90
        *
        (len(values)-1)
    )

    lo = int(
        math.floor(index)
    )

    hi = int(
        math.ceil(index)
    )

    if lo == hi:
        return values[lo]

    frac = index - lo

    return (
        values[lo]
        +
        frac
        *
        (
            values[hi]
            -
            values[lo]
        )
    )


# =============================================================================
# 21 — SELF-CONSISTENT VORTEX SOLVER
# =============================================================================

def solve_vortex_model(
    R_kpc,
    V_gas,
    V_disk,
    V_bulge,
    ups_disk,
    ups_bulge,
    G,
    a0,
    a_base,
    Sigma_char,
    beta=0.5,
    amplitude=1.0
):

    if HAVE_NUMPY:

        R = np.asarray(
            R_kpc,
            dtype=float
        )

        Vgas = np.asarray(
            V_gas,
            dtype=float
        )

        Vdisk = np.asarray(
            V_disk,
            dtype=float
        )

        Vbulge = np.asarray(
            V_bulge,
            dtype=float
        )

        Vbar = np.sqrt(
            np.maximum(
                Vgas**2
                +
                ups_disk*Vdisk**2
                +
                ups_bulge*Vbulge**2,
                0.0
            )
        )

        Mbar_Msun = estimate_baryonic_mass(
            R,
            Vbar,
            G
        )

        if not math.isfinite(Mbar_Msun):
            return None

        Mbar_kg = (
            Mbar_Msun
            * M_SUN
        )

        Vflat = (
            btfr_velocity(
                Mbar_kg,
                a0,
                G
            )
        )

        # Convert R to metres.
        R_m = R * KPC

        # Initial acceleration.
        a_eff = a_base

        # Recovered self-consistent loop.
        for _ in range(50):

            r_t = (
                Vflat**2
                /
                a_eff
            )

            r_t_kpc = (
                r_t
                /
                KPC
            )

            # Interpolate Sigma from baryonic
            # velocity field.
            #
            # Sigma ~ Vbar²/(2*pi*G*R)
            #
            # in SI units.

            R_safe = np.maximum(
                R_m,
                1e-30
            )

            G_SI = G

            Sigma_profile = (
                (Vbar*1000.0)**2
                /
                (
                    2.0
                    * math.pi
                    * G_SI
                    * R_safe
                )
            )

            # Clamp transition radius into observed range.
            r_eval = min(
                max(
                    r_t_kpc,
                    float(R[0])
                ),
                float(R[-1])
            )

            Sigma = float(
                np.interp(
                    r_eval,
                    R,
                    Sigma_profile
                )
            )

            a_new = effective_acceleration(
                Sigma,
                a_base,
                Sigma_char
            )

            if abs(
                a_new - a_eff
            ) / max(
                abs(a_eff),
                1e-30
            ) < 1e-5:

                a_eff = a_new
                break

            a_eff = (
                0.7*a_eff
                +
                0.3*a_new
            )

        r_t = (
            Vflat**2
            /
            a_eff
        )

        Vvortex = vortex_velocity_array(
            R_m,
            Vflat,
            r_t,
            beta,
            amplitude
        )

        Vpred = np.sqrt(
            np.maximum(
                Vbar**2
                +
                Vvortex**2,
                0.0
            )
        )

        return {
            "V_bar": Vbar,
            "V_flat": Vflat,
            "Mbar_Msun":
                Mbar_Msun,
            "a_eff":
                a_eff,
            "r_t_kpc":
                r_t/KPC,
            "V_vortex":
                Vvortex,
            "V_pred":
                Vpred,
        }

    # -------------------------------------------------------------------------
    # Pure-Python fallback.
    # -------------------------------------------------------------------------

    Vbar = baryonic_velocity(
        V_gas,
        V_disk,
        V_bulge,
        ups_disk,
        ups_bulge
    )

    Mbar_Msun = estimate_baryonic_mass(
        R_kpc,
        Vbar,
        G
    )

    if not math.isfinite(Mbar_Msun):
        return None

    Vflat = btfr_velocity_Msun(
        Mbar_Msun,
        a0,
        G
    ) * 1000.0

    a_eff = a_base

    for _ in range(50):

        r_t = (
            Vflat**2
            /
            a_eff
        )

        r_t_kpc = (
            r_t
            /
            KPC
        )

        sigma_values = []

        for R, V in zip(
            R_kpc,
            Vbar
        ):

            R_m = max(
                R*KPC,
                1e-30
            )

            sigma_values.append(
                V**2*1e6
                /
                (
                    2.0
                    * math.pi
                    * G
                    * R_m
                )
            )

        r_eval = min(
            max(
                r_t_kpc,
                min(R_kpc)
            ),
            max(R_kpc)
        )

        Sigma = sigma_values[
            min(
                range(len(R_kpc)),
                key=lambda i:
                    abs(
                        R_kpc[i]
                        -
                        r_eval
                    )
            )
        ]

        a_new = effective_acceleration(
            Sigma,
            a_base,
            Sigma_char
        )

        if abs(
            a_new-a_eff
        )/max(
            abs(a_eff),
            1e-30
        ) < 1e-5:

            a_eff = a_new
            break

        a_eff = (
            0.7*a_eff
            +
            0.3*a_new
        )

    r_t = (
        Vflat**2
        /
        a_eff
    )

    Vvortex = [
        vortex_velocity_scalar(
            R*KPC,
            Vflat,
            r_t,
            beta,
            amplitude
        )
        for R in R_kpc
    ]

    Vpred = [
        math.sqrt(
            Vb**2
            +
            Vv**2
        )
        for Vb, Vv in zip(
            Vbar,
            Vvortex
        )
    ]

    return {
        "V_bar": Vbar,
        "V_flat":
            Vflat,
        "Mbar_Msun":
            Mbar_Msun,
        "a_eff":
            a_eff,
        "r_t_kpc":
            r_t/KPC,
        "V_vortex":
            Vvortex,
        "V_pred":
            Vpred,
    }


# =============================================================================
# 22 — ROTATION-CURVE RESIDUAL
# =============================================================================

def galaxy_residual(
    Vpred,
    Vobs
):

    if HAVE_NUMPY:

        pred = np.asarray(
            Vpred,
            dtype=float
        )

        obs = np.asarray(
            Vobs,
            dtype=float
        )

        mask = (
            np.isfinite(pred)
            &
            np.isfinite(obs)
            &
            (obs > 0)
        )

        if not np.any(mask):
            return float("nan")

        return float(
            np.median(
                np.abs(
                    pred[mask]
                    -
                    obs[mask]
                )
                /
                obs[mask]
            )
            *
            100.0
        )

    vals = []

    for p, o in zip(
        Vpred,
        Vobs
    ):

        if (
            math.isfinite(p)
            and math.isfinite(o)
            and o > 0
        ):

            vals.append(
                abs(p-o)/o*100.0
            )

    return safe_median(vals)


# =============================================================================
# 23 — SPARC QUALITY FILTER
# =============================================================================

def sparc_quality_filter(
    R,
    Vobs,
    Verr,
    Vdisk,
    Vbulge,
    Vgas
):

    if HAVE_NUMPY:

        R = np.asarray(
            R,
            dtype=float
        )

        Vobs = np.asarray(
            Vobs,
            dtype=float
        )

        Vdisk = np.asarray(
            Vdisk,
            dtype=float
        )

        Vbulge = np.asarray(
            Vbulge,
            dtype=float
        )

        Vgas = np.asarray(
            Vgas,
            dtype=float
        )

        Verr = np.asarray(
            Verr,
            dtype=float
        )

        mask = (
            np.isfinite(R)
            &
            np.isfinite(Vobs)
            &
            np.isfinite(Vdisk)
            &
            np.isfinite(Vgas)
            &
            np.isfinite(Vbulge)
            &
            (R > 0)
            &
            (Vobs > 0)
        )

        if np.any(
            np.isfinite(Verr)
        ):

            mask &= (
                ~np.isfinite(Verr)
                |
                (Verr/Vobs < 0.15)
            )

        if np.sum(mask) < 5:
            return None

        return (
            R[mask],
            Vobs[mask],
            Verr[mask],
            Vdisk[mask],
            Vbulge[mask],
            Vgas[mask],
        )

    # Pure Python.
    rows = []

    for row in zip(
        R,
        Vobs,
        Verr,
        Vdisk,
        Vbulge,
        Vgas
    ):

        r, vo, ve, vd, vb, vg = row

        if not (
            math.isfinite(r)
            and math.isfinite(vo)
            and math.isfinite(vd)
            and math.isfinite(vb)
            and math.isfinite(vg)
        ):
            continue

        if r <= 0 or vo <= 0:
            continue

        if (
            math.isfinite(ve)
            and ve/vo >= 0.15
        ):
            continue

        rows.append(row)

    if len(rows) < 5:
        return None

    return tuple(
        list(x)
        for x in zip(*rows)
    )


# =============================================================================
# 24 — FIT ONE GALAXY
# =============================================================================

def fit_galaxy(
    name,
    R,
    Vobs,
    Verr,
    Vdisk,
    Vbulge,
    Vgas,
    G,
    a0,
    a_base,
    Sigma_char,
    beta=0.5,
    amplitude=1.0,
    free_beta=False
):

    filtered = sparc_quality_filter(
        R,
        Vobs,
        Verr,
        Vdisk,
        Vbulge,
        Vgas
    )

    if filtered is None:
        return None

    (
        R,
        Vobs,
        Verr,
        Vdisk,
        Vbulge,
        Vgas
    ) = filtered

    # -------------------------------------------------------------------------
    # Objective function.
    #
    # Default:
    #   fit disk + bulge M/L.
    #
    # Fixed late vortex:
    #   alpha = 1
    #   beta = .5
    #
    # Historical/free-beta branch:
    #   beta is additionally optimized.
    # -------------------------------------------------------------------------

    if HAVE_NUMPY:

        R = np.asarray(R, dtype=float)
        Vobs = np.asarray(Vobs, dtype=float)
        Verr = np.asarray(Verr, dtype=float)
        Vdisk = np.asarray(Vdisk, dtype=float)
        Vbulge = np.asarray(Vbulge, dtype=float)
        Vgas = np.asarray(Vgas, dtype=float)

    if HAVE_SCIPY:

        if free_beta:

            x0 = [
                0.7,
                0.7,
                0.5
            ]

            bounds = [
                (0.01, 2.5),
                (0.01, 2.5),
                (0.10, 1.50)
            ]

        else:

            x0 = [
                0.7,
                0.7
            ]

            bounds = [
                (0.01, 2.5),
                (0.01, 2.5)
            ]

        def objective(x):

            ups_disk = x[0]
            ups_bulge = x[1]

            if free_beta:
                beta_local = x[2]
            else:
                beta_local = beta

            model = solve_vortex_model(
                R,
                Vgas,
                Vdisk,
                Vbulge,
                ups_disk,
                ups_bulge,
                G,
                a0,
                a_base,
                Sigma_char,
                beta_local,
                amplitude
            )

            if model is None:
                return 1e100

            pred = model["V_pred"]

            residual = (
                pred
                -
                Vobs
            )

            # Weighted chi-square where usable errors exist.
            valid_error = (
                np.isfinite(Verr)
                &
                (Verr > 0)
            )

            if np.any(valid_error):

                return float(
                    np.mean(
                        (
                            residual[valid_error]
                            /
                            Verr[valid_error]
                        )**2
                    )
                )

            return float(
                np.mean(
                    residual**2
                )
            )

        try:

            result = minimize(
                objective,
                x0=x0,
                bounds=bounds,
                method="L-BFGS-B"
            )

        except Exception:

            return None

        if not result.success:
            # Still accept finite optimizer results.
            if not np.all(
                np.isfinite(result.x)
            ):
                return None

        ups_disk = float(
            result.x[0]
        )

        ups_bulge = float(
            result.x[1]
        )

        beta_final = (
            float(result.x[2])
            if free_beta
            else beta
        )

    else:

        # No scipy:
        # use recovered historical central values.
        ups_disk = 0.7
        ups_bulge = 0.7
        beta_final = beta

    model = solve_vortex_model(
        R,
        Vgas,
        Vdisk,
        Vbulge,
        ups_disk,
        ups_bulge,
        G,
        a0,
        a_base,
        Sigma_char,
        beta_final,
        amplitude
    )

    if model is None:
        return None

    residual = galaxy_residual(
        model["V_pred"],
        Vobs
    )

    if HAVE_NUMPY:

        Vobs_mean = float(
            np.mean(Vobs)
        )

        max_radius = float(
            np.max(R)
        )

    else:

        Vobs_mean = safe_mean(
            Vobs
        )

        max_radius = max(R)

    return {
        "name": str(name),
        "N_points": int(
            len(R)
        ),
        "Rmax_kpc":
            max_radius,
        "ups_disk":
            ups_disk,
        "ups_bulge":
            ups_bulge,
        "beta":
            beta_final,
        "Mbar_Msun":
            model["Mbar_Msun"],
        "Vflat_km_s":
            model["V_flat"]/1000.0,
        "a_eff":
            model["a_eff"],
        "r_t_kpc":
            model["r_t_kpc"],
        "residual_percent":
            residual,
        "mean_observed_velocity_km_s":
            Vobs_mean,
        "optimizer_available":
            HAVE_SCIPY,
    }


# =============================================================================
# 25 — VIZIER / SPARC ACQUISITION
# =============================================================================

def acquire_sparc():

    """
    Recovered source catalog:
        J/AJ/152/157

    The original source branch uses Astroquery/VizieR.

    We search for a table containing:
        Name
        Rad
        Vobs
        Vdisk
        Vbul
        Vgas

    Different VizieR table releases can expose slightly different
    column naming. This routine therefore maps aliases.
    """

    if not HAVE_ASTROQUERY:

        return {
            "status":
                "UNAVAILABLE",
            "reason":
                "astroquery is not installed",
            "galaxies": [],
        }

    try:

        Vizier.ROW_LIMIT = -1

        catalogs = Vizier.get_catalogs(
            "J/AJ/152/157"
        )

        tables = list(
            catalogs
        )

        if not tables:

            return {
                "status":
                    "FAILED",
                "reason":
                    "No VizieR tables returned",
                "galaxies": [],
            }

        chosen = None

        for table in tables:

            columns = [
                str(c).lower()
                for c in table.colnames
            ]

            has_radius = any(
                c in columns
                for c in [
                    "rad",
                    "r",
                    "radius"
                ]
            )

            has_vobs = any(
                c in columns
                for c in [
                    "vobs",
                    "vobs_e",
                    "v"
                ]
            )

            if (
                has_radius
                and has_vobs
            ):

                chosen = table
                break

        if chosen is None:

            return {
                "status":
                    "FAILED",
                "reason":
                    "Rotation-curve table not identified",
                "galaxies": [],
            }

        df = chosen.to_pandas()

        def find_column(
            aliases,
            required=True
        ):

            lower = {
                str(c).lower(): c
                for c in df.columns
            }

            for alias in aliases:

                if alias.lower() in lower:
                    return lower[
                        alias.lower()
                    ]

            # Partial match.
            for lc, original in lower.items():

                for alias in aliases:

                    if alias.lower() in lc:
                        return original

            if required:
                raise KeyError(
                    "Missing columns: "
                    +
                    str(aliases)
                )

            return None

        name_col = find_column(
            [
                "name",
                "galaxy",
                "obj"
            ]
        )

        R_col = find_column(
            [
                "rad",
                "radius",
                "r"
            ]
        )

        Vobs_col = find_column(
            [
                "vobs"
            ]
        )

        Verr_col = find_column(
            [
                "verr",
                "vobs_e"
            ],
            required=False
        )

        Vdisk_col = find_column(
            [
                "vdisk",
                "v_disk"
            ],
            required=False
        )

        Vbulge_col = find_column(
            [
                "vbul",
                "vbulge",
                "v_bulge"
            ],
            required=False
        )

        Vgas_col = find_column(
            [
                "vgas",
                "v_gas"
            ],
            required=False
        )

        if Vdisk_col is None:
            raise KeyError(
                "Vdisk column unavailable"
            )

        if Vgas_col is None:
            raise KeyError(
                "Vgas column unavailable"
            )

        if Vbulge_col is None:
            # Zero bulge component if catalog does not expose one.
            df["_CPQR_Vbulge"] = 0.0
            Vbulge_col = "_CPQR_Vbulge"

        if Verr_col is None:
            df["_CPQR_Verr"] = np.nan
            Verr_col = "_CPQR_Verr"

        galaxies = []

        for name in df[name_col].dropna().unique():

            g = df[
                df[name_col] == name
            ]

            def numeric(col):
                return pd.to_numeric(
                    g[col],
                    errors="coerce"
                ).values

            R = numeric(R_col)
            Vobs = numeric(Vobs_col)
            Verr = numeric(Verr_col)
            Vdisk = numeric(Vdisk_col)
            Vbulge = numeric(Vbulge_col)
            Vgas = numeric(Vgas_col)

            galaxies.append(
                {
                    "name": str(name),
                    "R": R,
                    "Vobs": Vobs,
                    "Verr": Verr,
                    "Vdisk": Vdisk,
                    "Vbulge": Vbulge,
                    "Vgas": Vgas,
                }
            )

        return {
            "status":
                "SUCCESS",
            "reason":
                "SPARC acquired through VizieR",
            "table_columns":
                [str(c) for c in df.columns],
            "galaxies":
                galaxies,
        }

    except Exception as exc:

        return {
            "status":
                "FAILED",
            "reason":
                repr(exc),
            "galaxies": [],
        }


