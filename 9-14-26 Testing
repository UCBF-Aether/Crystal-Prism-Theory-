def generate_e8_roots():

    roots = []

    # 112 integer roots:
    #
    # permutations of
    #
    #     (±1, ±1, 0,0,0,0,0,0)

    for i in range(8):

        for j in range(i + 1, 8):

            for si in (-1.0, 1.0):

                for sj in (-1.0, 1.0):

                    x = [0.0] * 8

                    x[i] = si
                    x[j] = sj

                    roots.append(tuple(x))

    # 128 half-integer roots:
    #
    #     (±1/2,...,±1/2)
    #
    # with even number of minus signs.

    for mask in range(256):

        signs = []
        minus_count = 0

        for i in range(8):

            if mask & (1 << i):

                signs.append(-0.5)
                minus_count += 1

            else:

                signs.append(0.5)

        if minus_count % 2 == 0:

            roots.append(tuple(signs))

    return roots


def vector_norm(v):
    return math.sqrt(
        sum(x*x for x in v)
    )


def vector_norm2(v):
    return sum(
        x*x for x in v
    )


