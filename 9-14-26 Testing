def solve_working_C44(
    C44,
    f_s0,
    g_fcc
):

    # Here C44 is an independent working input.
    #
    #     a^4 =
    #     4*hbar*c/(f_s0*g*C44)

    a = (
        4.0
        * HBAR
        * C
        /
        (
            f_s0
            * g_fcc
            * C44
        )
    )**0.25

    rho = C44 / C**2

    m0 = (
        rho
        * a**3
        /
        4.0
    )

    hbar_check = (
        f_s0
        * g_fcc
        * m0
        * C
        * a
    )

    G = (
        C**3
        /
        (
            OMEGA_G
            * C44
            * g_fcc
            * (1.0 - ETA_LOOP)
        )
    )

    return {
        "C44": C44,
        "a": a,
        "rho": rho,
        "m0": m0,
        "hbar_closure":
            hbar_check,
        "hbar_error_percent":
