def vortex_velocity_scalar(
    R_m,
    V_flat_m_s,
    r_t_m,
    beta,
    amplitude=1.0
):

    if R_m <= 0:
        return 0.0

    if r_t_m <= 0:
        return 0.0

    return (
        amplitude
        * V_flat_m_s
        *
        (
            1.0
            -
            math.exp(
                -(
                    R_m/r_t_m
                )**beta
            )
        )
    )


