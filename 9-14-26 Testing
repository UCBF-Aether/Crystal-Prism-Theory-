def effective_acceleration(
    Sigma,
    a_base,
    Sigma_char
):

    if Sigma <= 0:
        return a_base

    if Sigma_char <= 0:
        return a_base

    return (
        a_base
        *
        math.sqrt(
            max(
                Sigma / Sigma_char,
                0.0
            )
        )
    )


