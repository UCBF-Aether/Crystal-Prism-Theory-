def run_c44_sum():

    mu = 21.0

    S = 0.0
    neighbors = 0

    for x in range(-4, 5):

        for y in range(-4, 5):

            for z in range(-4, 5):

                if (
                    x == 0
                    and y == 0
                    and z == 0
                ):
                    continue

                if (
                    (x + y + z) % 2
                    != 0
                ):
                    continue

                r2 = (
                    x*x
                    +
                    y*y
                    +
                    z*z
                )

                r = math.sqrt(r2)

                angular = (
                    (x*x + y*y)
                    /
                    r2
                )

                radial = (
                    2.0/r
                )**(
                    mu + 2.0
                )

                S += (
                    angular
                    * radial
                )

                neighbors += 1

    return {
        "S_C44": S,
        "neighbor_count":
            neighbors,
    }


