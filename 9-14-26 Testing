def run_cosmology(
    G,
    topology
):

    mu = topology["mu"]

    t_age = (
        T_AGE_GYR
        *
        SEC_PER_GYR
    )

    H0_SI = (
        (mu - 1.0)
        /
        mu
        /
        t_age
    )

    H0 = (
        H0_SI
        * MPC
        /
        1000.0
    )

    a0 = (
        C
        * H0_SI
        /
        (2.0*math.pi)
    )

    a_base = (
        2.0
        * a0
        /
        math.sqrt(3.0)
    )

    # Convert m/s² to (km/s)²/kpc.
    a_base_kpc = (
        a_base
        * KPC
        /
        1.0e6
    )

    sigma_SI = (
        a_base
        /
        (2.0*math.pi*G)
        *
        12.0
        /
        (mu + 12.0)
    )

    sigma = (
        sigma_SI
        * PC**2
        /
        M_SUN
    )

    sigma_cod = (
        a_base
        /
        (2.0*math.pi*G_CODATA)
        *
        12.0
        /
        (mu + 12.0)
        *
        PC**2
        /
        M_SUN
    )

    return {
        "age_Gyr": T_AGE_GYR,
        "H0_SI": H0_SI,
        "H0_km_s_Mpc": H0,
        "H0_difference":
            H0 - H0_HISTORICAL,
        "a0": a0,
        "a_base": a_base,
        "a_base_km2_s2_kpc":
            a_base_kpc,
        "Sigma_char":
            sigma,
        "Sigma_char_CODATA_G":
            sigma_cod,
    }


