def baryonic_mass(R, Vd_ml, Vb_ml, Vg):
    Vbar = np.sqrt(Vg ** 2 + Vd_ml ** 2 + Vb_ml ** 2)
    return max(float(np.percentile(Vbar ** 2 * R * KPC_TO_PC, 90) / G_PC), 1e-5)


def solve_a_eff(R, Sg, Vf, ab, Sc, mx=30, tol=1e-4):
    R = np.asarray(R, float)
    Sg = np.asarray(Sg, float)
    ae = float(ab)
    for _ in range(mx):
        rt = np.clip(Vf ** 2 / ae, R.min() * 1.01, R.max() * 0.99)
        St = np.interp(rt, R, Sg)
        ratio = np.clip(St / Sc, 0.01, 100.0)
        an = float(np.clip(ab * math.sqrt(ratio), 400.0, 12000.0))
        if abs(an - ae) / max(abs(ae), 1.0) < tol:
            return an, float(Vf ** 2 / an)
        ae = 0.7 * ae + 0.3 * an
    return float(ae), float(Vf ** 2 / ae)


def vortex_predict(R, Vd, Vb, Vg, ups):
    Vd_ml = Vd * math.sqrt(max(float(ups), 0.01))
    Vb_ml = Vb * math.sqrt(UPS_BULGE)
    Vg_a = np.abs(Vg)
    Vbar = np.sqrt(Vg_a ** 2 + Vd_ml ** 2 + Vb_ml ** 2)
    Mb = baryonic_mass(R, Vd_ml, Vb_ml, Vg_a)
    Vf = (a0 * G_ms * Mb * M_sun) ** 0.25 / 1000.0
    R_pc = R * KPC_TO_PC
    with np.errstate(divide="ignore", invalid="ignore"):
        Sig = np.where(R_pc > 1e-10, Vbar ** 2 / (2 * PI * G_PC * R_pc), 0.0)
    ae, rt = solve_a_eff(R, Sig, Vf, a_b, Sig_char)
    x = R / max(rt, 1e-6)
    Vv = Vf * (1.0 - np.exp(-(x ** beta_model)))
    return np.sqrt(Vbar ** 2 + Vv ** 2), Vf


