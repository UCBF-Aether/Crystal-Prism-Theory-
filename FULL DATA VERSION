class UCBFConstants:
    """
    UCBF V13 constants motivated by FCC lattice geometry.
    
    The STRUCTURE is inspired by E8 → FCC lattice projection.
    The PARAMETERS are matched to empirical values.
    This is exactly how the Standard Model works.
    """
    
    # Empirical inputs (measured from experiments/observations)
    G_SI = 6.6720e-11          # m³/kg/s² (Cavendish experiment)
    a0_0 = 1.0422e-10          # m/s² (from galaxy rotation curves)
    c = 2.99792458e8           # m/s (Maxwell's equations)
    H0 = 67.4                  # km/s/Mpc (cosmic distance ladder)
    
    # Lattice-motivated constants
    a0_base = 3700.0           # km²/s²/kpc (from C44/(ρ ξ_coh))
    Sigma_char = 50.0          # M☉/pc² (from m0 NT/(π ξ_coh²))
    vortex_alpha = 1.0         # From lattice symmetry
    vortex_beta = 0.5          # From vortex core profile
    
    # Astronomical conversions
    M_sun_kg = 1.989e30
    G_PC = 4.3009e-3
    kpc_to_pc = 1000.0
    keV_to_J = 1.60218e-16
    mu = 0.588
    mp = 1.6726e-27
    
    # Cosmological parameters
    Omega_m = 0.315
    Omega_Lambda = 0.685
    Omega_k = 0.0
    
    @staticmethod
    def H_z(z):
        """Hubble parameter at redshift z."""
        H0 = UCBFConstants.H0
        Om_m = UCBFConstants.Omega_m
        Om_L = UCBFConstants.Omega_Lambda
        Om_k = UCBFConstants.Omega_k
        return H0 * np.sqrt(Om_m * (1+z)**3 + Om_L + Om_k * (1+z)**2)
    
    @staticmethod
    def a0_z(z):
        """Redshift-dependent acceleration scale."""
        return UCBFConstants.a0_0 * (UCBFConstants.H_z(z) / UCBFConstants.H0)

C = UCBFConstants()

