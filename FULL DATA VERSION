# PART 6: FITTING FUNCTIONS
# ============================================================

def fit_galaxy(R, V_obs, V_err, V_disk, V_bul, V_gas, z=0, verbose=False):
    def objective(x):
        ups_disk, ups_bul = x
        try:
            result = vortex_predict(R, V_disk, V_bul, V_gas,
                                   ups_disk, ups_bul, z=z)
            V_pred = result['V_pred']
        except:
            return 1e10
        
        mask = (V_obs > 1.0) & (V_err > 0)
        if np.sum(mask) < 3:
            return 1e10
        
        errs = np.sqrt(V_err[mask]**2 + (0.05 * V_obs[mask])**2)
        chi2 = np.sum(((V_pred[mask] - V_obs[mask])**2) / (errs**2))
        return chi2 / len(mask)
    
    bounds = [(0.01, 2.5), (0.01, 2.5)]
    best_x = [0.5, 0.7]
    best_f = 1e10
    
    for start in [[0.5, 0.7], [0.3, 0.5], [1.0, 1.0], [0.8, 0.3]]:
        try:
            res = minimize(objective, start, method='L-BFGS-B', 
                          bounds=bounds, options={'maxiter': 100})
            if res.fun < best_f:
                best_f = res.fun
                best_x = res.x
        except:
            continue
    
    ups_disk, ups_bul = best_x
    
    ps = vortex_predict(R, V_disk, V_bul, V_gas, ups_disk, ups_bul, z=z)
    
    mask = V_obs > 1.0
    residuals = ps['V_pred'][mask] - V_obs[mask]
    pct_residuals = 100 * residuals / V_obs[mask]
    
    return {
        'ups_disk': ups_disk,
        'ups_bul': ups_bul,
        'ps': ps,
        'mean_abs_pct': np.mean(np.abs(pct_residuals)),
        'rms': np.sqrt(np.mean(residuals**2)),
        'redchi2': best_f,
        'n_pts': len(mask),
    }

def fit_all_sparc(galaxies, n_cores=None, verbose=True):
    results = {}
    n_total = len(galaxies)
    
    if verbose:
        print(f"\nFitting {n_total} SPARC galaxies...")
    
    for i, (name, gal) in enumerate(galaxies.items()):
        if verbose and (i+1) % 25 == 0:
            print(f"  {i+1}/{n_total} galaxies fitted...")
        
        try:
            result = fit_galaxy(
                gal['R_kpc'], gal['V_obs'], gal['V_err'],
                gal['V_disk'], gal['V_bul'], gal['V_gas_raw'],
                z=gal.get('z', 0)
            )
            results[name] = {
                'gal': gal,
                'result': result,
                'mean_abs_pct': result['mean_abs_pct'],
                'ups_disk': result['ups_disk'],
                'ups_bul': result['ups_bul'],
                'ps': result['ps'],
            }
        except Exception as e:
            if verbose:
                print(f"  Failed {name}: {e}")
    
    if verbose:
        print(f"✓ Complete: {len(results)} galaxies fitted")
    
    return results

