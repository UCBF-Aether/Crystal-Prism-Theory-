            'M31': 4.5,
        }
        return r_scales.get(gal_name, 2.0)
    
    @classmethod
    def apply_cuts(cls, gal):
        """Apply all Lelli & McGaugh quality cuts."""
        name = gal['name']
        R_kpc = gal['R_kpc']
        V_obs = gal['V_obs']
        V_err = gal['V_err']
        
        inclination = cls.get_inclination(name)
        r_scale = cls.get_r_scale(name)
        
        n_pts = len(R_kpc)
        if n_pts < cls.MIN_POINTS:
            return False, f"Only {n_pts} points (< {cls.MIN_POINTS})"
        
        if inclination < cls.MIN_INCLINATION:
            return False, f"Inclination {inclination:.1f}° < {cls.MIN_INCLINATION}°"
        if inclination > cls.MAX_INCLINATION:
            return False, f"Inclination {inclination:.1f}° > {cls.MAX_INCLINATION}°"
        
        r_max = R_kpc.max()
        if r_max / r_scale < cls.MIN_RMAX_RSCALE:
            return False, f"R_max/R_scale={r_max/r_scale:.1f} < {cls.MIN_RMAX_RSCALE}"
        
        max_err_ratio = np.max(V_err / V_obs)
        if max_err_ratio > cls.MAX_ERR_RATIO:
            return False, f"Max V_err/V={max_err_ratio:.2f} > {cls.MAX_ERR_RATIO}"
        
        return True, "Passed all Lelli & McGaugh quality cuts"

