    return neighbors[:12]

def generate_icosahedron_vertices():
    """Icosahedron vertices: (0, ±1, ±phi), (±1, ±phi, 0), (±phi, 0, ±1)"""
    verts = []
    for s1 in [-1, 1]:
        for s2 in [-1, 1]:
            verts.append((0, s1, s2*phi))
            verts.append((s1, s2*phi, 0))
            verts.append((s2*phi, 0, s1))
    return verts

def count_icosahedron_topology(verts):
    """Count edges and faces from vertex coordinates."""
    n = len(verts)
    all_edges = []
    for i in range(n):
        for j in range(i+1, n):
            d = np.sqrt(sum((verts[i][k] - verts[j][k])**2 for k in range(3)))
            all_edges.append((i, j, d))
    min_edge = min(e[2] for e in all_edges)
    edges = [(i,j) for i,j,d in all_edges if abs(d - min_edge) < 1e-10]
    
    faces = []
    for combo in combinations(range(n), 3):
        i, j, k = combo
        dij = np.sqrt(sum((verts[i][m] - verts[j][m])**2 for m in range(3)))
        dik = np.sqrt(sum((verts[i][m] - verts[k][m])**2 for m in range(3)))
        djk = np.sqrt(sum((verts[j][m] - verts[k][m])**2 for m in range(3)))
        if abs(dij - min_edge) < 1e-10 and abs(dik - min_edge) < 1e-10 and abs(djk - min_edge) < 1e-10:
            faces.append((i, j, k))
    
    return len(edges), len(faces)

