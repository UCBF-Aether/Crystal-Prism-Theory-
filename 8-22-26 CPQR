def fcc_lattice_sums(max_shell=6):
    """Compute FCC lattice sums by shell."""
    shells = []
    for x in range(-max_shell, max_shell+1):
        for y in range(-max_shell, max_shell+1):
            for z in range(-max_shell, max_shell+1):
                if (x + y + z) % 2 == 0 and not (x == 0 and y == 0 and z == 0):
                    r2 = x*x + y*y + z*z
                    shells.append(r2)
    
    shells.sort()
    unique_shells = []
    for r2 in shells:
        if not unique_shells or unique_shells[-1] != r2:
            unique_shells.append(r2)
    
    S2_sum = 0
    S4_sum = 0
    shell_info = []
    
    for r2 in unique_shells:
        count = shells.count(r2)
        r = np.sqrt(r2)
        S2_sum += count / r2
        S4_sum += count / r2**2
        shell_info.append((r, count))
    
    return S2_sum, S4_sum, shell_info

