def golden_from_pentagon():
    """
    In a regular pentagon, diagonal/side = phi.
    Law of cosines: d^2 = s^2 + s^2 - 2*s^2*cos(108 deg)
    cos(108 deg) = -cos(72 deg) = -(sqrt(5)-1)/4
