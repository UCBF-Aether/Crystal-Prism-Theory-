def derive_gravitational_time_dilation(M, r):
    """
    Derive gravitational time dilation from lattice compression.
    
    Mass M displaces the lattice, creating a strain field:
      ε(r) = GM / (c² r)
    
    The non-linear bulk modulus of the lattice is:
      Y(ε) = (1 - 2ε) / (1 - ε)
    
    The local density is:
      ρ(ε) = ρ₀ / (1 - ε)
    
    The local wave speed is:
      c(ε) = √(Y(ε) / ρ(ε)) = c₀ √(1 - 2ε)
    
    The clock rate is the ratio of local to background wave speed:
      dτ/dt = c(ε) / c₀ = √(1 - 2ε) = √(1 - 2GM/c²r)
    
    This is exactly the Schwarzschild time dilation, derived here
    from material physics without assuming spacetime curvature.
    
    Parameters
    ----------
    M : float
        Mass (kg)
    r : float
        Distance from center of mass (m)
    
    Returns
    -------
    dtau_dt : float
        Clock rate relative to distant observer
    """
    c = SupersolidLattice.c
    G = SupersolidLattice.G
    
    # Strain field from mass displacement
    epsilon = G * M / (c**2 * r)
    
    # Non-linear bulk modulus (stress-softening)
    Y = (1 - 2*epsilon) / (1 - epsilon)
    
    # Local density (material conservation)
    rho = 1.0 / (1 - epsilon)
    
    # Local wave speed
    c_local = np.sqrt(Y / rho)
    
    # Clock rate = ratio of local to background wave speed
    dtau_dt = c_local / 1.0  # c₀ normalized to 1
    
    return dtau_dt

