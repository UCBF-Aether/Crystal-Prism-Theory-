    ----------
    m : float
        Mass (kg)
    
    Returns
    -------
    E : float
        Rest energy (J)
    """
    c = SupersolidLattice.c
    
    # E = mc² — rest energy equals mass times lattice sound speed squared
    E = m * c**2
    
    return E

