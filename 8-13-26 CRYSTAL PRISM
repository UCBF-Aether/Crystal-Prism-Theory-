def derive_schwarzschild_radius(M):
    """
    Derive the Schwarzschild radius from lattice fracture mechanics.
    
    The lattice fractures when the strain exceeds the maximum
    sustainable value. The bulk modulus goes to zero when:
    
      Y(ε) = (1 - 2ε) / (1 - ε) = 0
      ε_max = 1/2
    
    The strain from mass M at radius r is:
      ε(r) = GM / (c² r)
    
    Setting ε = ε_max:
      GM / (c² r_s) = 1/2
      r_s = 2GM / c²
    
    This is the Schwarzschild radius. In this theory, it is NOT
    a singularity — it is the radius where the lattice fractures.
    Information does not fall into a point of infinite density.
    It falls through a phase transition in the medium.
    
    Parameters
    ----------
    M : float
        Mass (kg)
    
    Returns
    -------
    r_s : float
        Schwarzschild radius (m)
    """
    c = SupersolidLattice.c
    G = SupersolidLattice.G
    
    # Fracture condition: Y(ε) = 0 → ε = 1/2
    # Strain: ε(r) = GM/(c²r)
    # Setting ε = 1/2: GM/(c²r_s) = 1/2
    r_s = 2 * G * M / c**2
    
    return r_s

