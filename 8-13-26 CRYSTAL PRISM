def derive_lorentz_factor(v):
    """
    Derive the Lorentz factor from the lattice wave equation.
    
    The lattice displacement field φ obeys the wave equation:
      ∂²φ/∂t² = c² ∇²φ
    
    where c is the lattice sound speed. This equation must be invariant
    under transformations between inertial frames. Requiring invariance
    leads directly to the Lorentz transformation:
    
      t' = γ(t - vx/c²)
      x' = γ(x - vt)
    
    with γ = 1/√(1 - v²/c²).
    
    Parameters
    ----------
    v : float
        Velocity relative to the lattice (m/s)
    
    Returns
    -------
    gamma : float
        Lorentz factor
    """
    # The Lorentz factor emerges from requiring the wave equation
    # to be invariant under the transformation.
    gamma = 1.0 / np.sqrt(1.0 - v**2 / SupersolidLattice.c**2)
    return gamma

