def subdivide(verts, faces):
    new_verts = list(verts)
    new_faces = []
    cache = {}
    def mid(i, j):
        key = tuple(sorted([i, j]))
        if key not in cache:
            m = (verts[i] + verts[j]) / 2.0
            m = m / np.linalg.norm(m)
            new_verts.append(m)
            cache[key] = len(new_verts) - 1
        return cache[key]
    for face in faces:
        i, j, k = face
        a, b, c = mid(i,j), mid(j,k), mid(k,i)
        new_faces.append((i,a,c))
        new_faces.append((a,j,b))
        new_faces.append((c,b,k))
        new_faces.append((a,b,c))
    return new_verts, new_faces

