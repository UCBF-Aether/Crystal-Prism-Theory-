def validate_clusters():
    """Validate UCBF V13 on galaxy clusters."""
    keV_to_J = 1.60218e-16
    mu = 0.588
    mp = 1.6726e-27
    
    clusters = []
    for name, T_keV, M500, Mgas, fstar in VIKHILININ_CLUSTERS:
        M_bar = (Mgas + fstar * M500) * 1e14
        T_J = T_keV * keV_to_J
        sigma_obs = np.sqrt(T_J / (mu * mp)) / 1000.0
        M_bar_kg = M_bar * C.M_sun_kg
        sigma_pred = (C.a0_0 * C.G_SI * M_bar_kg) ** 0.25 / 1000.0
        clusters.append({
            'name': name,
            'source': 'Vikhlinin+2006',
            'M_bar': M_bar,
            'sigma_obs': sigma_obs,
            'sigma_pred': sigma_pred,
            'resid_pct': abs(sigma_pred - sigma_obs) / sigma_obs * 100,
        })
    
    for name, T_keV, M500, Mgas, fstar in CLASH_CLUSTERS:
        M_bar = (Mgas + fstar * M500) * 1e14
        T_J = T_keV * keV_to_J
        sigma_obs = np.sqrt(T_J / (mu * mp)) / 1000.0
        M_bar_kg = M_bar * C.M_sun_kg
        sigma_pred = (C.a0_0 * C.G_SI * M_bar_kg) ** 0.25 / 1000.0
        clusters.append({
            'name': name,
            'source': 'CLASH',
            'M_bar': M_bar,
            'sigma_obs': sigma_obs,
            'sigma_pred': sigma_pred,
            'resid_pct': abs(sigma_pred - sigma_obs) / sigma_obs * 100,
        })
    
    return clusters

