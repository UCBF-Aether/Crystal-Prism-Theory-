class UCBFConstantsV13:
    """Derived from FCC lattice with redshift evolution."""
    
    # Fundamental constants from lattice (z=0 values)
    G_SI = 6.6720e-11          # m³/kg/s²
    a0_0 = 1.0422e-10          # m/s² — z=0 value
    c = 2.99792458e8           # m/s
    
    # Lattice-derived galactic constants
    a0_base = 3700.0           # km²/s²/kpc
    Sigma_char = 50.0          # M☉/pc²
    
    # Vortex core physics
    vortex_alpha = 1.0
    vortex_beta = 0.5
    
    # Cosmological parameters (Planck 2018)
    H0 = 67.4
    Omega_m = 0.315
    Omega_Lambda = 0.685
    Omega_k = 0.0
    
    # Astronomical conversions
    M_sun_kg = 1.989e30
    G_PC = 4.3009e-3
    kpc_to_pc = 1000.0
    
    @staticmethod
    def H_z(z):
        """Hubble parameter at redshift z."""
        H0 = UCBFConstantsV13.H0
        Om_m = UCBFConstantsV13.Omega_m
        Om_L = UCBFConstantsV13.Omega_Lambda
        Om_k = UCBFConstantsV13.Omega_k
        return H0 * np.sqrt(Om_m * (1+z)**3 + Om_L + Om_k * (1+z)**2)
    
    @staticmethod
    def a0_z(z):
        """Redshift-dependent acceleration scale."""
        return UCBFConstantsV13.a0_0 * (UCBFConstantsV13.H_z(z) / UCBFConstantsV13.H0)

C = UCBFConstantsV13()

