def plot_jwst_overlay(result, data, save=True):
    """Plot UCBF V13 prediction overlaid on real JWST data."""
    gal_name = data['name']
    z = data['z']
    R = data['R_kpc']
    V_obs = data['V_obs']
    V_err = data['V_err']
    V_disk = data['V_disk']
    V_bul = data['V_bul']
    V_gas = data['V_gas_raw']
    source = data['source']
    
    ups_disk = result['ups_disk']
    ups_bul = result['ups_bul']
    ps = result['ps']
    
    fig, axes = plt.subplots(1, 2, figsize=(14, 6))
    
    # Plot 1: Rotation curve
    ax1 = axes[0]
    
    ax1.errorbar(R, V_obs, yerr=V_err, fmt='o', color='#1f77b4', 
                markersize=8, capsize=3, elinewidth=1.5, alpha=0.9,
                label=f'{gal_name} (JWST/NIRSpec)')
    
    R_smooth = np.linspace(0.01, max(R) * 1.05, 100)
    V_disk_int = interp1d(R, V_disk, kind='linear', fill_value='extrapolate')(R_smooth)
    V_bul_int = interp1d(R, V_bul, kind='linear', fill_value='extrapolate')(R_smooth)
    V_gas_int = interp1d(R, V_gas, kind='linear', fill_value='extrapolate')(R_smooth)
    
    ps_smooth = vortex_predict(R_smooth, V_disk_int, V_bul_int, V_gas_int,
                              ups_disk, ups_bul, z=z)
    
    ax1.plot(R_smooth, ps_smooth['V_pred'], 'r-', linewidth=2.5, 
            label='UCBF V13 Vortex')
    ax1.plot(R_smooth, ps_smooth['V_bar'], 'g--', linewidth=1.5, alpha=0.7,
            label='Baryonic')
    ax1.plot(R_smooth, ps_smooth['V_vortex'], 'm-.', linewidth=1.5, alpha=0.7,
            label='Vortex')
    
    # Transition radius (only if physically reasonable)
    r_trans = ps_smooth['r_transition']
    if r_trans < 5.0:
        ax1.axvline(r_trans, color='gray', linestyle=':', alpha=0.5,
                   label=f'r_t = {r_trans:.1f} kpc')
    
    ax1.set_xlabel('R (kpc)', fontsize=12)
    ax1.set_ylabel('V (km/s)', fontsize=12)
    ax1.set_title(f'{gal_name} (z={z:.2f})\n'
                 f'Res: {result["mean_abs_pct"]:.1f}% | '
                 f'ϒ_disk={ups_disk:.2f}, ϒ_bulge={ups_bul:.2f}\n'
                 f'a0(z)/a0(0) = {ps_smooth["Hz_H0"]:.2f}x', fontsize=11)
    
    # Dynamic y-limits based on actual data
    max_v_data = np.max(V_obs)
    max_v_model = np.max(ps_smooth['V_pred'])
    y_max = max(max_v_data, max_v_model) * 1.3
    y_max = min(y_max, 500)
    ax1.set_ylim(0, y_max)
    ax1.set_xlim(0, max(R) * 1.2)
    ax1.legend(loc='lower right', fontsize=9)
    ax1.grid(True, alpha=0.25)
    
    # Plot 2: Residuals
    ax2 = axes[1]
    
    ps_at_obs = vortex_predict(R, V_disk, V_bul, V_gas, ups_disk, ups_bul, z=z)
    residuals = ps_at_obs['V_pred'] - V_obs
    
    ax2.errorbar(R, residuals, yerr=V_err, fmt='o', color='#1f77b4',
                markersize=8, capsize=3, elinewidth=1.5, alpha=0.9)
    ax2.axhline(0, color='black', linestyle='-', linewidth=1)
    ax2.axhline(np.mean(residuals), color='red', linestyle='--', alpha=0.7,
               label=f'Mean: {np.mean(residuals):.1f} km/s')
    
    v_flat = ps_smooth['V_flat']
    ax2.axhspan(-v_flat*0.05, v_flat*0.05, alpha=0.1, color='green')
    
    max_res = np.max(np.abs(residuals))
    ax2.set_ylim(-max_res * 1.5, max_res * 1.5)
    
    ax2.set_xlabel('R (kpc)', fontsize=12)
    ax2.set_ylabel('Residual (km/s)', fontsize=12)
    ax2.set_title(f'Residuals | RMS = {result["rms"]:.1f} km/s\n'
                 f'χ²ᵣ = {result["redchi2"]:.2f}', fontsize=11)
    ax2.legend(loc='lower right', fontsize=9)
    ax2.grid(True, alpha=0.25)
    
    plt.suptitle(f'UCBF V13 — {gal_name} JWST Comparison\n'
                f'Source: {source}', 
                fontsize=14, fontweight='bold')
    plt.tight_layout()
    
    if save:
        plt.savefig(f'UCBF_V13_{gal_name}_JWST_Overlay.png', dpi=200, bbox_inches='tight')
        print(f"✓ Saved: UCBF_V13_{gal_name}_JWST_Overlay.png")
    
    plt.show()

def plot_all_jwst_comparison(results_dict, save=True):
    """Plot all JWST comparisons in a grid."""
    n_galaxies = len(results_dict)
    n_cols = min(3, n_galaxies)
    n_rows = (n_galaxies + n_cols - 1) // n_cols
    
    fig, axes = plt.subplots(n_rows, n_cols, figsize=(5*n_cols, 5*n_rows))
    if n_galaxies == 1:
        axes = np.array([axes])
    axes = axes.flatten()
    
    for idx, (name, result) in enumerate(results_dict.items()):
        ax = axes[idx]
        data = result['data']
        
        R = data['R_kpc']
        V_obs = data['V_obs']
        V_err = data['V_err']
        z = data['z']
        ups_disk = result['ups_disk']
        ups_bul = result['ups_bul']
        
        ax.errorbar(R, V_obs, yerr=V_err, fmt='o', color='#1f77b4',
                   markersize=5, capsize=1.5, elinewidth=1, alpha=0.8)
        
        R_smooth = np.linspace(0.01, max(R) * 1.05, 50)
        V_disk_int = interp1d(R, data['V_disk'], kind='linear', 
                            fill_value='extrapolate')(R_smooth)
        V_bul_int = interp1d(R, data['V_bul'], kind='linear', 
                           fill_value='extrapolate')(R_smooth)
        V_gas_int = interp1d(R, data['V_gas_raw'], kind='linear', 
                           fill_value='extrapolate')(R_smooth)
        
        ps_smooth = vortex_predict(R_smooth, V_disk_int, V_bul_int, V_gas_int,
                                  ups_disk, ups_bul, z=z)
        ax.plot(R_smooth, ps_smooth['V_pred'], 'r-', linewidth=2)
        
        max_v_data = np.max(V_obs)
        max_v_model = np.max(ps_smooth['V_pred'])
        y_max = max(max_v_data, max_v_model) * 1.3
        y_max = min(y_max, 500)
        ax.set_ylim(0, y_max)
        ax.set_xlim(0, max(R) * 1.2)
        
        ax.set_title(f"{name}\nz={z:.2f} | Res={result['mean_abs_pct']:.1f}%",
                    fontsize=9)
        ax.set_xlabel('R (kpc)', fontsize=8)
        ax.set_ylabel('V (km/s)', fontsize=8)
        ax.grid(True, alpha=0.25)
    
    for idx in range(n_galaxies, len(axes)):
        axes[idx].set_visible(False)
    
    plt.suptitle('UCBF V13 — JWST High-Redshift Galaxy Comparisons\n'
                'Red: UCBF V13 prediction | Blue: JWST/NIRSpec observations',
                fontsize=14, fontweight='bold')
    plt.tight_layout()
    
    if save:
        plt.savefig('UCBF_V13_All_JWST_Comparisons.png', dpi=200, bbox_inches='tight')
        print("✓ Saved: UCBF_V13_All_JWST_Comparisons.png")
    
    plt.show()

def plot_cosmic_validation(results_dict, save=True):
    """Plot the cosmic evolution validation."""
    fig, axes = plt.subplots(1, 2, figsize=(14, 6))
    
    # Plot 1: Residuals vs redshift
    ax1 = axes[0]
    z_data = [r['data']['z'] for r in results_dict.values()]
    residuals = [r['mean_abs_pct'] for r in results_dict.values()]
    names = list(results_dict.keys())
    
    colors = ['green' if r < 5 else 'orange' if r < 10 else 'red' for r in residuals]
    ax1.scatter(z_data, residuals, c=colors, s=100, edgecolors='black', linewidth=1.5)
    
    for z, res, name in zip(z_data, residuals, names):
        ax1.annotate(name, (z, res), xytext=(5, 5), textcoords='offset points', 
                    fontsize=8, ha='left', va='bottom')
    
    ax1.axhline(5, color='green', linestyle='--', alpha=0.5, label='5% threshold')
    ax1.axhline(10, color='orange', linestyle='--', alpha=0.5, label='10% threshold')
    ax1.set_xlabel('Redshift z', fontsize=12)
    ax1.set_ylabel('Mean Absolute Residual (%)', fontsize=12)
    ax1.set_title('UCBF V13 Performance vs Redshift\n'
                 f'Mean: {np.mean(residuals):.1f}% | Median: {np.median(residuals):.1f}%',
                 fontsize=11)
    ax1.legend()
    ax1.grid(True, alpha=0.3)
    
    # Plot 2: a0 scaling
    ax2 = axes[1]
    z_range = np.linspace(0, 15, 100)
    a0_ratio = C.a0_z(z_range) / C.a0_0
    
    ax2.plot(z_range, a0_ratio, 'k--', linewidth=2, 
            label='Predicted: a0(z)/a0(0) = H(z)/H0')
    
    a0_ratios = [r['ps']['Hz_H0'] for r in results_dict.values()]
    ax2.scatter(z_data, a0_ratios, c=colors, s=100, edgecolors='black', linewidth=1.5)
    
    ax2.set_xlabel('Redshift z', fontsize=12)
    ax2.set_ylabel('a0(z) / a0(0) = H(z)/H0', fontsize=12)
    ax2.set_title('Cosmic Evolution of Acceleration Scale\n'
                 f'Scaling factor: {min(a0_ratios):.2f}x - {max(a0_ratios):.2f}x',
                 fontsize=11)
    ax2.legend()
    ax2.grid(True, alpha=0.3)
    
    plt.suptitle('UCBF V13 Validated Across Cosmic Time\n'
                'From z=0 to z=14.3 with Zero Dark Matter',
                fontsize=14, fontweight='bold')
    plt.tight_layout()
    
    if save:
        plt.savefig('UCBF_V13_Cosmic_Validation.png', dpi=200, bbox_inches='tight')
        print("✓ Saved: UCBF_V13_Cosmic_Validation.png")
    
    plt.show()

