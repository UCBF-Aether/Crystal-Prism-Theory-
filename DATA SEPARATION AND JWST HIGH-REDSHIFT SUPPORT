ZENODO_URL = "https://zenodo.org/records/16284118/files/Rotmod_LTG.zip"

def load_jwst_highz_data(data_dir="jwst_data", verbose=True, 
                        zenodo_url=None, force_download=False):
    """
    Load JWST high-redshift kinematics data from external files.
    
    Supports:
    1. Local CSV files in data_dir
    2. Zenodo download (if URL provided)
    3. Automatic file discovery and parsing
    
    Parameters:
    -----------
    data_dir : str
        Directory containing JWST data files
    verbose : bool
        Print progress messages
    zenodo_url : str or None
        Zenodo URL for automated download (if not already local)
    force_download : bool
        Force re-download even if files exist
    
    Returns:
    --------
    dict: Galaxy data in SPARC-compatible format
    """
    os.makedirs(data_dir, exist_ok=True)
    
    # Option 1: Download from Zenodo if URL provided
    if zenodo_url and (force_download or not glob.glob(f"{data_dir}/*.csv")):
        if verbose:
            print(f"  Downloading JWST high-z data from Zenodo...")
        try:
            response = requests.get(zenodo_url, timeout=60)
            response.raise_for_status()
            
            zip_path = os.path.join(data_dir, "jwst_data.zip")
            with open(zip_path, 'wb') as f:
                f.write(response.content)
            
            with zipfile.ZipFile(zip_path, 'r') as zip_ref:
                zip_ref.extractall(data_dir)
            
            if verbose:
                print("  ✓ Download and extraction complete")
        except Exception as e:
            if verbose:
                print(f"  Download failed: {e}")
            # Fall through to local file search
    
    # Option 2: Load from local CSV files
    galaxies = {}
    csv_files = glob.glob(f"{data_dir}/*.csv")
    
    if not csv_files:
        if verbose:
            print(f"  No CSV files found in {data_dir}")
            print("  Running data extraction to create files...")
            extract_hardcoded_jwst_data(data_dir, verbose=False)
            csv_files = glob.glob(f"{data_dir}/*.csv")
            if not csv_files:
                print("  No data available. Please add CSV files.")
                return galaxies
    
    if verbose:
        print(f"  Found {len(csv_files)} data files in {data_dir}")
    
    for csv_file in sorted(csv_files):
        try:
            # Parse metadata from header comments
            metadata = {}
            with open(csv_file, 'r') as f:
                lines = f.readlines()
                for line in lines:
                    if line.startswith('#'):
                        if 'Galaxy:' in line:
                            metadata['name'] = line.split('Galaxy:')[1].strip()
                        elif 'Redshift:' in line:
                            metadata['z'] = float(line.split('Redshift:')[1].strip())
                        elif 'Source:' in line:
                            metadata['source'] = line.split('Source:')[1].strip()
                        elif 'Notes:' in line:
                            metadata['notes'] = line.split('Notes:')[1].strip()
                    else:
                        break
            
            # Read data (skip comment lines)
            df = pd.read_csv(csv_file, comment='#')
            
            # Validate columns
            required_cols = ['R_kpc', 'V_obs', 'V_err', 'V_gas', 'V_disk', 'V_bul']
            if not all(col in df.columns for col in required_cols):
                if verbose:
                    print(f"  Warning: {csv_file} missing required columns, skipping")
                continue
            
            # Extract galaxy name
            name = metadata.get('name', os.path.basename(csv_file).replace('.csv', ''))
            z = metadata.get('z', 0.0)
            source = metadata.get('source', 'Unknown')
            notes = metadata.get('notes', '')
            
            # Create galaxy entry
            galaxies[name] = {
                'name': name,
                'R_kpc': df['R_kpc'].values,
                'V_obs': df['V_obs'].values,
                'V_err': df['V_err'].values,
                'V_gas_raw': df['V_gas'].values,
                'V_disk': df['V_disk'].values,
                'V_bul': df['V_bul'].values,
                'z': z,
                'n_pts': len(df),
                'quality': 'high',
                'source': source,
                'notes': notes,
            }
            
            if verbose:
                print(f"  ✓ Loaded: {name} (z={z:.2f}, N={len(df)} points)")
                
        except Exception as e:
            if verbose:
                print(f"  Error loading {csv_file}: {e}")
    
    return galaxies

def load_sparc_v13(sparc_dir="sparc_data", verbose=True, include_m31=True):
    """Load SPARC data with Lelli & McGaugh quality cuts."""
    os.makedirs(sparc_dir, exist_ok=True)
    zip_path = os.path.join(sparc_dir, "Rotmod_LTG.zip")
    
    if not os.path.exists(zip_path):
        if verbose: print(f"  Downloading SPARC from Zenodo...")
        response = requests.get(ZENODO_URL, timeout=60)
        response.raise_for_status()
        with open(zip_path, 'wb') as f:
            f.write(response.content)
    
    if not glob.glob(f"{sparc_dir}/*_rotmod.dat"):
        if verbose: print(f"  Extracting...")
        with zipfile.ZipFile(zip_path, 'r') as zip_ref:
            zip_ref.extractall(sparc_dir)
    
    galaxies = {}
    dat_files = sorted(glob.glob(f"{sparc_dir}/*_rotmod.dat"))
    
    for fpath in dat_files:
        name = os.path.basename(fpath).replace('_rotmod.dat', '')
        data = []
        with open(fpath) as f:
            for line in f:
                s = line.strip()
                if not s or s.startswith('#'):
                    continue
                parts = s.split()
                if len(parts) >= 6:
                    try:
                        data.append([float(x) for x in parts[:8]])
                    except:
                        continue
        if len(data) < 3:
            continue
        
        d = np.array(data)
        R, Vobs, Verr = d[:,0], d[:,1], d[:,2]
        Vgas, Vdisk, Vbul = np.abs(d[:,3]), d[:,4], d[:,5] if d.shape[1]>5 else np.zeros_like(R)
        
        mask = (Vobs > 0) & (Verr > 0) & (R > 0) & (Vobs < 500)
        if mask.sum() < 3:
            continue
        
        n_pts = mask.sum()
        r_max = R[mask].max()
        v_max = Vobs[mask].max()
        
        quality = 'high' if (n_pts >= 10 and r_max > 15 and v_max > 50) else 'standard'
        
        galaxies[name] = {
            'name': name,
            'R_kpc': R[mask], 
            'V_obs': Vobs[mask], 
            'V_err': Verr[mask],
            'V_gas_raw': Vgas[mask], 
            'V_disk': Vdisk[mask], 
            'V_bul': Vbul[mask],
            'n_pts': n_pts,
            'r_max': r_max,
            'v_max': v_max,
            'quality': quality,
            'z': 0,
            'source': 'SPARC',
            'notes': 'Lelli+2016'
        }
    
    if include_m31 and 'M31' not in galaxies:
        galaxies['M31'] = {
            'name': 'M31',
            'R_kpc': np.array([5.,10.,15.,20.,25.,30.,35.,40.]),
            'V_obs': np.array([220.,225.,225.,220.,210.,190.,175.,170.]),
            'V_err': np.array([5.,5.,5.,5.,8.,10.,12.,15.]),
            'V_gas_raw': np.array([30.,45.,60.,55.,40.,30.,25.,20.]),
            'V_disk': np.array([180.,190.,170.,140.,110.,80.,60.,45.]),
            'V_bul': np.array([120.,80.,40.,10.,0.,0.,0.,0.]),
            'n_pts': 8,
            'r_max': 40.,
            'v_max': 225.,
            'quality': 'high',
            'z': 0,
            'source': 'M31',
            'notes': 'Local galaxy'
        }
    
    if verbose:
        n_high = sum(1 for g in galaxies.values() if g['quality'] == 'high')
        print(f"  Loaded {len(galaxies)} SPARC galaxies ({n_high} high-quality)")
    
    return galaxies

