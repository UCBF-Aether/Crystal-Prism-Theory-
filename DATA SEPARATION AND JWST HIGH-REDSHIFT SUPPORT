def compute_photometric_mass(R_kpc, V_disk_ml, V_bul_ml, V_gas, method='percentile'):
    """Compute baryonic mass using robust statistics."""
    V_bar = np.sqrt(V_disk_ml**2 + V_bul_ml**2 + V_gas**2)
    R_pc = R_kpc * C.kpc_to_pc
    integrand = V_bar**2 * R_pc
    
    if method == 'percentile':
        M_bar = np.percentile(integrand, 90) / C.G_PC
    elif method == 'integral':
        integral = np.trapz(integrand, R_pc)
        M_bar = integral / C.G_PC / R_pc[-1]
    else:
        M_bar = np.max(integrand) / C.G_PC
    
    return max(M_bar, 1e-5)

def compute_a0_eff_z(R_kpc, S_bar, V_flat, z=0, max_iter=20, tol=1e-4):
    """Self-consistent a0_eff with redshift evolution."""
    R_kpc = np.asarray(R_kpc, dtype=float)
    S_bar = np.asarray(S_bar, dtype=float)
    
    a0_base_z = C.a0_base * (C.H_z(z) / C.H0)
    a0_eff = a0_base_z
    
    for iteration in range(max_iter):
        r_transition = V_flat**2 / a0_eff
        r_transition = np.clip(r_transition, R_kpc.min()*1.01, R_kpc.max()*0.99)
        Sigma_transition = np.interp(r_transition, R_kpc, S_bar)
        Sigma_ratio = np.clip(Sigma_transition / C.Sigma_char, 0.01, 100.0)
        a0_new = a0_base_z * np.sqrt(Sigma_ratio)
        a0_new = np.clip(a0_new, 400 * (C.H_z(z)/C.H0), 12000 * (C.H_z(z)/C.H0))
        
        if abs(a0_new - a0_eff) / a0_eff < tol:
            return a0_new, iteration
        
        a0_eff = 0.7 * a0_eff + 0.3 * a0_new
    
    return a0_eff, max_iter

def vortex_predict(R_kpc, V_disk_raw, V_bul_raw, V_gas_raw,
                   ups_disk, ups_bul, z=0, V_flat=None, method='percentile'):
    """UCBF V13 Vortex Equation with redshift evolution."""
    R_kpc = np.asarray(R_kpc, dtype=float)
    
    # Ensure consistent length
    n_R = len(R_kpc)
    if len(V_disk_raw) != n_R:
        R_orig = np.linspace(R_kpc.min(), R_kpc.max(), len(V_disk_raw))
        V_disk_int = interp1d(R_orig, V_disk_raw, kind='linear', 
                            fill_value='extrapolate')(R_kpc)
        V_bul_int = interp1d(R_orig, V_bul_raw, kind='linear', 
                           fill_value='extrapolate')(R_kpc)
        V_gas_int = interp1d(R_orig, V_gas_raw, kind='linear', 
                           fill_value='extrapolate')(R_kpc)
    else:
        V_disk_int = V_disk_raw
        V_bul_int = V_bul_raw
        V_gas_int = V_gas_raw
    
    # Apply M/L ratios
    V_disk_ml = V_disk_int * np.sqrt(max(ups_disk, 0.01))
    V_bul_ml = V_bul_int * np.sqrt(max(ups_bul, 0.01))
    
    # Baryonic velocity
    V_bar = np.sqrt(V_gas_int**2 + V_disk_ml**2 + V_bul_ml**2)
    
    # Baryonic mass
    M_bar = compute_photometric_mass(R_kpc, V_disk_ml, V_bul_ml, V_gas_int, method=method)
    
    # Flat rotation velocity (BTFR with redshift-dependent a0)
    if V_flat is None:
        M_bar_kg = M_bar * C.M_sun_kg
        a0_z = C.a0_z(z)
        V_flat = (a0_z * C.G_SI * M_bar_kg) ** 0.25 / 1000.0
    
    # Surface densities
    R_pc = R_kpc * C.kpc_to_pc
    eps = 1e-10
    Sigma_gas = np.where(R_pc > eps, V_gas_int**2 / (2*np.pi*C.G_PC*R_pc), 0)
    Sigma_disk = np.where(R_pc > eps, V_disk_ml**2 / (2*np.pi*C.G_PC*R_pc), 0)
    Sigma_bul = np.where(R_pc > eps, V_bul_ml**2 / (2*np.pi*C.G_PC*R_pc), 0)
    Sigma_bar = Sigma_gas + Sigma_disk + Sigma_bul
    
    # Self-consistent a0_eff with redshift evolution
    a0_eff, n_iter = compute_a0_eff_z(R_kpc, Sigma_bar, V_flat, z=z)
    
    # Vortex profile
    r_transition = V_flat**2 / a0_eff
    x = R_kpc / r_transition
    vortex_profile = C.vortex_alpha * (1.0 - np.exp(-x**C.vortex_beta))
    V_vortex = V_flat * vortex_profile
    
    V_pred = np.sqrt(V_bar**2 + V_vortex**2)
    
    return {
        'V_pred': V_pred,
        'V_bar': V_bar,
        'V_vortex': V_vortex,
        'V_flat': V_flat,
        'M_bar': M_bar,
        'a0_eff': a0_eff,
        'r_transition': r_transition,
        'Sigma_bar': Sigma_bar,
        'Sigma_transition': np.interp(r_transition, R_kpc, Sigma_bar),
        'n_iter': n_iter,
        'ups_disk': ups_disk,
        'ups_bul': ups_bul,
        'z': z,
        'a0_z': C.a0_z(z),
        'Hz': C.H_z(z),
        'Hz_H0': C.H_z(z) / C.H0,
    }

# ============================================================
# FITTING FUNCTIONS
# ============================================================

def fit_galaxy(R, V_obs, V_err, V_disk, V_bul, V_gas, z=0, verbose=False):
    """Fit UCBF V13 to a galaxy."""
    def objective(x):
        ups_disk, ups_bul = x
        try:
            result = vortex_predict(R, V_disk, V_bul, V_gas,
                                   ups_disk, ups_bul, z=z)
            V_pred = result['V_pred']
        except:
            return 1e10
        
        mask = (V_obs > 1.0) & (V_err > 0)
        if np.sum(mask) < 3:
            return 1e10
        
        errs = np.sqrt(V_err[mask]**2 + (0.05 * V_obs[mask])**2)
        chi2 = np.sum(((V_pred[mask] - V_obs[mask])**2) / (errs**2))
        return chi2 / len(mask)
    
    bounds = [(0.01, 2.5), (0.01, 2.5)]
    best_x = [0.5, 0.7]
    best_f = 1e10
    
    for start in [[0.5, 0.7], [0.3, 0.5], [1.0, 1.0], [0.8, 0.3]]:
        try:
            res = minimize(objective, start, method='L-BFGS-B', 
                          bounds=bounds, options={'maxiter': 100})
            if res.fun < best_f:
                best_f = res.fun
                best_x = res.x
        except:
            continue
    
    ups_disk, ups_bul = best_x
    
    # Final prediction
    ps = vortex_predict(R, V_disk, V_bul, V_gas, ups_disk, ups_bul, z=z)
    
    # Compute residuals
    mask = V_obs > 1.0
    residuals = ps['V_pred'][mask] - V_obs[mask]
    pct_residuals = 100 * residuals / V_obs[mask]
    
    return {
        'ups_disk': ups_disk,
        'ups_bul': ups_bul,
        'ps': ps,
        'mean_abs_pct': np.mean(np.abs(pct_residuals)),
        'rms': np.sqrt(np.mean(residuals**2)),
        'redchi2': best_f,
        'n_pts': len(mask),
    }

