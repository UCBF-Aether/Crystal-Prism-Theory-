def pair_potential(u):
    """U(u) = u² - (2-u)ln(2-u) + 2 - 3u"""
    if u >= 2 or u <= 0:
        return np.inf
    return u**2 - (2-u)*np.log(2-u) + 2 - 3*u

def bulk_modulus_Y(epsilon):
    """Y(ε)/Y₀ = (1-2ε)/(1-ε) — exact analytical."""
    u = 1 + epsilon
    if u >= 2:
        return np.inf
    return 2 - 1/(2-u)

