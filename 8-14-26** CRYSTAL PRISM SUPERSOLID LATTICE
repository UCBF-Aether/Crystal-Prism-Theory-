# ============================================================================
# SECTION 1: DERIVE β FROM GP EQUATION
# ============================================================================

def derive_beta(N=128, L=25.0, V0=1.5, n_steps=300):
    """Derive β from GP equation with lattice potential using imaginary time."""
    x = np.linspace(-L/2, L/2, N)
    y = np.linspace(-L/2, L/2, N)
    X, Y = np.meshgrid(x, y)
    dx = L / N
    
    mu, g = 1.0, 1.0
    k = 2.0 * np.pi / 2.0
    V = V0 * (np.cos(k*X) + np.cos(k*Y))
    
    r = np.sqrt(X**2 + Y**2)
    theta = np.arctan2(Y, X)
    psi = np.tanh(r) * np.exp(1j * theta)
    psi[r < 0.1] = (r[r < 0.1] / 0.1) * np.exp(1j * theta[r < 0.1])
    
    kx = 2 * np.pi * fftfreq(N, dx)
    ky = 2 * np.pi * fftfreq(N, dx)
    KX, KY = np.meshgrid(kx, ky)
    k2 = KX**2 + KY**2
    
    for _ in range(n_steps):
        psi = ifft2(np.exp(-0.005 * 0.5 * k2) * fft2(psi))
        psi *= np.exp(-0.01 * (V + g * np.abs(psi)**2 - mu))
        psi /= np.sqrt(np.sum(np.abs(psi)**2) * dx**2)
    
    n = np.abs(psi)**2
    r_flat = r.flatten()
    d_flat = n.flatten()
    idx = np.argsort(r_flat)
    r_sorted = r_flat[idx]
    d_sorted = d_flat[idx]
    
    n_bins = 60
    r_bins = np.linspace(0.1, L/2, n_bins)
    d_bins = np.zeros(n_bins)
    
    for i in range(n_bins-1):
        mask = (r_sorted > r_bins[i]) & (r_sorted <= r_bins[i+1])
        if mask.sum() > 0:
            d_bins[i] = np.mean(d_sorted[mask])
    
    d_max = d_bins[n_bins//2]
    if d_max < 1e-10:
        return 0.5
    
    d_norm = d_bins / d_max
    
    def profile(r, beta_fit, xi_fit):
        return 1.0 - np.exp(-(r/max(xi_fit, 1e-10))**beta_fit)
    
    mask = (d_norm > 0.05) & (d_norm < 0.95) & (r_bins < L/3)
    
    if mask.sum() < 10:
        return 0.5
    
    try:
        popt, _ = curve_fit(profile, r_bins[mask], d_norm[mask],
                           p0=[1.0, 1.0], maxfev=10000)
        return popt[0]
    except:
        return 0.5

