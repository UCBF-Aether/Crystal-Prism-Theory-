def vortex_predict(R, V_disk, V_gas, ups_disk):
    R = np.asarray(R, dtype=float)
    V_bar = np.sqrt(V_gas**2 + ups_disk * V_disk**2)
    M_bar = max(np.percentile(V_bar**2 * R * 1000, 90) / G_PC, 1e-5)
    M_kg = M_bar * M_sun
    V_flat = (G * a0 * M_kg)**0.25 / 1000.0
    
    a_eff = a_base
    for _ in range(20):
        r_t = np.clip(V_flat**2 / a_eff, R.min()*1.01, R.max()*0.99)
        Sigma = np.interp(r_t, R, V_bar**2 / (2*np.pi*G_PC*R*1000))
        a_new = a_base * np.sqrt(max(Sigma/S_char, 0.01))
        if abs(a_new - a_eff) / a_eff < 1e-4:
            break
        a_eff = 0.7*a_eff + 0.3*a_new
    
    r_t = V_flat**2 / a_eff
    V_vortex = V_flat * (1 - np.exp(-(R/r_t)**beta))
    return np.sqrt(V_bar**2 + V_vortex**2)

def fetch_and_fit_sparc():
    print("\n  Fetching SPARC...")
    Vizier.ROW_LIMIT = -1
    cats = Vizier.get_catalogs('J/AJ/152/157')
    rc = cats[1].to_pandas()
    
    results = []
    for name in rc['Name'].unique():
        g = rc[rc['Name'] == name]
        R = pd.to_numeric(g['Rad'], errors='coerce').values
        Vobs = pd.to_numeric(g['Vobs'], errors='coerce').values
        Vd = pd.to_numeric(g['Vdisk'], errors='coerce').values
        Vg = pd.to_numeric(g['Vgas'], errors='coerce').values
        
        mask = ~np.isnan(R) & ~np.isnan(Vobs) & ~np.isnan(Vd) & ~np.isnan(Vg)
        mask &= (Vobs > 0) & (R > 0)
        if mask.sum() < 5:
            continue
        
        R, Vobs, Vd, Vg = R[mask], Vobs[mask], Vd[mask], Vg[mask]
        
        def objective(x):
            Vpred = vortex_predict(R, Vd, Vg, x[0])
            return np.mean((Vpred - Vobs)**2)
        
        res = minimize(objective, x0=0.7, bounds=[(0.01, 2.5)], method='L-BFGS-B')
        Vpred = vortex_predict(R, Vd, Vg, res.x[0])
        resid = 100 * np.median(np.abs(Vpred - Vobs) / Vobs)
        results.append(resid)
    
    return np.median(results), len(results)

