def fit_little_things(rc):
    print("\n  Fitting LITTLE THINGS dwarfs...")
    results = []
    
    for name in rc['Name'].unique():
        g = rc[rc['Name'] == name]
        R0 = float(g['R0.3'].iloc[0])
        V0 = float(g['V0.3'].iloc[0])
        
        R = pd.to_numeric(g['R'], errors='coerce').values * R0
        Vobs = pd.to_numeric(g['V'], errors='coerce').values * V0
        
        mask = ~np.isnan(R) & ~np.isnan(Vobs) & (Vobs > 0) & (R > 0)
        if mask.sum() < 5:
            continue
        
        R, Vobs = R[mask], Vobs[mask]
        vmax = Vobs.max()
        rmax = R.max()
        M_bar = vmax**2 * rmax * 1000 / G_PC
        M_kg = M_bar * M_sun
        V_flat = (G * a0 * M_kg)**0.25 / 1000
        
        def objective(rt):
            if rt <= 0:
                return 1e10
            Vv = V_flat * (1 - np.exp(-R/rt))
            return np.mean((Vv - Vobs)**2)
        
        res = minimize(objective, x0=rmax/2, bounds=[(0.1, rmax*10)])
        Vv = V_flat * (1 - np.exp(-R/res.x[0]))
        resid = 100 * np.median(np.abs(Vv - Vobs) / Vobs)
        results.append({'name': name, 'resid': resid})
    
    results = pd.DataFrame(results)
    print(f"    ✅ Fitted {len(results)} dwarfs")
    print(f"    Median residual: {results['resid'].median():.2f}%")
    return results

