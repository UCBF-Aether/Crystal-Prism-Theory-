# ============================================================================

def fit_sparc(rc, max_galaxies=175):
    print("\n  Fitting SPARC galaxies...")
    results = []
    
    for name in rc['Name'].unique()[:max_galaxies]:
        g = rc[rc['Name'] == name]
        R = pd.to_numeric(g['Rad'], errors='coerce').values
        Vobs = pd.to_numeric(g['Vobs'], errors='coerce').values
        Vd = pd.to_numeric(g['Vdisk'], errors='coerce').values
        Vg = pd.to_numeric(g['Vgas'], errors='coerce').values
        
        mask = ~np.isnan(R) & ~np.isnan(Vobs) & ~np.isnan(Vd) & ~np.isnan(Vg)
        mask &= (Vobs > 0) & (R > 0)
        
        if mask.sum() < 5:
            continue
        
        R, Vobs, Vd, Vg = R[mask], Vobs[mask], Vd[mask], Vg[mask]
        
        def objective(x):
            Vpred, _ = vortex_predict(R, Vd, Vg, x[0])
            return np.mean((Vpred - Vobs)**2)
        
        res = minimize(objective, x0=0.7, bounds=[(0.01, 2.5)], method='L-BFGS-B')
        Vpred, Vflat = vortex_predict(R, Vd, Vg, res.x[0])
        resid = 100 * np.median(np.abs(Vpred - Vobs) / Vobs)
        results.append({'name': name, 'resid': resid, 'Vflat': Vflat})
    
    results = pd.DataFrame(results)
    print(f"    ✅ Fitted {len(results)} galaxies")
    print(f"    Median residual: {results['resid'].median():.2f}%")
    return results

