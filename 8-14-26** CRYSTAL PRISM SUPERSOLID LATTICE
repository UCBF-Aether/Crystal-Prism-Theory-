def density_profile(r, beta, xi=1.0):
    """n(r) = 1 - exp(-(r/ξ)^β)"""
    return 1.0 - np.exp(-(r/xi)**beta)

def energy_2D(beta, V0, xi=1.0, r_max=30.0):
    """E_2D = ∫ [(1-n)² + V₀(∇n)²] r dr"""
    def f_int(r):
        n = density_profile(r, beta, xi)
        return (1-n)**2 * r
    def g_int(r):
        dn = (beta/xi) * (r/xi)**(beta-1) * np.exp(-(r/xi)**beta)
        return dn**2 * r
    Ef = quad(f_int, 0, r_max, epsabs=1e-14, epsrel=1e-14)[0]
    El = quad(g_int, 0, r_max, epsabs=1e-14, epsrel=1e-14)[0]
    return Ef + V0 * El

def optimal_beta_2D(V0):
    """Find β that minimizes E_2D."""
    res = minimize_scalar(lambda b: energy_2D(b, V0),
                         bounds=(0.01, 2.0), method='bounded',
                         options={'xatol': 1e-14})
    return res.x

