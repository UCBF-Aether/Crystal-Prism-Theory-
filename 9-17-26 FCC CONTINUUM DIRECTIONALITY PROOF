section("16. RANDOM 3D DIRECTIONS")

random.seed(20260917)

max_random_quad = 0.0
max_random_D = 0.0

for _ in range(250):

    raw = (
        random.uniform(-2.0, 2.0),
        random.uniform(-2.0, 2.0),
        random.uniform(-2.0, 2.0)
    )

    if norm(raw) < 1e-14:
        continue

    direction = scale(
        1.0 / norm(raw),
        raw
    )

    k = scale(
        1.0e-3 / a,
        direction
    )

    lhs = sum(
        dot(k, d) ** 2
        for d in fcc
    )

    rhs = (
        2.0 *
        a *
        a *
        dot(k, k)
    )

    quad_error = (
        abs(lhs - rhs)
        / rhs
    )

    D = D_fcc(k)

    D_error = (
        norm(sub(D, k))
        / norm(k)
    )

    max_random_quad = max(
        max_random_quad,
        quad_error
    )

    max_random_D = max(
        max_random_D,
        D_error
    )

print("250 random 3D directions tested.")

print()
print(
    "Maximum quadratic error = {:.3e}".format(
        max_random_quad
    )
)

print(
    "Maximum D→k error = {:.3e}".format(
        max_random_D
    )
)

check(
    "Random 3D directions satisfy the quadratic identity.",
    max_random_quad < 1e-12
)

check(
    "Random 3D directions converge toward D(k)=k.",
    max_random_D < 1e-5
)


