section("5. FCC DIFFERENTIAL OPERATOR")

def D_fcc(k):

    result = [0.0, 0.0, 0.0]

    for d in fcc:

        phase = dot(k, d)

        for i in range(3):

            result[i] += (
                d[i] *
                math.sin(phase)
            )

    return tuple(
        x / (2.0 * a * a)
        for x in result
    )


