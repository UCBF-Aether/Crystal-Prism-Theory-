def power_law_exponent(xs, ys):

    lx = [math.log(x) for x in xs]
    ly = [math.log(y) for y in ys]

    xm = sum(lx) / len(lx)
    ym = sum(ly) / len(ly)

    numerator = sum(
        (x - xm) * (y - ym)
        for x, y in zip(lx, ly)
    )

    denominator = sum(
        (x - xm) ** 2
        for x in lx
    )

    return numerator / denominator


