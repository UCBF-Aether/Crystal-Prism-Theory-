section("10. TRANSVERSE OPERATOR")

max_transverse_residual = 0.0
max_splitting = 0.0

for direction in directions[:200]:

    k = scale(
        0.25 / a,
        direction
    )

    D = D_fcc(k)

    D2 = dot(D, D)

    if D2 < 1e-20:
        continue

    # Select a trial vector not parallel to D.
    trial = (1.0, 0.0, 0.0)

    if abs(dot(trial, D)) / math.sqrt(D2) > 0.9:
        trial = (0.0, 1.0, 0.0)

    # Project trial transverse to D.
    projection = scale(
        dot(trial, D) / D2,
        D
    )

    e1 = sub(
        trial,
        projection
    )

    e1 = scale(
        1.0 / norm(e1),
        e1
    )

    # e2 = normalized D × e1
    e2 = (
        D[1] * e1[2] - D[2] * e1[1],
        D[2] * e1[0] - D[0] * e1[2],
        D[0] * e1[1] - D[1] * e1[0]
    )

    e2 = scale(
        1.0 / norm(e2),
        e2
    )

    C = curl_matrix(D)

    K = mat_mul(
        transpose(C),
        C
    )

    r1 = norm(
        sub(
            mat_vec(K, e1),
            scale(D2, e1)
        )
    )

    r2 = norm(
        sub(
            mat_vec(K, e2),
            scale(D2, e2)
        )
    )

    max_transverse_residual = max(
        max_transverse_residual,
        r1,
        r2
    )

    lambda1 = dot(
        e1,
        mat_vec(K, e1)
    )

    lambda2 = dot(
        e2,
        mat_vec(K, e2)
    )

    splitting = abs(
        lambda1 - lambda2
    )

    max_splitting = max(
        max_splitting,
        splitting
    )

print(
