section("17. DIRECTIONAL ANISOTROPY SCALING")

anis_ka = []
anis_spread = []

for ka in [
    0.25,
    0.125,
    0.0625,
    0.03125,
    0.015625,
    0.0078125,
    0.00390625
]:

    velocities = []

    for direction in sphere_directions:

        k = scale(
            ka / a,
            direction
        )

        D = D_fcc(k)

        velocities.append(
            norm(D) / norm(k)
        )

    vmin = min(velocities)
    vmax = max(velocities)
    mean = sum(velocities) / len(velocities)

    spread = (
        (vmax - vmin)
        / mean
    )

    anis_ka.append(ka)
    anis_spread.append(spread)

anis_exponent = power_law_exponent(
    anis_ka,
    anis_spread
)

print(
    "Directional anisotropy exponent = {:.8f}".format(
        anis_exponent
    )
)

check(
    "Directional anisotropy vanishes as approximately (ka)².",
    abs(anis_exponent - 2.0) < 0.10
)


