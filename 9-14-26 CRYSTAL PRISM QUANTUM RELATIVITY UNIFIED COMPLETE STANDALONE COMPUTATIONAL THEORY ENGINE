def load_sparc(data_dir="sparc_data", max_retries=5):
    os.makedirs(data_dir, exist_ok=True)
    zp = os.path.join(data_dir, "Rotmod_LTG.zip")
    if not os.path.exists(zp):
        for a in range(1, max_retries + 1):
            try:
                r = requests.get(ZENODO_URL, timeout=180, stream=True)
                r.raise_for_status()
                with open(zp, "wb") as f:
                    for chunk in r.iter_content(1 << 16):
                        f.write(chunk)
                break
            except requests.exceptions.RequestException:
                if a == max_retries:
                    raise
                time.sleep(2 ** a)
    if not glob.glob(f"{data_dir}/*_rotmod.dat"):
        with zipfile.ZipFile(zp) as z:
            z.extractall(data_dir)

    galaxies = {}
    for fp in sorted(glob.glob(f"{data_dir}/*_rotmod.dat")):
        name = os.path.basename(fp).replace("_rotmod.dat", "")
        rows = []
        with open(fp) as fh:
            for line in fh:
                s = line.strip()
                if not s or s.startswith("#"):
                    continue
                p = s.split()
                if len(p) < 6:
                    continue
                try:
                    rows.append([float(x) for x in p[:6]])
                except ValueError:
                    continue
        if len(rows) < 3:
            continue
        d = np.array(rows)
        R, Vobs, Verr = d[:,0], d[:,1], d[:,2]
        Vg = np.abs(d[:,3]); Vd = d[:,4]; Vb = d[:,5]
        m = (R > 0) & (Vobs > 0) & (Verr > 0)
        if m.sum() < 3:
            continue
        order = np.argsort(R[m])
        galaxies[name] = {
            "R_kpc": R[m][order], "V_obs": Vobs[m][order],
            "V_err": Verr[m][order], "V_gas": Vg[m][order],
            "V_disk": Vd[m][order], "V_bul": Vb[m][order],
        }
    return galaxies


def baryonic_mass(R_kpc, Vd_ml, Vb_ml, Vg):
    V_bar = np.sqrt(Vg**2 + Vd_ml**2 + Vb_ml**2)
    R_pc = R_kpc * KPC_TO_PC
    return max(np.percentile(V_bar**2 * R_pc, 90) / G_PC_GALAXY, 1e-5)


def solve_a_eff(R_kpc, Sigma_bar, V_flat, a_base, Sigma_char, max_iter=20, tol=1e-4):
    R_kpc = np.asarray(R_kpc, dtype=float)
    Sigma_bar = np.asarray(Sigma_bar, dtype=float)
    a_eff = a_base
    for _ in range(max_iter):
        r_t = np.clip(V_flat**2 / a_eff,
                       R_kpc.min()*1.01, R_kpc.max()*0.99)
        S = np.interp(r_t, R_kpc, Sigma_bar)
        a_new = np.clip(
            a_base * np.sqrt(np.clip(S/Sigma_char, 0.01, 100.0)),
            400.0, 12000.0)
        if abs(a_new - a_eff)/a_eff < tol:
            return a_new, V_flat**2/a_new
        a_eff = 0.7*a_eff + 0.3*a_new
    return a_eff, V_flat**2/a_eff


def vortex_predict(R, Vd, Vb, Vg, ups_d, beta_val, galaxy_scales_data):
    R = np.asarray(R, dtype=float)
    if len(Vd) != len(R):
        R0 = np.linspace(R.min(), R.max(), len(Vd))
        f = lambda V: interp1d(R0, V, kind="linear",
                               fill_value="extrapolate")(R)
        Vd, Vb, Vg = map(f, (Vd, Vb, Vg))
    Vd_ml = Vd * np.sqrt(max(ups_d, 0.01))
    Vb_ml = Vb * np.sqrt(UPS_BULGE)
    Vg = np.abs(Vg)
    V_bar = np.sqrt(Vg**2 + Vd_ml**2 + Vb_ml**2)
    M_bar = baryonic_mass(R, Vd_ml, Vb_ml, Vg)
    V_flat = (galaxy_scales_data["a0"] * galaxy_scales_data["G_use"] *
              M_bar * M_SUN_GALAXY)**0.25 / 1000.0
    R_pc = R * KPC_TO_PC
    with np.errstate(divide="ignore", invalid="ignore"):
        Sigma = np.where(R_pc > 1e-10,
                         V_bar**2/(2*PI*G_PC_GALAXY*R_pc), 0.0)
    a_eff, r_t = solve_a_eff(
        R, Sigma, V_flat, galaxy_scales_data["a_base"], galaxy_scales_data["Sigma_char"])
    x = R / max(r_t, 1e-6)
    V_vortex = V_flat * (1.0 - np.exp(-(x ** beta_val)))
    return {
        "V_pred": np.sqrt(V_bar**2 + V_vortex**2),
        "V_flat": V_flat,
        "M_bar": M_bar,
        "r_t": r_t,
    }


def fit_galaxy(gal, galaxy_scales_data):
    R, Vo, Ve = gal["R_kpc"], gal["V_obs"], gal["V_err"]
    Vd, Vb, Vg = gal["V_disk"], gal["V_bul"], gal["V_gas"]
    m = (Vo > 1.0) & (Ve > 0)
    if m.sum() < 3:
        return None
    errs = np.sqrt(Ve[m]**2 + (0.05*Vo[m])**2)

    def obj(x):
        try:
            pred = vortex_predict(R, Vd, Vb, Vg, x[0], x[1],
                                  galaxy_scales_data)["V_pred"]
        except Exception:
            return 1e10
        return np.sum(((pred[m] - Vo[m]) / errs)**2)

    best_x, best_f = [0.5, 0.7], np.inf
    for u0 in (0.3, 0.5, 0.7, 1.0, 1.5):
        for b0 in (0.2, 0.4, 0.6, 0.8, 1.2, 1.8):
            r = minimize(
                obj, [u0, b0], method="L-BFGS-B",
                bounds=[(0.01, 2.5), (0.1, 2.5)],
                options={"maxiter": 300})
            if r.fun < best_f:
                best_f, best_x = r.fun, r.x
    ups_d, beta_best = best_x
    pred = vortex_predict(R, Vd, Vb, Vg, ups_d, beta_best,
                          galaxy_scales_data)
    resid = pred["V_pred"][m] - Vo[m]
    pct = 100.0 * resid / Vo[m]
    return {
        "ups_disk": ups_d,
        "beta": beta_best,
        "V_flat": pred["V_flat"],
        "median_abs_pct": float(np.median(np.abs(pct))),
        "mean_abs_pct": float(np.mean(np.abs(pct))),
        "n_pts": int(m.sum()),
    }


