def e8_roots():
    roots = []
    # 112 integer roots: choose two coordinates and assign two independent signs.
    for i, j in combinations(range(8), 2):
        for si in (-1.0, 1.0):
            for sj in (-1.0, 1.0):
                x = [0.0] * 8
                x[i] = si
                x[j] = sj
                roots.append(tuple(x))
    # 128 half-integer roots: all sign choices with even parity of minus signs.
    for bits in range(1 << 8):
        minus = bits.bit_count()
        if minus % 2 == 0:
            roots.append(tuple(0.5 if ((bits >> i) & 1) == 0 else -0.5
                               for i in range(8)))
    return roots

def project_e8(x):
    d = math.sqrt(2.0 + PHI)
    return ((x[0] + PHI*x[4])/d,
            (x[1] + PHI*x[5])/d,
            (x[2] + PHI*x[6])/d)

def radius(p):
    return math.sqrt(sum(v*v for v in p))

def unique_points(points, digits=12):
    return list({tuple(round(v, digits) for v in p) for p in points})

def radial_shells(points):
    radii = sorted(radius(p) for p in points if radius(p) > RADIAL_TOL)
    shells = []
    for r in radii:
        if not shells or abs(r-shells[-1][0]) > RADIAL_TOL:
            shells.append([r, 1])
        else:
            shells[-1][1] += 1
    return [(r,n) for r,n in shells]

def difference_shells(points, digits=GEOMETRY_DIGITS):
    radii = set()
    for i, a in enumerate(points):
        ax, ay, az = a
        for j, b in enumerate(points):
            if i == j:
                continue
            bx, by, bz = b
            r = math.sqrt((ax-bx)**2 + (ay-by)**2 + (az-bz)**2)
            if r > RADIAL_TOL:
                radii.add(round(r, digits))
    return len(radii)

def geometry():
