MPC_M_GALAXY = 3.08567758e22
G_PC_GALAXY = 4.3009e-3
KPC_TO_PC = 1000.0
UPS_BULGE = 0.7
BETA_GALAXY = 0.5
ZENODO_URL = "https://zenodo.org/records/16284118/files/Rotmod_LTG.zip"


def galaxy_scales(G_derived, H0_derived):
    H0_si_use = H0_derived * 1000.0 / MPC_M_GALAXY
    a0_use = c * H0_si_use / (2.0 * PI)
    a_base_si_use = a0_use * 2.0 / SQRT3
    a_base_use = a_base_si_use * 1e-3 * (KPC_M_GALAXY / 1e3)
    Sigma_char_use = (a_base_si_use / (PI * G_derived)) * \
                     (12.0 / (21.0 + 12.0)) * PC_M_GALAXY**2 / M_SUN_GALAXY
    return {
        "G_use": G_derived,
        "H0_use": H0_derived,
        "H0_si": H0_si_use,
        "a0": a0_use,
        "a_base_si": a_base_si_use,
        "a_base": a_base_use,
        "Sigma_char": Sigma_char_use,
    }


