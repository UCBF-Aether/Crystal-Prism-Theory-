def fetch_sparc():
    """
    Fetch SPARC rotation curves from Vizier.
    
    Lelli, McGaugh, Schombert (2016), AJ, 152, 157.
    175 galaxies with resolved rotation curves.
    
    Returns
    -------
    rc : DataFrame — rotation curve data
    """
