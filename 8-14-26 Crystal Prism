def derive_a0():
    """
    Derive a₀ = c H₀ / 2π
    
    The lattice expands at rate H₀. The natural acceleration scale
    of an expanding medium with sound speed c is the product of
    sound speed and expansion rate, divided by 2π for the periodic
    boundary condition of the lattice.
    
    This is the Milgrom relation — previously empirical, now derived.
    
    Returns
    -------
    a0_derived : float
        Acceleration scale in m/s²
    """
    # Convert Hubble constant to SI
    H0_si = H0 * 1000.0 / 3.086e22  # km/s/Mpc → s⁻¹
    
    # Derive a₀
    a0_derived = c * H0_si / (2 * np.pi)
    
    return a0_derived

# ============================================================================
# SECTION 1: DERIVE β FROM GP EQUATION
# ============================================================================

def derive_beta(N=128, L=25.0, V0=1.5, n_steps=300):
    """
    Derive β from Gross-Pitaevskii equation with periodic lattice potential.
    
    Solves the time-independent GP equation using imaginary-time propagation
    on a 2D grid. The lattice potential V(x,y) = V₀(cos kx + cos ky)
    modifies the vortex core from the superfluid value (β ≈ 1.7)
    toward the supersolid value (β ≈ 0.5).
    
    Parameters
    ----------
    N : int — grid size
    L : float — spatial extent
    V0 : float — lattice potential depth
    n_steps : int — imaginary-time iterations
    
    Returns
    -------
    beta_derived : float
        Vortex core exponent extracted from density profile
    """
    # Grid setup
    x = np.linspace(-L/2, L/2, N)
    y = np.linspace(-L/2, L/2, N)
    X, Y = np.meshgrid(x, y)
    dx = L / N
    
    # GP parameters (normalized)
    mu = 1.0  # chemical potential
    g = 1.0   # interaction strength
    k = 2.0 * np.pi / 2.0  # lattice wavevector
    
    # Lattice potential
    V = V0 * (np.cos(k*X) + np.cos(k*Y))
    
    # Vortex initial condition (winding number n=1)
    r = np.sqrt(X**2 + Y**2)
    theta = np.arctan2(Y, X)
    psi = np.tanh(r) * np.exp(1j * theta)
    # Avoid singularity at origin
    psi[r < 0.1] = (r[r < 0.1] / 0.1) * np.exp(1j * theta[r < 0.1])
    
    # Fourier frequencies for kinetic operator
    kx = 2 * np.pi * fftfreq(N, dx)
    ky = 2 * np.pi * fftfreq(N, dx)
    KX, KY = np.meshgrid(kx, ky)
    k2 = KX**2 + KY**2
    
    # Imaginary-time propagation
    for _ in range(n_steps):
        # Kinetic part in Fourier space
        psi = ifft2(np.exp(-0.005 * 0.5 * k2) * fft2(psi))
        # Potential part in real space
        psi *= np.exp(-0.01 * (V + g * np.abs(psi)**2 - mu))
        # Normalize
        psi /= np.sqrt(np.sum(np.abs(psi)**2) * dx**2)
    
    # Extract density
    n = np.abs(psi)**2
    
    # Azimuthal average
    r_flat = r.flatten()
    d_flat = n.flatten()
    idx = np.argsort(r_flat)
    r_sorted = r_flat[idx]
    d_sorted = d_flat[idx]
    
    n_bins = 60
    r_bins = np.linspace(0.1, L/2, n_bins)
    d_bins = np.zeros(n_bins)
    
    for i in range(n_bins-1):
        mask = (r_sorted > r_bins[i]) & (r_sorted <= r_bins[i+1])
        if mask.sum() > 0:
            d_bins[i] = np.mean(d_sorted[mask])
    
    # Normalize
    d_max = d_bins[n_bins//2]
    if d_max < 1e-10:
        return 0.5  # fallback if solver fails
    
    d_norm = d_bins / d_max
    
    # Fit to vortex profile form
    def profile(r, beta_fit, xi_fit):
        return 1.0 - np.exp(-(r/max(xi_fit, 1e-10))**beta_fit)
    
    mask = (d_norm > 0.05) & (d_norm < 0.95) & (r_bins < L/3)
    
    if mask.sum() < 10:
        return 0.5  # fallback
    
    try:
        popt, _ = curve_fit(profile, r_bins[mask], d_norm[mask],
                           p0=[1.0, 1.0], maxfev=10000)
        return popt[0]
    except:
        return 0.5  # fallback

# ============================================================================
# SECTION 2: VORTEX WAKE MODEL
# ============================================================================

def vortex_predict(R, V_disk, V_gas, ups_disk):
    """
    Predict rotation curve with fixed vortex parameters.
    
    The total velocity has two components:
      V_total² = V_bar² + V_vortex²
    
    V_bar is the standard Newtonian velocity from visible matter.
    V_vortex is the circulation wake from galaxy motion through the lattice.
    
    Parameters
    ----------
    R : array — radii in kpc
    V_disk : array — disk velocity contribution
    V_gas : array — gas velocity contribution
    ups_disk : float — mass-to-light ratio (only free parameter)
    
    Returns
    -------
    V_total : array — predicted total velocity
    V_flat : float — flat rotation velocity
    """
    R = np.asarray(R, dtype=float)
    
    # Baryonic velocity
    V_bar = np.sqrt(V_gas**2 + ups_disk * V_disk**2)
    
    # Baryonic mass from 90th percentile
    M_bar = max(np.percentile(V_bar**2 * R * 1000, 90) / G_PC, 1e-5)
    M_kg = M_bar * M_sun
    
    # V_flat from BTFR
    V_flat = (G * a0 * M_kg)**0.25 / 1000.0
    
    # Self-consistent acceleration
    a_eff = a_base
    for _ in range(20):
        r_t = np.clip(V_flat**2 / a_eff, R.min()*1.01, R.max()*0.99)
        Sigma = np.interp(r_t, R, V_bar**2 / (2*np.pi*G_PC*R*1000))
        a_new = a_base * np.sqrt(max(Sigma/S_char, 0.01))
        if abs(a_new - a_eff) / a_eff < 1e-4:
            break
        a_eff = 0.7*a_eff + 0.3*a_new
    
    # Vortex wake
    r_t = V_flat**2 / a_eff
    V_vortex = V_flat * (1 - np.exp(-(R/r_t)**beta))
    
    # Total
    return np.sqrt(V_bar**2 + V_vortex**2), V_flat

