    note("G, H0, a0, a_base, Sigma_char are the DERIVED values from Phase 5.")
    note("beta = eta0 is the DERIVED vacuum order parameter from Phase 2.")
    note("The only fitted parameter is Upsilon_disk (galaxy M/L) per galaxy.")
    print()

    eta0 = fcc["eta0"]
    consts = {
        "G": phase4["G"],
        "a0": phase5["a0"],
        "a_base": phase5["a_base"],
        "Sigma_char": phase5["Sigma"],
    }

    out("beta (vortex exponent)", f"eta0 = {eta0:.15f}", "DERIVED")
    out("G_use", f"{consts['G']:.6e} m^3 kg^-1 s^-2", "DERIVED")
    out("a0", f"{consts['a0']:.6e} m/s^2", "DERIVED")
    out("a_base", f"{consts['a_base']:.4f} (km/s)^2/kpc", "DERIVED")
    out("Sigma_char", f"{consts['Sigma_char']:.4f} M_sun/pc^2", "DERIVED")
    out("Upsilon_bulge", f"{UPS_BULGE:.2f}", "INPUT (fixed)")
    print()

    try:
        galaxies = load_sparc()
    except Exception as ex:
        note(f"SPARC download failed: {ex}")
        return None
    out("Galaxies loaded", len(galaxies), "OBSERVATIONAL")

    t0 = time.time()
    results = {}
    for name, gal in galaxies.items():
        r = fit_galaxy(gal, consts, beta_val=eta0)
        if r is not None:
            results[name] = r
    elapsed = time.time() - t0

    med = np.array([r["median_abs_pct"] for r in results.values()])
    mab = np.array([r["mean_abs_pct"] for r in results.values()])
    upd = np.array([r["ups_disk"] for r in results.values()])
    vfl = np.array([r["V_flat"] for r in results.values()])

    print()
    out("Galaxies fitted", len(results), "FIT")
    out("Runtime", f"{elapsed:.1f} s", "")
    out("Median |residual|", f"{np.median(med):.2f}%", "FIT")
    out("Mean |residual|", f"{np.mean(mab):.2f}%", "FIT")
    out("Upsilon_disk (median)", f"{np.median(upd):.2f}", "FIT")
    out("Upsilon_disk [16, 84]",
        f"[{np.percentile(upd, 16):.2f}, {np.percentile(upd, 84):.2f}]", "FIT")

    print()
    note("Residual by V_flat bin:")
    bins = [(0, 40), (40, 60), (60, 90), (90, 130), (130, 180), (180, 400)]
    for lo, hi in bins:
        mask = (vfl >= lo) & (vfl < hi)
        if mask.sum() == 0:
            continue
        note(f"  [{lo:>3}, {hi:>3})  n = {mask.sum():>4}   "
             f"median = {np.median(med[mask]):.2f}%")

    return {
        "n": len(results),
        "median": float(np.median(med)),
        "mean": float(np.mean(mab)),
        "median_ups": float(np.median(upd)),
    }


