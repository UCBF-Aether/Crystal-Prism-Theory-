    out("H4/FCC moment scale^2", f"{moment_scale2:.15f}", "GEOMETRIC")
    out("S2 (second radial moment)", f"{S2:.15f}", "GEOMETRIC")
    out("S4 (fourth radial moment)", f"{S4:.15f}", "GEOMETRIC")
    out("N (nonzero points)", len(nonzero), "GEOMETRIC")
    out("w (closure constant)", "0.5", "MODEL RELATION")
    out("eta0 = S2^2 / [(N+w) S4]", f"{eta0:.15f}", "DERIVED")

    print()
    note("Step 2c.  FCC lattice topology.")
    print()
    V_lat = 4
    Z_lat = 12
    E_lat = V_lat * Z_lat // 2
    C_lat = 1
    mu_lat = E_lat - V_lat + C_lat
    b0 = (11.0*3.0 - 2.0*6.0) / 3.0
    w_fcc = (mu_lat + Z_lat) / (4.0 * b0 * PHI)
    g_fcc = 2.0 * 1.5 * (1.0 / PHI) * w_fcc
