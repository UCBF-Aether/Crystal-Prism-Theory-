    out("mu = E - V + C (cyclomatic)", mu_lat, "DERIVED")
    out("b0", f"{b0:.15f}", "DERIVED")
    out("w_FCC", f"{w_fcc:.15f}", "DERIVED")
    out("g_FCC (direct)", f"{g_fcc:.15f}", "DERIVED")
    out("g_FCC (closed form 99/(28 phi^2))", f"{g_closed:.15f}", "DERIVED")
    out("g_FCC agreement", f"{pct_error(g_fcc, g_closed):.6e} %", "CHECK")
    out("FCC packing eta = pi/(3 sqrt 2)", f"{eta_pack:.15f}", "GEOMETRIC (theorem)")
    out("Two tetrahedral sublattices", "parity of x+y+z", "GEOMETRIC")
    out("Local icosahedral order", "cuboctahedron -> icosahedron", "GEOMETRIC")

    return {
        "roots": roots, "projected": projected, "nonzero": nonzero,
