def plasma_params(n_e, T_e):
    omega_p = math.sqrt(n_e * e_SI**2 / (m_e_SI * eps0_SI))
    lam_D   = math.sqrt(eps0_SI * k_B_SI * T_e / (n_e * e_SI**2))
    a_ws    = (3.0 / (4.0 * PI * n_e))**(1.0 / 3.0)
    Gamma   = e_SI**2 / (4.0 * PI * eps0_SI * a_ws * k_B_SI * T_e)
    return {"omega_p": omega_p, "lam_D": lam_D,
            "a_ws": a_ws, "Gamma": Gamma}


def fmt_length(x_m):
    """Format a length in meters with the most readable unit."""
    if x_m >= 1e-3:
        return f"{x_m*1e3:.3f} mm"
    if x_m >= 1e-6:
        return f"{x_m*1e6:.3f} um"
    if x_m >= 1e-9:
        return f"{x_m*1e9:.3f} nm"
    if x_m >= 1e-12:
        return f"{x_m*1e12:.3f} pm"
    return f"{x_m:.3e} m"


