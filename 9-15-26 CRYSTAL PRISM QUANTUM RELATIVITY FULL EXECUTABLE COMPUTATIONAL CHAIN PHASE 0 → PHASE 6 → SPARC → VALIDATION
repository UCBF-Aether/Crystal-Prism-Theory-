    out("f_s0", f"{f_s0:.15f}", "DERIVED")
    out("rho = C44 / c^2", f"{rho:.15e} kg/m^3", "DERIVED")
    out("a (self-consistent)", f"{a:.15e} m", "DERIVED")
    out("m0 = rho a^3 / 4", f"{m0:.15e} kg", "DERIVED")
