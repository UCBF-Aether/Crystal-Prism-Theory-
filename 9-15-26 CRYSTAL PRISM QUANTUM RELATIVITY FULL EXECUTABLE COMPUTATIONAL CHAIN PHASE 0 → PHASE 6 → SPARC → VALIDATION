def load_sparc(data_dir="sparc_data", max_retries=5):
    os.makedirs(data_dir, exist_ok=True)
    zp = os.path.join(data_dir, "Rotmod_LTG.zip")
    if not os.path.exists(zp):
        for a in range(1, max_retries + 1):
            try:
                r = requests.get(ZENODO_URL, timeout=180, stream=True)
                r.raise_for_status()
                with open(zp, "wb") as f:
                    for chunk in r.iter_content(1 << 16):
                        f.write(chunk)
                break
            except requests.exceptions.RequestException:
                if a == max_retries:
                    raise
                time.sleep(2 ** a)
    if not glob.glob(f"{data_dir}/*_rotmod.dat"):
        with zipfile.ZipFile(zp) as z:
            z.extractall(data_dir)

    galaxies = {}
    for fp in sorted(glob.glob(f"{data_dir}/*_rotmod.dat")):
        name = os.path.basename(fp).replace("_rotmod.dat", "")
        rows = []
        with open(fp) as fh:
            for line in fh:
                s = line.strip()
                if not s or s.startswith("#"):
                    continue
                p = s.split()
                if len(p) < 6:
                    continue
                try:
                    rows.append([float(x) for x in p[:6]])
                except ValueError:
                    continue
        if len(rows) < 3:
            continue
        d = np.array(rows)
        R, Vobs, Verr = d[:, 0], d[:, 1], d[:, 2]
        Vg = np.abs(d[:, 3]); Vd = d[:, 4]; Vb = d[:, 5]
        m = (R > 0) & (Vobs > 0) & (Verr > 0)
        if m.sum() < 3:
            continue
        order = np.argsort(R[m])
        galaxies[name] = {
            "R_kpc": R[m][order], "V_obs": Vobs[m][order],
            "V_err": Verr[m][order], "V_gas": Vg[m][order],
            "V_disk": Vd[m][order], "V_bul": Vb[m][order],
        }
    return galaxies


def baryonic_mass(R_kpc, Vd_ml, Vb_ml, Vg):
    V_bar = np.sqrt(Vg**2 + Vd_ml**2 + Vb_ml**2)
    R_pc = R_kpc * KPC_TO_PC
    return max(np.percentile(V_bar**2 * R_pc, 90) / G_PC_GALAXY, 1e-5)


def solve_a_eff(R_kpc, Sigma_bar, V_flat, a_base, Sigma_char,
                max_iter=15, tol=1e-3):
    R_kpc = np.asarray(R_kpc, dtype=float)
    Sigma_bar = np.asarray(Sigma_bar, dtype=float)
    a_eff = a_base
    for _ in range(max_iter):
        r_t = np.clip(V_flat**2 / a_eff,
                      R_kpc.min()*1.01, R_kpc.max()*0.99)
        S = np.interp(r_t, R_kpc, Sigma_bar)
        a_new = np.clip(
            a_base * np.sqrt(np.clip(S / Sigma_char, 0.01, 100.0)),
            400.0, 12000.0)
        if abs(a_new - a_eff) / a_eff < tol:
            return a_new, V_flat**2 / a_new
        a_eff = 0.7 * a_eff + 0.3 * a_new
    return a_eff, V_flat**2 / a_eff


def vortex_predict(R, Vd, Vb, Vg, ups_d, beta_val, consts):
    Vd_ml = Vd * math.sqrt(max(ups_d, 0.01))
    Vb_ml = Vb * math.sqrt(UPS_BULGE)
    Vg_a = np.abs(Vg)
    V_bar = np.sqrt(Vg_a**2 + Vd_ml**2 + Vb_ml**2)
    M_bar = baryonic_mass(R, Vd_ml, Vb_ml, Vg_a)
    V_flat = (consts["a0"] * consts["G"] * M_bar * M_SUN_GALAXY)**0.25 / 1000.0
    R_pc = R * KPC_TO_PC
    with np.errstate(divide="ignore", invalid="ignore"):
        Sigma = np.where(R_pc > 1e-10,
                         V_bar**2 / (2 * PI * G_PC_GALAXY * R_pc), 0.0)
    a_eff, r_t = solve_a_eff(R, Sigma, V_flat,
                             consts["a_base"], consts["Sigma_char"])
    x = R / max(r_t, 1e-6)
    V_vortex = V_flat * (1.0 - np.exp(-(x ** beta_val)))
    V_pred = np.sqrt(V_bar**2 + V_vortex**2)
    return {"V_pred": V_pred, "V_flat": float(V_flat)}


def fit_galaxy(gal, consts, beta_val):
    R, Vo, Ve = gal["R_kpc"], gal["V_obs"], gal["V_err"]
    Vd, Vb, Vg = gal["V_disk"], gal["V_bul"], gal["V_gas"]
    m = (Vo > 1.0) & (Ve > 0)
    if m.sum() < 3:
        return None
    Vo_m = Vo[m]
    errs = np.sqrt(Ve[m]**2 + (0.05 * Vo_m)**2)

    def chi2(u):
        try:
            pred = vortex_predict(R, Vd, Vb, Vg, u, beta_val, consts)["V_pred"]
        except Exception:
            return 1e10
        return float(np.sum(((pred[m] - Vo_m) / errs)**2))

    res = minimize_scalar(chi2, bounds=UPS_BOUNDS,
                          method="bounded", options={"xatol": 1e-4})
    ups_best = float(res.x)
    out = vortex_predict(R, Vd, Vb, Vg, ups_best, beta_val, consts)
    resid = out["V_pred"][m] - Vo_m
    pct = 100.0 * resid / Vo_m
    return {
        "ups_disk": ups_best,
        "V_flat": out["V_flat"],
        "median_abs_pct": float(np.median(np.abs(pct))),
        "mean_abs_pct": float(np.mean(np.abs(pct))),
        "n_pts": int(m.sum()),
    }


def sparc_branch(fcc, phase3, phase4, phase5):
