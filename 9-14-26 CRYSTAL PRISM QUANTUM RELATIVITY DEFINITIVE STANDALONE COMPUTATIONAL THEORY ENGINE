def vortex_prediction(R_m, Vbar, Vflat, Sigma_char, a_base_si, Gd, beta):
    # Self-consistent transition scale.  Vbar is the baryonic circular speed.
    R_kpc=max(R_m/1.0e3/pc,1e-12)
    V_mps=Vbar
    Sigma=V_mps**2/(2.0*PI*Gd*R_mps_to_pc2(R_m)) if R_m>0 else Sigma_char
    ae=a_base_si*math.sqrt(max(Sigma/Sigma_char,0.01))
    rt=Vflat**2/max(ae,1e-30)
    x=max(R_m/max(rt,1e-30),0.0)
    Vv=Vflat*(1.0-math.exp(-(x**beta)))
    return math.sqrt(max(Vbar*Vbar+Vv*Vv,0.0)),rt,Vv

def R_mps_to_pc2(R_m):
    # area πR² in pc²; helper for surface-density conversion
