    fixed=[]; free=[]
    for name,rows in galaxies:
        fixed.append((name,fit_vortex_galaxy(rows,gravity_data["G"],gravity_data["a0"],cosmo["Sigma"],cosmo["a_base_si"],False)))
        free.append((name,fit_vortex_galaxy(rows,gravity_data["G"],gravity_data["a0"],cosmo["Sigma"],cosmo["a_base_si"],True)))
    fm=[x[1]["median"] for x in fixed]; fr=[x[1]["median"] for x in free]
    line("Dataset", str(path), "OBSERVATIONAL INPUT")
    line("Galaxies", len(galaxies), "OBSERVATIONAL DATA")
    line("Fixed β=0.5 median |res|", f"{sorted(fm)[len(fm)//2]:.4f} %", "EMPIRICAL")
    line("Beta-free median |res|", f"{sorted(fr)[len(fr)//2]:.4f} %", "EMPIRICAL")
    line("Beta-free median β", f"{sorted(x[1]["beta"] for x in free)[len(free)//2]:.5f}", "FIT / EMPIRICAL")
    return {"path":str(path),"galaxies":len(galaxies),"fixed":fixed,"free":free}

