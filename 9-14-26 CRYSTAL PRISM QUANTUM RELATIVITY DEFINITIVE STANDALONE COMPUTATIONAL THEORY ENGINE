    norms2 = [sum(v*v for v in x) for x in roots]
    projected = unique_points([project_e8(x) for x in roots] + [(0.0,0.0,0.0)])
    nonzero = [p for p in projected if radius(p) > RADIAL_TOL]
    shells = radial_shells(projected)
    diff_count = len(projected) * (len(projected)-1)
    diff_shell_count = difference_shells(projected)
    fcc_shells = [(r,n) for r,n in shells if n == 12]
    ratio = fcc_shells[1][0]/fcc_shells[0][0] if len(fcc_shells) >= 2 else float("nan")

