def norm_name(s):
    return ''.join(ch.lower() for ch in str(s) if ch.isalnum())

def find_col(headers, names):
    lookup={norm_name(h):h for h in headers}
    for n in names:
        k=norm_name(n)
        if k in lookup: return lookup[k]
    return None

def parse_delimited(path):
    with open(path,'r',encoding='utf-8',errors='ignore') as f:
        text=f.read()
    lines=[x.strip() for x in text.splitlines() if x.strip() and not x.lstrip().startswith('#')]
    if not lines: return []
    delim=',' if ',' in lines[0] else None
    if delim:
        rows=list(csv.DictReader(lines))
        return rows
    # Whitespace-delimited with header.
    headers=lines[0].split()
    out=[]
    for ln in lines[1:]:
        vals=ln.split()
        if len(vals)<len(headers): continue
        out.append(dict(zip(headers,vals)))
    return out

def parse_sparc(path):
    rows=parse_delimited(path)
    if not rows: return []
    headers=list(rows[0].keys())
    name=find_col(headers,["Name","ID","Galaxy","galaxy"])
    rad=find_col(headers,["Rad","R","Radius"])
    vobs=find_col(headers,["Vobs","Vobs_kms","Vobs(km/s)"])
    vdisk=find_col(headers,["Vdisk","Vdisk_kms"])
    vgas=find_col(headers,["Vgas","Vgas_kms"])
    vbul=find_col(headers,["Vbul","Vbulge","Vbul_kms"])
    if not all([name,rad,vobs,vdisk,vgas]): return []
    groups={}
    for row in rows:
        try:
            nm=str(row[name])
            rec={"R":float(row[rad]),"Vobs":float(row[vobs]),
                 "Vdisk":float(row[vdisk]),"Vgas":float(row[vgas]),
                 "Vbul":float(row[vbul]) if vbul and str(row[vbul]).strip() else 0.0}
        except Exception:
            continue
        groups.setdefault(nm,[]).append(rec)
    return [(nm,sorted(g,key=lambda r:r["R"])) for nm,g in groups.items() if len(g)>=3]

def fit_vortex_galaxy(rows,Gd,a0,Sigma_char,a_base_si,beta_free=False):
    # P90 baryonic mass estimator from observed baryonic-speed combination.
    def baryon_speed(r,yd,yb):
        return math.sqrt(max(r["Vgas"]**2+yd*r["Vdisk"]**2+yb*r["Vbul"]**2,0.0))*1000.0
    def mass_p90(yd,yb):
        vals=[]
        for r in rows:
            R=max(r["R"],1e-6)*kpc
            vb=baryon_speed(r,yd,yb)
            vals.append(vb*vb*R/Gd/M_sun)
        vals.sort()
        if not vals:return 0.0
        idx=min(len(vals)-1,int(0.90*(len(vals)-1)))
        return vals[idx]
    def predict(params):
        yd,yb,beta=params
        M=max(mass_p90(yd,yb),1e-30)
        Vflat=btfr_velocity(M,Gd,a0)
        out=[]
        for r in rows:
            vb=baryon_speed(r,yd,yb)
            R=r["R"]*kpc
            # Surface density estimate using the baryonic speed.
            Sigma=(vb*vb/(2.0*PI*Gd*R))*pc*pc/M_sun
            ae=a_base_si*math.sqrt(max(Sigma/Sigma_char,0.01))
            rt=Vflat*Vflat/max(ae,1e-30)
            x=max(R/max(rt,1e-30),0.0)
            vv=Vflat*(1.0-math.exp(-(x**max(beta,0.05))))
            out.append(math.sqrt(vb*vb+vv*vv)/1000.0)
        return out
    def objective(params):
        yd,yb,beta=params
        if yd<=0 or yb<0 or beta<=0 or beta>3:return 1e9
        pred=predict(params)
        errs=[(p-r["Vobs"]) / max(abs(r["Vobs"]),1.0) for p,r in zip(pred,rows)]
        return sum(e*e for e in errs)/len(errs)

    # Deterministic derivative-free coordinate descent.  No scipy required.
    params=[0.5,0.7,BETA_DEFAULT]
    if all(abs(r["Vbul"])<1e-12 for r in rows): params[1]=0.0
    step=[0.25,0.25,0.15]
    if not beta_free: step[2]=0.0
    best=objective(params)
    for _ in range(80):
        improved=False
        for j in range(3):
            if step[j]==0: continue
            for direction in (-1.0,1.0):
                trial=params[:]
                trial[j]+=direction*step[j]
                if j==0: trial[j]=max(0.05,min(5.0,trial[j]))
                elif j==1: trial[j]=max(0.0,min(5.0,trial[j]))
                else: trial[j]=max(0.1,min(2.0,trial[j]))
                val=objective(trial)
                if val<best:
                    params=trial; best=val; improved=True
        if not improved:
            step=[s*0.5 for s in step]
            if max(step)<1e-4: break
    pred=predict(params)
    abs_res=[abs(p-r["Vobs"])/max(abs(r["Vobs"]),1.0)*100.0 for p,r in zip(pred,rows)]
    return {"yd":params[0],"yb":params[1],"beta":params[2],
            "median":sorted(abs_res)[len(abs_res)//2],"mean":sum(abs_res)/len(abs_res),
            "n":len(rows),"Vflat":btfr_velocity(mass_p90(*params[:2]),Gd,a0)/1000.0}

def sparc_engine(gravity_data,cosmo):
    candidates=[]
    if len(sys.argv)>1 and not sys.argv[1].startswith('-'):
        candidates.append(Path(sys.argv[1]))
    for n in ["datafile2.txt","SPARC_datafile2.txt","SPARC.csv","SPARC.txt","sparc.csv","sparc.txt"]:
        candidates.append(Path(n))
    path=next((p for p in candidates if p.exists()),None)
    banner("[12] OPTIONAL LOCAL SPARC ENGINE")
    if path is None:
        print("  No local SPARC dataset detected.")
        print("  No SPARC result is reported because observational data are absent.")
        return None
    galaxies=parse_sparc(path)
    if not galaxies:
        print(f"  File found: {path}")
        print("  No compatible SPARC rows detected.")
