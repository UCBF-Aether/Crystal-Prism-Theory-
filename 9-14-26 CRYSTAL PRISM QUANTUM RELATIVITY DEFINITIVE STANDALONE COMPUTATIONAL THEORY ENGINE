def alpha_branch():
    D0=PHI**8
    A=PI/4.0
    q=1.0/1000.0
    alpha_inv=(A*(128.0+D0)-0.5)/(1.0-A*q)
    alpha=1.0/alpha_inv
    D=D0
    iterations=0
    for i in range(1000):
        x=A*(128.0+D)-0.5
        D_new=D0+x*q
        iterations=i+1
        if abs(D_new-D) < 1e-15:
            D=D_new
            break
        D=D_new
    return alpha_inv,alpha,iterations,D0

