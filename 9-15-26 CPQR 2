        valid = (Vo > 1.0) & (Ve > 0)
        if int(valid.sum()) < 3: continue
        errs = np.sqrt(Ve[valid]**2 + (0.05*Vo[valid])**2)
        def chi2(ups):
            try:
                pred, _ = vortex_predict(R, g["Vd"], g["Vb"], g["Vg"], ups)
                val = float(np.sum(((pred[valid]-Vo[valid])/errs)**2))
                return val if np.isfinite(val) else 1e30
            except Exception:
                return 1e30
        try:
            fit = minimize_scalar(chi2, bounds=(0.01, 2.5), method="bounded",
                                  options={"xatol": 1e-4})
            ups = float(fit.x)
            pred, Vf = vortex_predict(R, g["Vd"], g["Vb"], g["Vg"], ups)
            pct_ = 100.0 * (pred[valid]-Vo[valid]) / Vo[valid]
            results.append({"name": name, "ups": ups, "Vf": float(Vf),
                            "med": float(np.median(np.abs(pct_))),
                            "mean": float(np.mean(np.abs(pct_))),
                            "rms": float(np.sqrt(np.mean(pct_**2))),
                            "n": int(valid.sum())})
        except Exception:
            continue
    fit_time = time.perf_counter() - t0
else:
    results = []; fit_time = 0.0

