def baryonic_mass(R, Vd, Vb, Vg):
    Vbar = np.sqrt(Vg**2 + Vd**2 + Vb**2)
    return max(np.percentile(Vbar**2 * R * KPC_TO_PC, 90) / G_PC, 1e-5)


def solve_aeff(R, Sb, Vf, ab, Sc, mx=15, tol=1e-3):
    R = np.asarray(R, float)
    Sb = np.asarray(Sb, float)
    ae = ab
    for _ in range(mx):
        rt = np.clip(Vf**2/ae, R.min()*1.01, R.max()*0.99)
        S  = np.interp(rt, R, Sb)
        an = np.clip(ab * np.sqrt(np.clip(S/Sc, 0.01, 100)), 400, 12000)
        if abs(an-ae)/ae < tol:
            return an, Vf**2/an
        ae = 0.7*ae + 0.3*an
    return ae, Vf**2/ae


def predict(R, Vd, Vb, Vg, ups):
    Vd_ml = Vd * math.sqrt(max(ups, 0.01))
    Vb_ml = Vb * math.sqrt(UPS_BULGE)
    Vg_a  = np.abs(Vg)
    Vbar  = np.sqrt(Vg_a**2 + Vd_ml**2 + Vb_ml**2)
    Mbar  = baryonic_mass(R, Vd_ml, Vb_ml, Vg_a)
    Vf    = (a0 * G * Mbar * M_SUN_G)**0.25 / 1000
    R_pc  = R * KPC_TO_PC
    with np.errstate(divide="ignore", invalid="ignore"):
        Sigma = np.where(R_pc > 1e-10, Vbar**2/(2*PI*G_PC*R_pc), 0.0)
    ae, rt = solve_aeff(R, Sigma, Vf, a_base, Sigma_char)
    x = R / max(rt, 1e-6)
    Vv = Vf * (1 - np.exp(-(x ** eta0)))
    return np.sqrt(Vbar**2 + Vv**2), Vf


