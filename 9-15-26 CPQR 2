def e8_roots():
    r = []
    for i in range(8):
        for j in range(i+1, 8):
            for si in (-1, 1):
                for sj in (-1, 1):
                    x = [0.0]*8
                    x[i] = si
                    x[j] = sj
                    r.append(tuple(x))
    for bits in range(1 << 8):
        if bin(bits).count("1") % 2 == 0:
            r.append(tuple(0.5 if ((bits >> i) & 1) == 0 else -0.5
                           for i in range(8)))
    return r


def project(x):
    d = math.sqrt(2 + PHI)
    return ((x[0] + PHI*x[4])/d,
            (x[1] + PHI*x[5])/d,
            (x[2] + PHI*x[6])/d)


def radius(p):
    return math.sqrt(p[0]*p[0] + p[1]*p[1] + p[2]*p[2])


